# Public, read-only configuration. Keep signing keys out of all NEXT_PUBLIC_* values.
NEXT_PUBLIC_SOURCE_TOKEN_MINT=
NEXT_PUBLIC_SOLANA_CLUSTER=mainnet-beta
NEXT_PUBLIC_NATIVE_HTTP_RPC=http://127.0.0.1:8899
NEXT_PUBLIC_NATIVE_WS_RPC=ws://127.0.0.1:8900

# Server-only endpoint allowlist for the monitor.
MONITOR_HTTP_ENDPOINTS=http://127.0.0.1:8899
MONITOR_WS_ENDPOINTS=ws://127.0.0.1:8900
MONITOR_INTERVAL_MS=15000
MONITOR_TIMEOUT_MS=5000
MONITOR_STALE_AFTER_MS=60000
