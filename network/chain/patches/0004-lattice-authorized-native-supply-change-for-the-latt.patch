+    /// Lattice fork: records that the currently executing instruction created
+    /// (`delta > 0`) or destroyed (`delta < 0`) native lamports, after it has
+    /// already credited or debited the corresponding instruction account.
+    ///
+    /// The lamport balance checks (`UnbalancedInstruction` in `push`/`pop` and
+    /// `UnbalancedTransaction` in the SVM) then accept exactly this imbalance.
+    /// Only the lattice-bridge builtin may call this, and only as a top-level
+    /// instruction; there is no syscall, so SBF programs cannot reach it.
+    pub fn record_native_supply_change(&self, delta: i128) -> Result<(), InstructionError> {
+        if self.get_instruction_stack_height() != 1 {
+            return Err(InstructionError::CallDepth);
+        }
+        let program_id = *self.get_current_instruction_context()?.get_program_key()?;
+        if program_id != crate::LATTICE_BRIDGE_PROGRAM_ID {
+            return Err(InstructionError::IncorrectProgramId);
+        }
+        let total = self
+            .native_supply_delta
+            .get()
+            .checked_add(delta)
+            .ok_or(InstructionError::ArithmeticOverflow)?;
+        let negated = delta
+            .checked_neg()
+            .ok_or(InstructionError::ArithmeticOverflow)?;
+        self.accounts.add_lamports_delta(negated)?;
+        self.native_supply_delta.set(total);
+        Ok(())
+    }
+
+    /// Lattice fork: net native lamports created by this transaction so far.
+    pub fn native_supply_delta(&self) -> i128 {
+        self.native_supply_delta.get()
+    }
