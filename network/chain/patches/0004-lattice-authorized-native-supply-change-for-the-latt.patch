+    #[test]
+    fn test_native_supply_change_balances_instruction() {
+        let mut transaction_context = native_supply_context(crate::LATTICE_BRIDGE_PROGRAM_ID);
+        credit_first_instruction_account(&transaction_context, 250);
+        transaction_context.record_native_supply_change(250).unwrap();
+        assert_eq!(transaction_context.pop(), Ok(()));
+        let record = ExecutionRecord::from(transaction_context);
+        assert_eq!(record.native_supply_delta, 250);
+        assert_eq!(record.accounts.get(1).unwrap().1.lamports(), 1_250);
+    }
