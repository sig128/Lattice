+    /// Lattice fork: apply native lamports created or destroyed by the
+    /// lattice-bridge builtin in committed, successful transactions.
+    ///
+    /// Capitalization always equals the sum of all account balances (this is
+    /// re-verified on snapshot load), and the SVM only accepts a transaction
+    /// whose post-balances differ from its pre-balances by exactly this delta,
+    /// so leaving the u64 range here would mean that invariant is broken.
+    fn apply_native_supply_delta(&self, delta: i128) {
+        if delta == 0 {
+            return;
+        }
+        self.capitalization
+            .fetch_update(AcqRel, Acquire, |capitalization| {
+                i128::from(capitalization)
+                    .checked_add(delta)
+                    .and_then(|updated| u64::try_from(updated).ok())
+            })
+            .expect("lattice-bridge native supply delta keeps capitalization within u64");
+    }
+
     /// Update the accounts data size delta from off-chain events by adding `amount`.
     /// The arithmetic saturates.
     fn update_accounts_data_size_delta_off_chain(&self, amount: i64) {
@@ -4468,6 +4488,15 @@ impl Bank {
             .sum();
         self.update_accounts_data_size_delta_on_chain(accounts_data_len_delta);
 
