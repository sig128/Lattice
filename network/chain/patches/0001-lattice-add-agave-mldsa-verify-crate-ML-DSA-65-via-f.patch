diff --git a/mldsa-verify/examples/bench.rs b/mldsa-verify/examples/bench.rs
new file mode 100644
index 000000000..879995c35
--- /dev/null
+++ b/mldsa-verify/examples/bench.rs
@@ -0,0 +1,56 @@
+//! Calibrates `MLDSA65_VERIFY_BASE_COST` against `secp256k1_recover`, whose
+//! syscall cost is 25_000 CU. Run with:
+//! `cargo run --release -p agave-mldsa-verify --example bench`
+use {
+    agave_mldsa_verify::{MLDSA65_VERIFY_BASE_COST, MLDSA65_VERSION_V1, verify},
+    serde_json::Value,
+    std::time::Instant,
+};
+
+const SECP256K1_RECOVER_COST: f64 = 25_000.0;
+
+fn median_ns(mut f: impl FnMut(), iters: usize) -> f64 {
+    for _ in 0..iters / 10 {
+        f();
+    }
+    let mut samples = Vec::with_capacity(iters);
+    for _ in 0..iters {
+        let t = Instant::now();
+        f();
+        samples.push(t.elapsed().as_nanos() as f64);
+    }
+    samples.sort_by(|a, b| a.partial_cmp(b).unwrap());
+    samples[iters / 2]
+}
+
+fn main() {
+    let path = format!("{}/tests/vectors/noble-mldsa65.json", env!("CARGO_MANIFEST_DIR"));
+    let v: Value = serde_json::from_str(&std::fs::read_to_string(path).unwrap()).unwrap();
+    let case = &v["cases"][0];
+    let pk = hex::decode(case["publicKey"].as_str().unwrap()).unwrap();
+    let msg = hex::decode(case["message"].as_str().unwrap()).unwrap();
+    let sig = hex::decode(case["signature"].as_str().unwrap()).unwrap();
+
+    let mldsa = median_ns(
+        || assert!(verify(MLDSA65_VERSION_V1, &pk, &msg, &sig).is_ok()),
+        2000,
+    );
+
+    let secret = libsecp256k1::SecretKey::parse(&[7u8; 32]).unwrap();
+    let message = libsecp256k1::Message::parse(&[9u8; 32]);
+    let (signature, recovery_id) = libsecp256k1::sign(&message, &secret);
+    let secp = median_ns(
+        || {
+            libsecp256k1::recover(&message, &signature, &recovery_id).unwrap();
+        },
+        2000,
+    );
+
+    let ns_per_cu = secp / SECP256K1_RECOVER_COST;
+    let suggested = (mldsa / ns_per_cu).ceil();
+    println!(
+        "{{\"mldsa65_verify_median_ns\":{mldsa:.0},\"secp256k1_recover_median_ns\":{secp:.0},\
+         \"ns_per_cu_from_secp256k1\":{ns_per_cu:.3},\"suggested_mldsa65_cu\":{suggested:.0},\
+         \"configured_mldsa65_base_cu\":{MLDSA65_VERIFY_BASE_COST}}}"
+    );
+}
diff --git a/mldsa-verify/src/lib.rs b/mldsa-verify/src/lib.rs
new file mode 100644
index 000000000..6f275db8a
--- /dev/null
+++ b/mldsa-verify/src/lib.rs
@@ -0,0 +1,130 @@
+//! ML-DSA-65 (FIPS 204, "pure" variant, empty context string) verification
+//! used by the `sol_mldsa65_verify` syscall of the Lattice experimental fork.
+//!
+//! Verification is a deterministic function of its public inputs: there is
+//! no randomness, no allocation that depends on secret data and no floating
+//! point, so every validator reaches the same result.
+
+use fips204::{
+    ml_dsa_65,
+    traits::{SerDes, Verifier},
+};
+
+/// Algorithm/encoding version accepted by [`verify`].
+/// `1` = ML-DSA-65, pure (no pre-hash), empty context string.
+pub const MLDSA65_VERSION_V1: u64 = 1;
+pub const MLDSA65_PUBLIC_KEY_LEN: usize = ml_dsa_65::PK_LEN;
+pub const MLDSA65_SIGNATURE_LEN: usize = ml_dsa_65::SIG_LEN;
+/// Upper bound on the message length accepted by the syscall.
+pub const MLDSA65_MAX_MESSAGE_LEN: usize = 4096;
+
+/// Fixed compute-unit charge per verification, calibrated against the
+/// existing `secp256k1_recover` syscall (25_000 CU) on the same machine;
+/// see `examples/bench.rs` and `docs/QUANTUM.md` in the Lattice repository.
+pub const MLDSA65_VERIFY_BASE_COST: u64 = 30_000;
+/// Additional charge of 1 CU per this many message bytes (rounded up).
+pub const MLDSA65_VERIFY_BYTES_PER_CU: u64 = 32;
+
+/// Result codes returned to SBF programs. `0` means the signature is valid.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+#[repr(u64)]
+pub enum MlDsaVerifyError {
+    InvalidSignature = 1,
+    InvalidPublicKey = 2,
+    UnsupportedVersion = 3,
+    MessageTooLong = 4,
+}
+
+impl From<MlDsaVerifyError> for u64 {
+    fn from(error: MlDsaVerifyError) -> u64 {
+        error as u64
+    }
+}
+
+/// Compute units charged for verifying a message of `message_len` bytes.
+pub fn verify_cost(message_len: u64) -> u64 {
+    MLDSA65_VERIFY_BASE_COST
+        .saturating_add(message_len.div_ceil(MLDSA65_VERIFY_BYTES_PER_CU))
+}
+
+/// Verify an ML-DSA-65 signature.
+///
+/// Length checks happen before any cryptographic work so malformed input is
+/// rejected cheaply and deterministically.
+pub fn verify(
+    version: u64,
+    public_key: &[u8],
+    message: &[u8],
+    signature: &[u8],
+) -> Result<(), MlDsaVerifyError> {
+    if version != MLDSA65_VERSION_V1 {
+        return Err(MlDsaVerifyError::UnsupportedVersion);
+    }
+    if message.len() > MLDSA65_MAX_MESSAGE_LEN {
+        return Err(MlDsaVerifyError::MessageTooLong);
+    }
+    let public_key: [u8; MLDSA65_PUBLIC_KEY_LEN] = public_key
+        .try_into()
+        .map_err(|_| MlDsaVerifyError::InvalidPublicKey)?;
+    let signature: &[u8; MLDSA65_SIGNATURE_LEN] = signature
+        .try_into()
+        .map_err(|_| MlDsaVerifyError::InvalidSignature)?;
+    let public_key = ml_dsa_65::PublicKey::try_from_bytes(public_key)
+        .map_err(|_| MlDsaVerifyError::InvalidPublicKey)?;
+    if public_key.verify(message, signature, &[]) {
+        Ok(())
+    } else {
+        Err(MlDsaVerifyError::InvalidSignature)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn cost_is_monotonic_and_bounded() {
+        assert_eq!(verify_cost(0), MLDSA65_VERIFY_BASE_COST);
+        assert_eq!(verify_cost(1), MLDSA65_VERIFY_BASE_COST + 1);
+        assert_eq!(verify_cost(32), MLDSA65_VERIFY_BASE_COST + 1);
+        assert_eq!(verify_cost(33), MLDSA65_VERIFY_BASE_COST + 2);
+        assert_eq!(verify_cost(u64::MAX), MLDSA65_VERIFY_BASE_COST + u64::MAX.div_ceil(32));
+    }
+
+    #[test]
+    fn rejects_unsupported_version_before_parsing() {
+        assert_eq!(
+            verify(0, &[], &[], &[]),
+            Err(MlDsaVerifyError::UnsupportedVersion)
+        );
+        assert_eq!(
+            verify(2, &[0; MLDSA65_PUBLIC_KEY_LEN], &[], &[0; MLDSA65_SIGNATURE_LEN]),
+            Err(MlDsaVerifyError::UnsupportedVersion)
+        );
+    }
+
+    #[test]
+    fn rejects_bad_lengths() {
+        let pk = [0u8; MLDSA65_PUBLIC_KEY_LEN];
+        let sig = [0u8; MLDSA65_SIGNATURE_LEN];
+        assert_eq!(
+            verify(1, &pk[1..], b"m", &sig),
+            Err(MlDsaVerifyError::InvalidPublicKey)
+        );
+        assert_eq!(
+            verify(1, &pk, b"m", &sig[1..]),
+            Err(MlDsaVerifyError::InvalidSignature)
+        );
+        assert_eq!(
+            verify(1, &pk, &[0u8; MLDSA65_MAX_MESSAGE_LEN + 1], &sig),
+            Err(MlDsaVerifyError::MessageTooLong)
+        );
+    }
+
+    #[test]
+    fn all_zero_signature_is_rejected() {
+        let pk = [0u8; MLDSA65_PUBLIC_KEY_LEN];
+        let sig = [0u8; MLDSA65_SIGNATURE_LEN];
+        assert_eq!(verify(1, &pk, b"m", &sig), Err(MlDsaVerifyError::InvalidSignature));
+    }
+}
diff --git a/mldsa-verify/tests/vectors.rs b/mldsa-verify/tests/vectors.rs
new file mode 100644
index 000000000..b5f193fe5
--- /dev/null
+++ b/mldsa-verify/tests/vectors.rs
@@ -0,0 +1,91 @@
+use {
+    agave_mldsa_verify::{MLDSA65_VERSION_V1, MlDsaVerifyError, verify},
+    fips204::{
+        ml_dsa_65,
+        traits::SerDes,
+    },
+    serde_json::Value,
+};
+
+fn load(name: &str) -> Value {
+    let path = format!("{}/tests/vectors/{name}", env!("CARGO_MANIFEST_DIR"));
+    serde_json::from_str(&std::fs::read_to_string(path).unwrap()).unwrap()
+}
+
+fn bytes(v: &Value) -> Vec<u8> {
+    hex::decode(v.as_str().unwrap()).unwrap()
+}
+
+/// NIST ACVP ML-DSA-65 sigVer vectors. ACVP tests the *internal* interface
+/// (message is M'), so they exercise the exact pinned fips204 core verifier
+/// that the external `verify` wraps.
+#[test]
+#[allow(deprecated)]
+fn nist_acvp_sigver_mldsa65() {
+    let v = load("acvp-mldsa65-sigver-internal.json");
+    let (mut pass, mut fail) = (0, 0);
+    for group in v["testGroups"].as_array().unwrap() {
+        let pk = ml_dsa_65::PublicKey::try_from_bytes(bytes(&group["pk"]).try_into().unwrap())
+            .unwrap();
+        for case in group["tests"].as_array().unwrap() {
+            let msg = bytes(&case["message"]);
+            let sig: [u8; ml_dsa_65::SIG_LEN] = bytes(&case["signature"]).try_into().unwrap();
+            let expected = case["testPassed"].as_bool().unwrap();
+            assert_eq!(
+                ml_dsa_65::_internal_verify(&pk, &msg, &sig, &[]),
+                expected,
+                "tcId {} ({})",
+                case["tcId"],
+                case["reason"]
+            );
+            if expected { pass += 1 } else { fail += 1 }
+        }
+    }
+    assert_eq!((pass, fail), (3, 12));
+}
+
+/// Signatures produced by @noble/post-quantum (the TypeScript client) must
+/// verify through the exact entry point used by the syscall, and every
+/// single-field mutation must be rejected.
+#[test]
+fn noble_cross_implementation() {
+    let v = load("noble-mldsa65.json");
+    let cases = v["cases"].as_array().unwrap();
+    assert!(!cases.is_empty());
+    for case in cases {
+        let pk = bytes(&case["publicKey"]);
+        let msg = bytes(&case["message"]);
+        let sig = bytes(&case["signature"]);
+        assert_eq!(verify(MLDSA65_VERSION_V1, &pk, &msg, &sig), Ok(()));
+
+        let mut bad_msg = msg.clone();
+        bad_msg[0] ^= 1;
+        assert_eq!(
+            verify(MLDSA65_VERSION_V1, &pk, &bad_msg, &sig),
+            Err(MlDsaVerifyError::InvalidSignature)
+        );
+        let mut bad_sig = sig.clone();
+        bad_sig[100] ^= 1;
+        assert_eq!(
+            verify(MLDSA65_VERSION_V1, &pk, &msg, &bad_sig),
+            Err(MlDsaVerifyError::InvalidSignature)
+        );
+        let mut bad_pk = pk.clone();
+        bad_pk[40] ^= 1;
+        assert_eq!(
+            verify(MLDSA65_VERSION_V1, &bad_pk, &msg, &sig),
+            Err(MlDsaVerifyError::InvalidSignature)
+        );
+        assert_eq!(
+            verify(2, &pk, &msg, &sig),
+            Err(MlDsaVerifyError::UnsupportedVersion)
+        );
+    }
+    // Key/signature from different cases must not cross-verify.
+    let a = &cases[0];
+    let b = &cases[1];
+    assert_eq!(
+        verify(MLDSA65_VERSION_V1, &bytes(&b["publicKey"]), &bytes(&a["message"]), &bytes(&a["signature"])),
+        Err(MlDsaVerifyError::InvalidSignature)
+    );
+}
