+#[test]
+fn per_epoch_rate_limit() {
+    let mut h = Harness::new(SCHEME_ED25519, 3, 2);
+    let header = h.governance_header(LATTICE_GENESIS);
+    h.govern(
+        &header,
+        &GovernanceAction::SetLimits {
+            max_mint_per_epoch: 100 * SCALE,
+        },
+        &[0, 1],
+    )
+    .unwrap();
+    h.mint(&h.deposit(0, 60, ALICE), &[0, 1]).unwrap();
+    assert_eq!(
+        h.mint(&h.deposit(1, 41, ALICE), &[0, 1]),
+        Err(BridgeError::MintRateLimitExceeded)
+    );
+    h.mint(&h.deposit(1, 40, ALICE), &[0, 1]).unwrap();
+    assert_eq!(
+        h.mint(&h.deposit(2, 1, ALICE), &[0, 1]),
+        Err(BridgeError::MintRateLimitExceeded)
+    );
+    // A rejected deposit stays mintable later: next epoch resets the window.
+    h.epoch += 1;
+    assert_eq!(h.mint(&h.deposit(2, 1, ALICE), &[0, 1]), Ok(SCALE));
+    assert_eq!(h.state.minted_in_rate_epoch, SCALE);
+    // Zero limit disables minting entirely (there is no admin mint path).
+    let header = h.governance_header(LATTICE_GENESIS);
+    h.govern(
+        &header,
+        &GovernanceAction::SetLimits {
+            max_mint_per_epoch: 0,
+        },
+        &[0, 1],
+    )
+    .unwrap();
+    h.epoch += 1;
+    assert_eq!(
+        h.mint(&h.deposit(3, 1, ALICE), &[0, 1]),
+        Err(BridgeError::MintRateLimitExceeded)
+    );
+}
