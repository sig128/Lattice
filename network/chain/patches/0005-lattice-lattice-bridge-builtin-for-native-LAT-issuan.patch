+#[test]
+fn invalid_or_foreign_signatures_are_rejected() {
+    let mut h = Harness::new(SCHEME_ED25519, 3, 2);
+    let deposit = h.deposit(0, 10, ALICE);
+    let message = wire::encode_transfer(&deposit);
+    let (mut header, mut data) = h.attest_with(1, &message, &[0, 1]).unwrap();
+    // Flip a signature byte after sealing: re-verification fails.
+    let sig_start = ATTESTATION_HEADER_LEN + message.len() + 1;
+    data[sig_start] ^= 1;
+    header.verified_bitmap = 0;
+    let set = h.current_set().clone();
+    let mut meter = |_| Ok::<(), BridgeError>(());
+    assert_eq!(
+        logic::seal_and_verify(&mut header, &data, &h.state, &set, 0, 2, &mut meter),
+        Err(BridgeError::InvalidSignature)
+    );
+    // Index outside the set.
+    let digest = wire::digest(&message);
+    let mut entry = h.members[&1][0].sign(0, &digest);
+    entry[0] = 7;
+    assert_eq!(
+        guardian::verify_entries::<BridgeError, _>(&set, &digest, &entry, 0, 1, &mut meter),
+        Err(BridgeError::InvalidGuardianIndex)
+    );
+    // A non-guardian key.
+    let outsider = TestGuardian::new(SCHEME_ED25519, 200).sign(0, &digest);
+    assert_eq!(
+        guardian::verify_entries::<BridgeError, _>(&set, &digest, &outsider, 0, 1, &mut meter),
+        Err(BridgeError::InvalidSignature)
+    );
+}
