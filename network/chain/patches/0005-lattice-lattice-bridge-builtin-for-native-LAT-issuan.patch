+#[test]
+fn separate_pauses_pauser_and_unpause() {
+    let mut h = Harness::new(SCHEME_ED25519, 3, 2);
+    h.mint(&h.deposit(0, 100, ALICE), &[0, 1]).unwrap();
+
+    let header = h.governance_header(LATTICE_GENESIS);
+    h.govern(
+        &header,
+        &GovernanceAction::SetPause {
+            deposits_paused: true,
+            withdrawals_paused: false,
+        },
+        &[0, 1],
+    )
+    .unwrap();
+    assert_eq!(
+        h.mint(&h.deposit(1, 1, ALICE), &[0, 1]),
+        Err(BridgeError::DepositsPaused)
+    );
+    // Withdrawals still work while deposits are paused.
+    h.burn(ALICE, 10 * SCALE, SOLANA_WALLET).unwrap();
+
+    let header = h.governance_header(LATTICE_GENESIS);
+    h.govern(
+        &header,
+        &GovernanceAction::SetPause {
+            deposits_paused: false,
+            withdrawals_paused: true,
+        },
+        &[1, 2],
+    )
+    .unwrap();
+    assert_eq!(
+        h.burn(ALICE, SCALE, SOLANA_WALLET),
+        Err(BridgeError::WithdrawalsPaused)
+    );
+    assert_eq!(h.mint(&h.deposit(1, 1, ALICE), &[0, 1]), Ok(SCALE));
+
+    // Pauser key: can pause, cannot unpause; nobody else can use it.
+    let header = h.governance_header(LATTICE_GENESIS);
+    h.govern(
+        &header,
+        &GovernanceAction::SetPauser { pauser: [0x77; 32] },
+        &[0, 2],
+    )
+    .unwrap();
+    assert_eq!(
+        logic::process_pauser_pause(&mut h.state, &[0x78; 32], 1, 0),
+        Err(BridgeError::NotPauser)
+    );
+    logic::process_pauser_pause(&mut h.state, &[0x77; 32], 1, 0).unwrap();
+    assert!(h.state.is_flag(FLAG_DEPOSITS_PAUSED) && h.state.is_flag(FLAG_WITHDRAWALS_PAUSED));
+    assert_eq!(
+        logic::process_pauser_pause(&mut h.state, &[0x77; 32], 2, 0),
+        Err(BridgeError::UnpauseNotAllowed)
+    );
+    logic::process_pauser_pause(&mut h.state, &[0x77; 32], 0, 0).unwrap();
+    assert!(h.state.is_flag(FLAG_DEPOSITS_PAUSED) && h.state.is_flag(FLAG_WITHDRAWALS_PAUSED));
+    h.assert_supply_invariant();
+}
