+#[test]
+fn burn_reduces_capitalization_and_creates_receipts() {
+    let mut h = Harness::new(SCHEME_ED25519, 3, 2);
+    h.mint(&h.deposit(0, 5_000, ALICE), &[0, 1]).unwrap();
+    let cap_before = h.capitalization;
+
+    let first = h.burn(ALICE, 1_234 * SCALE, SOLANA_WALLET).unwrap();
+    assert_eq!(h.capitalization, cap_before - u128::from(1_234 * SCALE));
+    assert_eq!(first.burn_sequence, 0);
+    assert_eq!(first.source_amount, 1_234);
+    assert_eq!(first.native_amount, 1_234 * SCALE);
+    assert_eq!(first.burner, ALICE);
+    assert_eq!(first.solana_recipient, SOLANA_WALLET);
+    assert_eq!(
+        first.event_id,
+        wire::burn_event_id(&h.state.deployment_id, 0)
+    );
+    assert_eq!(BurnReceipt::decode(&first.encode()), Ok(first.clone()));
+
+    let second = h.burn(ALICE, SCALE, SOLANA_WALLET).unwrap();
+    assert_eq!(second.burn_sequence, 1);
+    assert_eq!(h.state.next_burn_sequence, 2);
+    assert_eq!(h.state.total_burned_native, u128::from(1_235 * SCALE));
+
+    assert_eq!(
+        h.burn(ALICE, SCALE + 1, SOLANA_WALLET),
+        Err(BridgeError::NotMultipleOfScale)
+    );
+    assert_eq!(
+        h.burn(ALICE, 0, SOLANA_WALLET),
+        Err(BridgeError::ZeroAmount)
+    );
+    assert_eq!(
+        h.burn(ALICE, SCALE, [0; 32]),
+        Err(BridgeError::ZeroRecipient)
+    );
+    assert_eq!(
+        h.state.next_burn_sequence, 2,
+        "failed burns consume no sequence"
+    );
+    h.assert_supply_invariant();
+}
