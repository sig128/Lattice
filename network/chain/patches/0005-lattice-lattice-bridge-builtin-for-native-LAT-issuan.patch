+    let deposit = h.deposit(0, 3, ALICE);
+    let message = wire::encode_transfer(&deposit);
+    let digest = wire::digest(&message);
+    let set = h.current_set().clone();
+    let mut meter = |_| Ok::<(), BridgeError>(());
+
+    let good = h.members[&1][1].sign(1, &digest);
+    assert_eq!(good.len(), 1 + 64 + 3309);
+    assert_eq!(
+        guardian::verify_entries::<BridgeError, _>(&set, &digest, &good, 0, 1, &mut meter),
+        Ok(0b10)
+    );
+
+    let mut bad_ed = good.clone();
+    bad_ed[1] ^= 1;
+    assert_eq!(
+        guardian::verify_entries::<BridgeError, _>(&set, &digest, &bad_ed, 0, 1, &mut meter),
+        Err(BridgeError::InvalidSignature)
+    );
+    let mut bad_pq = good.clone();
+    bad_pq[100] ^= 1;
+    assert_eq!(
+        guardian::verify_entries::<BridgeError, _>(&set, &digest, &bad_pq, 0, 1, &mut meter),
+        Err(BridgeError::InvalidSignature)
+    );
+    // Ed25519 half from guardian 1, ML-DSA half from guardian 2: rejected.
+    let other = h.members[&1][2].sign(1, &digest);
+    let mut mixed = good[..65].to_vec();
+    mixed.extend_from_slice(&other[65..]);
+    assert_eq!(
+        guardian::verify_entries::<BridgeError, _>(&set, &digest, &mixed, 0, 1, &mut meter),
+        Err(BridgeError::InvalidSignature)
+    );
+    let before = h.compute_units;
+    assert_eq!(h.mint(&deposit, &[0, 1]), Ok(3 * SCALE));
+    assert_eq!(
+        h.compute_units - before,
+        logic::digest_cost(wire::TRANSFER_LEN)
+            + 2 * (guardian::ED25519_VERIFY_COST + guardian::mldsa65_verify_cost())
+    );
+}
+
+#[test]
+fn scheme_migration_ed25519_to_hybrid_via_rotation() {
+    let mut h = Harness::new(SCHEME_ED25519, 3, 2);
+    h.rotate(SCHEME_HYBRID, 3, 2, &[0, 1]).unwrap();
+    assert_eq!(h.current_set().scheme, SCHEME_HYBRID);
+    let deposit = h.deposit(0, 1, ALICE);
+    assert_eq!(deposit.header.scheme, SCHEME_HYBRID);
+    assert_eq!(h.mint(&deposit, &[1, 2]), Ok(SCALE));
+}
+
+#[test]
+fn compute_budget_exhaustion_stops_verification() {
+    let mut h = Harness::new(SCHEME_ED25519, 3, 2);
+    h.compute_units = 0;
+    h.compute_budget = logic::digest_cost(wire::TRANSFER_LEN) + guardian::ED25519_VERIFY_COST;
+    let deposit = h.deposit(0, 1, ALICE);
+    assert_eq!(h.mint(&deposit, &[0, 1]), Err(BridgeError::Overflow));
+    assert!(h.minted.is_empty());
+}
+
+#[test]
+fn attestation_header_round_trip_and_bounds() {
+    let mut h = Harness::new(SCHEME_ED25519, 3, 2);
+    let message = wire::encode_transfer(&h.deposit(0, 1, ALICE));
+    let (header, data) = h.attest_with(1, &message, &[0, 1]).unwrap();
+    let mut encoded = data.clone();
+    header.encode_into(&mut encoded);
+    assert_eq!(AttestationHeader::decode(&encoded), Ok(header.clone()));
+    assert_eq!(header.message(&encoded).unwrap(), message.as_slice());
+    // Verifying past the declared signature count is rejected.
+    let mut sealed = header.clone();
+    let set = h.current_set().clone();
+    let mut meter = |_| Ok::<(), BridgeError>(());
+    assert_eq!(
+        logic::seal_and_verify(&mut sealed, &encoded, &h.state, &set, 1, 2, &mut meter),
+        Err(BridgeError::AttestationOutOfBounds)
+    );
+    // Consuming requires the writer.
+    let mut state = h.state.clone();
+    assert_eq!(
+        logic::process_mint(
+            &mut state, &set, &header, &message, &[8; 32], false, h.epoch, h.slot
+        ),
+        Err(BridgeError::AttestationWriter)
+    );
+}
+
+fn genesis_config(network: u8, bootstrap: Vec<BootstrapDeposit>) -> GenesisBridgeConfig {
+    let members = guardians(SCHEME_ED25519, 3, 1);
+    GenesisBridgeConfig {
+        network,
+        deployment_id: wire::deployment_id(DEPLOYMENT_LABEL),
+        solana_genesis_hash: SOLANA_GENESIS,
+        source_program_id: SOURCE_PROGRAM,
+        source_mint: SOURCE_MINT,
+        source_decimals: DECIMALS,
+        guardian_set: guardian_set(SCHEME_ED25519, 2, 1, &members),
+        pauser: [0; 32],
+        max_mint_per_epoch: 1_000_000 * SCALE,
+        bootstrap_deposits: bootstrap,
+    }
+}
+
+#[test]
+fn mainnet_genesis_rejects_unbacked_lamports() {
+    let rent = |len: usize| 1_000 + len as u64;
+    let program_id = crate::id();
+    let err = genesis::build_genesis_accounts(
+        &genesis_config(NETWORK_MAINNET, vec![]),
+        &program_id,
+        500,
+        0,
+        rent,
+    )
+    .unwrap_err();
+    assert!(err.contains("unbacked"), "{err}");
+
+    let bootstrap = vec![BootstrapDeposit {
+        sequence: 0,
+        source_amount: 1_000_000,
+        recipient: ALICE,
+    }];
+    let (accounts, report) = genesis::build_genesis_accounts(
+        &genesis_config(NETWORK_MAINNET, bootstrap.clone()),
+        &program_id,
+        500_000,
+        1_000_000,
+        rent,
+    )
+    .unwrap();
+    assert_eq!(report.backed_native, 1_000_000 * SCALE);
+    assert_eq!(report.unbacked_native, 0);
+    let state_account = accounts
+        .iter()
+        .find(|a| a.data.starts_with(state::STATE_MAGIC))
+        .unwrap();
+    let state = BridgeState::decode(&state_account.data).unwrap();
+    assert_eq!(state.genesis_unbacked_native, 0);
+    assert_eq!(state.total_minted_native, u128::from(1_000_000 * SCALE));
+    assert_eq!(state.outstanding_native, u128::from(1_000_000 * SCALE));
+    assert_eq!(state.minted_count, 1);
+    assert!(!state.is_flag(FLAG_LATTICE_GENESIS_BOUND));
+    assert!(!state.is_flag(FLAG_DEPOSITS_PAUSED) && !state.is_flag(FLAG_WITHDRAWALS_PAUSED));
+    assert_eq!(
+        state_account.address,
+        state::state_address(&program_id, &state.deployment_id).0
+    );
+    // The bootstrap deposit is pre-consumed at its deterministic address.
+    let record_address = state::mint_record_address(&program_id, &state.deployment_id, 0).0;
+    let record = accounts
+        .iter()
+        .find(|a| a.address == record_address)
+        .unwrap();
+    assert_eq!(
+        MintRecord::decode(&record.data).unwrap().native_amount,
+        1_000_000 * SCALE
+    );
+    let set_address = state::guardian_set_address(&program_id, &state.deployment_id, 1).0;
+    assert!(accounts.iter().any(|a| a.address == set_address));
+
+    // Too little backing for the genesis allocation plus runtime reserve.
+    let err = genesis::build_genesis_accounts(
+        &genesis_config(NETWORK_MAINNET, bootstrap.clone()),
+        &program_id,
+        1_000_000 * SCALE,
+        1,
+        rent,
+    )
+    .unwrap_err();
+    assert!(err.contains("unbacked"), "{err}");
+    // Duplicate bootstrap sequences are refused.
+    let dup = vec![bootstrap[0].clone(), bootstrap[0].clone()];
+    assert!(
+        genesis::build_genesis_accounts(
+            &genesis_config(NETWORK_MAINNET, dup),
+            &program_id,
+            0,
+            0,
+            rent
+        )
+        .is_err()
+    );
+}
+
+#[test]
+fn testnet_genesis_labels_unbacked_supply() {
+    let rent = |len: usize| 1_000 + len as u64;
+    let (accounts, report) = genesis::build_genesis_accounts(
+        &genesis_config(NETWORK_TESTNET, vec![]),
+        &crate::id(),
+        500_000_000 * 1_000_000_000,
+        1_000,
+        rent,
+    )
+    .unwrap();
+    assert!(report.unbacked_native > 500_000_000 * 1_000_000_000);
+    let state_account = accounts
+        .iter()
+        .find(|a| a.data.starts_with(state::STATE_MAGIC))
+        .unwrap();
+    let state = BridgeState::decode(&state_account.data).unwrap();
+    assert_eq!(state.network, NETWORK_TESTNET);
+    assert_eq!(state.genesis_unbacked_native, report.unbacked_native);
+    assert_eq!(state.total_minted_native, 0);
+}
+
+#[test]
+fn withdrawals_paused_flag_constant_is_distinct() {
+    assert_ne!(FLAG_DEPOSITS_PAUSED, FLAG_WITHDRAWALS_PAUSED);
+    assert_ne!(FLAG_WITHDRAWALS_PAUSED, FLAG_LATTICE_GENESIS_BOUND);
+}
diff --git a/programs/lattice-bridge/src/wire.rs b/programs/lattice-bridge/src/wire.rs
new file mode 100644
index 000000000..ad48ea7f6
--- /dev/null
+++ b/programs/lattice-bridge/src/wire.rs
@@ -0,0 +1,472 @@
+//! Canonical bridge messages, wire version 1 (docs/BRIDGE_SPEC.md §2–§3).
+//!
+//! Byte-for-byte identical to `programs/source-vault/src/message.rs`. Kind 4
+//! (DESTINATION_GOVERNANCE) bodies are defined here for the Lattice registry
+//! and documented in docs/NATIVE_ISSUANCE.md.
+
+use {
+    crate::error::{BridgeError, BridgeResult},
+    agave_mldsa_verify::MLDSA65_PUBLIC_KEY_LEN,
+    solana_sha256_hasher::hashv,
+};
+
+pub const DOMAIN: &[u8; 16] = b"lattice-bridge/1";
+pub const PROTOCOL_VERSION: u8 = 1;
+
+pub const KIND_DEPOSIT: u8 = 1;
+pub const KIND_WITHDRAWAL: u8 = 2;
+pub const KIND_SOURCE_GOVERNANCE: u8 = 3;
+pub const KIND_DESTINATION_GOVERNANCE: u8 = 4;
+
+pub const SCHEME_ED25519: u8 = 1;
+pub const SCHEME_MLDSA65: u8 = 2;
+pub const SCHEME_HYBRID: u8 = 3;
+
+pub const HEADER_LEN: usize = 196;
+pub const TRANSFER_LEN: usize = 276;
+
+pub const DEPLOYMENT_TAG: &[u8] = b"lattice-bridge/1:deployment";
+pub const DEPOSIT_EVENT_TAG: &[u8] = b"lattice-bridge/1:deposit-event";
+pub const BURN_EVENT_TAG: &[u8] = b"lattice-bridge/1:burn-event";
+
+/// Destination governance actions (kind 4).
+pub const ACTION_ROTATE_GUARDIANS: u8 = 1;
+pub const ACTION_SET_PAUSE: u8 = 2;
+pub const ACTION_SET_LIMITS: u8 = 3;
+pub const ACTION_SET_PAUSER: u8 = 4;
+pub const ACTION_BIND_LATTICE_GENESIS: u8 = 5;
+
+pub const MAX_GUARDIANS: usize = 19;
+pub const ED25519_PUBLIC_KEY_LEN: usize = 32;
+/// Largest valid message: a hybrid RotateGuardians with 19 guardians.
+pub const MAX_MESSAGE_LEN: usize =
+    HEADER_LEN + 12 + MAX_GUARDIANS * (ED25519_PUBLIC_KEY_LEN + MLDSA65_PUBLIC_KEY_LEN);
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct Header {
+    pub kind: u8,
+    pub protocol_version: u8,
+    pub scheme: u8,
+    pub deployment_id: [u8; 32],
+    pub solana_genesis_hash: [u8; 32],
+    pub lattice_genesis_hash: [u8; 32],
+    pub source_program_id: [u8; 32],
+    pub source_mint: [u8; 32],
+    pub signer_epoch: u64,
+    pub nonce: u64,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct Transfer {
+    pub header: Header,
+    pub source_amount: u64,
+    pub native_amount: u64,
+    pub recipient: [u8; 32],
+    pub event_id: [u8; 32],
+}
+
+/// One guardian's keys; which halves are present depends on the scheme.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct GuardianKey {
+    pub ed25519: Option<[u8; ED25519_PUBLIC_KEY_LEN]>,
+    pub mldsa65: Option<Vec<u8>>,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum GovernanceAction {
+    RotateGuardians {
+        new_epoch: u64,
+        threshold: u8,
+        scheme: u8,
+        keys: Vec<GuardianKey>,
+    },
+    SetPause {
+        deposits_paused: bool,
+        withdrawals_paused: bool,
+    },
+    SetLimits {
+        max_mint_per_epoch: u64,
+    },
+    SetPauser {
+        pauser: [u8; 32],
+    },
+    BindLatticeGenesis,
+}
+
+pub(crate) fn a32(d: &[u8], o: usize) -> BridgeResult<[u8; 32]> {
+    d.get(o..o.checked_add(32).ok_or(BridgeError::MalformedMessage)?)
+        .and_then(|s| <[u8; 32]>::try_from(s).ok())
+        .ok_or(BridgeError::MalformedMessage)
+}
+
+pub(crate) fn u64_at(d: &[u8], o: usize) -> BridgeResult<u64> {
+    d.get(o..o.checked_add(8).ok_or(BridgeError::MalformedMessage)?)
+        .and_then(|s| <[u8; 8]>::try_from(s).ok())
+        .map(u64::from_le_bytes)
+        .ok_or(BridgeError::MalformedMessage)
+}
+
+pub(crate) fn u8_at(d: &[u8], o: usize) -> BridgeResult<u8> {
+    d.get(o).copied().ok_or(BridgeError::MalformedMessage)
+}
+
+pub fn parse_header(d: &[u8]) -> BridgeResult<Header> {
+    if d.len() < HEADER_LEN {
+        return Err(BridgeError::MalformedMessage);
+    }
+    if d.get(0..16) != Some(DOMAIN.as_slice()) {
+        return Err(BridgeError::WrongDomain);
+    }
+    if u8_at(d, 19)? != 0 {
+        return Err(BridgeError::MalformedMessage);
+    }
+    Ok(Header {
+        kind: u8_at(d, 16)?,
+        protocol_version: u8_at(d, 17)?,
+        scheme: u8_at(d, 18)?,
+        deployment_id: a32(d, 20)?,
+        solana_genesis_hash: a32(d, 52)?,
+        lattice_genesis_hash: a32(d, 84)?,
+        source_program_id: a32(d, 116)?,
+        source_mint: a32(d, 148)?,
+        signer_epoch: u64_at(d, 180)?,
+        nonce: u64_at(d, 188)?,
+    })
+}
+
+pub fn parse_transfer(d: &[u8]) -> BridgeResult<Transfer> {
+    if d.len() != TRANSFER_LEN {
+        return Err(BridgeError::MalformedMessage);
+    }
+    Ok(Transfer {
+        header: parse_header(d)?,
+        source_amount: u64_at(d, 196)?,
+        native_amount: u64_at(d, 204)?,
+        recipient: a32(d, 212)?,
+        event_id: a32(d, 244)?,
+    })
+}
+
+pub fn encode_header(h: &Header, out: &mut Vec<u8>) {
+    out.extend_from_slice(DOMAIN);
+    out.extend_from_slice(&[h.kind, h.protocol_version, h.scheme, 0]);
+    out.extend_from_slice(&h.deployment_id);
+    out.extend_from_slice(&h.solana_genesis_hash);
+    out.extend_from_slice(&h.lattice_genesis_hash);
+    out.extend_from_slice(&h.source_program_id);
+    out.extend_from_slice(&h.source_mint);
+    out.extend_from_slice(&h.signer_epoch.to_le_bytes());
+    out.extend_from_slice(&h.nonce.to_le_bytes());
+}
+
+pub fn encode_transfer(t: &Transfer) -> Vec<u8> {
+    let mut out = Vec::with_capacity(TRANSFER_LEN);
+    encode_header(&t.header, &mut out);
+    out.extend_from_slice(&t.source_amount.to_le_bytes());
+    out.extend_from_slice(&t.native_amount.to_le_bytes());
+    out.extend_from_slice(&t.recipient);
+    out.extend_from_slice(&t.event_id);
+    out
+}
+
+/// Bytes of one guardian key entry for `scheme` (ed25519 first, then ML-DSA).
+pub fn key_entry_len(scheme: u8) -> BridgeResult<usize> {
+    match scheme {
+        SCHEME_ED25519 => Ok(ED25519_PUBLIC_KEY_LEN),
+        SCHEME_MLDSA65 => Ok(MLDSA65_PUBLIC_KEY_LEN),
+        SCHEME_HYBRID => Ok(ED25519_PUBLIC_KEY_LEN + MLDSA65_PUBLIC_KEY_LEN),
+        _ => Err(BridgeError::WrongScheme),
+    }
+}
+
+pub fn scheme_has_ed25519(scheme: u8) -> bool {
+    scheme == SCHEME_ED25519 || scheme == SCHEME_HYBRID
+}
+
+pub fn scheme_has_mldsa65(scheme: u8) -> bool {
+    scheme == SCHEME_MLDSA65 || scheme == SCHEME_HYBRID
+}
+
+pub fn encode_key_entry(key: &GuardianKey, out: &mut Vec<u8>) {
+    if let Some(ed) = &key.ed25519 {
+        out.extend_from_slice(ed);
+    }
+    if let Some(pq) = &key.mldsa65 {
+        out.extend_from_slice(pq);
+    }
+}
+
+pub fn parse_key_entry(scheme: u8, d: &[u8]) -> BridgeResult<GuardianKey> {
+    if d.len() != key_entry_len(scheme)? {
+        return Err(BridgeError::MalformedMessage);
+    }
+    let ed25519 = if scheme_has_ed25519(scheme) {
+        Some(a32(d, 0)?)
+    } else {
+        None
+    };
+    let mldsa65 = if scheme_has_mldsa65(scheme) {
+        let start = if ed25519.is_some() {
+            ED25519_PUBLIC_KEY_LEN
+        } else {
+            0
+        };
+        Some(
+            d.get(start..)
+                .ok_or(BridgeError::MalformedMessage)?
+                .to_vec(),
+        )
+    } else {
+        None
+    };
+    Ok(GuardianKey { ed25519, mldsa65 })
+}
+
+/// Encodes a kind-4 body (`action || payload`), appended after the header.
+pub fn encode_governance_body(action: &GovernanceAction, out: &mut Vec<u8>) {
+    match action {
+        GovernanceAction::RotateGuardians {
+            new_epoch,
+            threshold,
+            scheme,
+            keys,
+        } => {
+            out.push(ACTION_ROTATE_GUARDIANS);
+            out.extend_from_slice(&new_epoch.to_le_bytes());
+            out.push(*threshold);
+            out.push(keys.len() as u8);
+            out.push(*scheme);
+            for key in keys {
+                encode_key_entry(key, out);
+            }
+        }
+        GovernanceAction::SetPause {
+            deposits_paused,
+            withdrawals_paused,
+        } => {
+            out.push(ACTION_SET_PAUSE);
+            out.push(u8::from(*deposits_paused));
+            out.push(u8::from(*withdrawals_paused));
+        }
+        GovernanceAction::SetLimits { max_mint_per_epoch } => {
+            out.push(ACTION_SET_LIMITS);
+            out.extend_from_slice(&max_mint_per_epoch.to_le_bytes());
+        }
+        GovernanceAction::SetPauser { pauser } => {
+            out.push(ACTION_SET_PAUSER);
+            out.extend_from_slice(pauser);
+        }
+        GovernanceAction::BindLatticeGenesis => out.push(ACTION_BIND_LATTICE_GENESIS),
+    }
+}
+
+fn parse_bool(d: &[u8], o: usize) -> BridgeResult<bool> {
+    match u8_at(d, o)? {
+        0 => Ok(false),
+        1 => Ok(true),
+        _ => Err(BridgeError::MalformedMessage),
+    }
+}
+
+/// Parses a kind-4 body. `body` starts at message offset 196; every action
+/// has an exact length, trailing bytes are rejected.
+pub fn parse_governance_body(body: &[u8]) -> BridgeResult<GovernanceAction> {
+    let action = u8_at(body, 0)?;
+    let exact = |len: usize| {
+        if body.len() == len {
+            Ok(())
+        } else {
+            Err(BridgeError::MalformedMessage)
+        }
+    };
+    match action {
+        ACTION_ROTATE_GUARDIANS => {
+            let new_epoch = u64_at(body, 1)?;
+            let threshold = u8_at(body, 9)?;
+            let count = usize::from(u8_at(body, 10)?);
+            let scheme = u8_at(body, 11)?;
+            let entry_len = key_entry_len(scheme)?;
+            if count == 0 || count > MAX_GUARDIANS {
+                return Err(BridgeError::InvalidGuardianSet);
+            }
+            exact(12usize.saturating_add(count.saturating_mul(entry_len)))?;
+            let keys = body
+                .get(12..)
+                .ok_or(BridgeError::MalformedMessage)?
+                .chunks_exact(entry_len)
+                .map(|entry| parse_key_entry(scheme, entry))
+                .collect::<BridgeResult<Vec<_>>>()?;
+            Ok(GovernanceAction::RotateGuardians {
+                new_epoch,
+                threshold,
+                scheme,
+                keys,
+            })
+        }
+        ACTION_SET_PAUSE => {
+            exact(3)?;
+            Ok(GovernanceAction::SetPause {
+                deposits_paused: parse_bool(body, 1)?,
+                withdrawals_paused: parse_bool(body, 2)?,
+            })
+        }
+        ACTION_SET_LIMITS => {
+            exact(9)?;
+            Ok(GovernanceAction::SetLimits {
+                max_mint_per_epoch: u64_at(body, 1)?,
+            })
+        }
+        ACTION_SET_PAUSER => {
+            exact(33)?;
+            Ok(GovernanceAction::SetPauser {
+                pauser: a32(body, 1)?,
+            })
+        }
+        ACTION_BIND_LATTICE_GENESIS => {
+            exact(1)?;
+            Ok(GovernanceAction::BindLatticeGenesis)
+        }
+        _ => Err(BridgeError::UnknownGovernanceAction),
+    }
+}
+
+pub fn encode_governance(header: &Header, action: &GovernanceAction) -> Vec<u8> {
+    let mut out = Vec::with_capacity(HEADER_LEN.saturating_add(16));
+    encode_header(header, &mut out);
+    encode_governance_body(action, &mut out);
+    out
+}
+
+pub fn digest(message: &[u8]) -> [u8; 32] {
+    hashv(&[message]).to_bytes()
+}
+
+pub fn deployment_id(label: &[u8]) -> [u8; 32] {
+    hashv(&[DEPLOYMENT_TAG, label]).to_bytes()
+}
+
+pub fn deposit_event_id(deployment_id: &[u8; 32], sequence: u64) -> [u8; 32] {
+    hashv(&[DEPOSIT_EVENT_TAG, deployment_id, &sequence.to_le_bytes()]).to_bytes()
+}
+
+pub fn burn_event_id(deployment_id: &[u8; 32], sequence: u64) -> [u8; 32] {
+    hashv(&[BURN_EVENT_TAG, deployment_id, &sequence.to_le_bytes()]).to_bytes()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn header(kind: u8) -> Header {
+        Header {
+            kind,
+            protocol_version: PROTOCOL_VERSION,
+            scheme: SCHEME_ED25519,
+            deployment_id: [1; 32],
+            solana_genesis_hash: [2; 32],
+            lattice_genesis_hash: [3; 32],
+            source_program_id: [4; 32],
+            source_mint: [5; 32],
+            signer_epoch: 7,
+            nonce: 9,
+        }
+    }
+
+    #[test]
+    fn transfer_layout_matches_spec_offsets() {
+        let t = Transfer {
+            header: header(KIND_DEPOSIT),
+            source_amount: 0x0102_0304_0506_0708,
+            native_amount: 0x1112_1314_1516_1718,
+            recipient: [6; 32],
+            event_id: [8; 32],
+        };
+        let bytes = encode_transfer(&t);
+        assert_eq!(bytes.len(), TRANSFER_LEN);
+        assert_eq!(&bytes[0..16], DOMAIN);
+        assert_eq!(bytes[16], KIND_DEPOSIT);
+        assert_eq!(bytes[19], 0);
+        assert_eq!(&bytes[20..52], &[1; 32]);
+        assert_eq!(&bytes[84..116], &[3; 32]);
+        assert_eq!(&bytes[180..188], &7u64.to_le_bytes());
+        assert_eq!(&bytes[188..196], &9u64.to_le_bytes());
+        assert_eq!(&bytes[196..204], &t.source_amount.to_le_bytes());
+        assert_eq!(&bytes[212..244], &[6; 32]);
+        assert_eq!(parse_transfer(&bytes), Ok(t));
+    }
+
+    #[test]
+    fn rejects_bad_framing() {
+        let mut bytes = encode_transfer(&Transfer {
+            header: header(KIND_DEPOSIT),
+            source_amount: 1,
+            native_amount: 1,
+            recipient: [6; 32],
+            event_id: [8; 32],
+        });
+        assert_eq!(
+            parse_transfer(&bytes[..275]),
+            Err(BridgeError::MalformedMessage)
+        );
+        bytes[19] = 1;
+        assert_eq!(parse_transfer(&bytes), Err(BridgeError::MalformedMessage));
+        bytes[19] = 0;
+        bytes[0] = b'X';
+        assert_eq!(parse_transfer(&bytes), Err(BridgeError::WrongDomain));
+    }
+
+    #[test]
+    fn governance_round_trip_and_exact_lengths() {
+        let actions = [
+            GovernanceAction::SetPause {
+                deposits_paused: true,
+                withdrawals_paused: false,
+            },
+            GovernanceAction::SetLimits {
+                max_mint_per_epoch: 42,
+            },
+            GovernanceAction::SetPauser { pauser: [9; 32] },
+            GovernanceAction::BindLatticeGenesis,
+            GovernanceAction::RotateGuardians {
+                new_epoch: 2,
+                threshold: 2,
+                scheme: SCHEME_ED25519,
+                keys: vec![
+                    GuardianKey {
+                        ed25519: Some([1; 32]),
+                        mldsa65: None,
+                    },
+                    GuardianKey {
+                        ed25519: Some([2; 32]),
+                        mldsa65: None,
+                    },
+                ],
+            },
+        ];
+        for action in actions {
+            let message = encode_governance(&header(KIND_DESTINATION_GOVERNANCE), &action);
+            assert_eq!(parse_governance_body(&message[HEADER_LEN..]), Ok(action));
+            let mut padded = message[HEADER_LEN..].to_vec();
+            padded.push(0);
+            assert_eq!(
+                parse_governance_body(&padded),
+                Err(BridgeError::MalformedMessage)
+            );
+        }
+        assert_eq!(
+            parse_governance_body(&[99]),
+            Err(BridgeError::UnknownGovernanceAction)
+        );
+    }
+
+    #[test]
+    fn event_ids_are_domain_separated() {
+        let dep = deployment_id(b"lattice-mainnet-beta-1");
+        assert_ne!(deposit_event_id(&dep, 0), burn_event_id(&dep, 0));
+        assert_ne!(deposit_event_id(&dep, 0), deposit_event_id(&dep, 1));
+        assert_eq!(
+            deployment_id(b"x"),
+            hashv(&[b"lattice-bridge/1:deployment", b"x"]).to_bytes()
+        );
+    }
