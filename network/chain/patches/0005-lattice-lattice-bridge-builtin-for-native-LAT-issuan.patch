+#![allow(clippy::arithmetic_side_effects, clippy::indexing_slicing)]
+
+use {
+    super::Entrypoint,
+    crate::{
+        error::BridgeError,
+        instruction::builders,
+        state::{
+            self, AttestationHeader, BridgeState, BurnReceipt, FLAG_LATTICE_GENESIS_BOUND,
+            GuardianSet, MintRecord, NETWORK_MAINNET, STATE_LEN,
+        },
+        wire::{self, GovernanceAction, GuardianKey, Header, Transfer},
+    },
+    ed25519_dalek::Signer as _,
+    solana_account::{AccountSharedData, ReadableAccount},
+    solana_instruction::{Instruction, error::InstructionError},
+    solana_program_runtime::{
+        invoke_context::mock_process_instruction, program_cache_entry::ProgramCacheEntry,
+        solana_sbpf::program::BuiltinFunctionDefinition,
+    },
+    solana_pubkey::Pubkey,
+    solana_sdk_ids::{native_loader, system_program, sysvar},
+    std::{cell::Cell, collections::HashMap, sync::Arc},
+};
+
+const LAMPORTS_PER_BYTE: u64 = 6_960;
+const SLOT: u64 = 1_000;
+const EPOCH: u64 = 3;
+const DECIMALS: u8 = 6;
+const SCALE: u64 = 1_000;
+const SOLANA_GENESIS: [u8; 32] = [0x11; 32];
+const LATTICE_GENESIS: [u8; 32] = [0x22; 32];
+const SOURCE_PROGRAM: [u8; 32] = [0x33; 32];
+const SOURCE_MINT: [u8; 32] = [0x44; 32];
+
+fn account_with(lamports: u64, owner: &Pubkey, data: &[u8]) -> AccountSharedData {
+    let mut account = AccountSharedData::new(lamports, data.len(), owner);
+    account.set_data_from_slice(data);
+    account
+}
+
+fn rent_account() -> AccountSharedData {
+    let mut data = LAMPORTS_PER_BYTE.to_le_bytes().to_vec();
+    data.extend_from_slice(&2.0f64.to_le_bytes());
+    data.push(50);
+    account_with(1, &sysvar::id(), &data)
+}
+
+fn clock_account() -> AccountSharedData {
+    let mut data = Vec::new();
+    for value in [SLOT, 0, EPOCH, EPOCH + 1, 0] {
+        data.extend_from_slice(&value.to_le_bytes());
+    }
+    account_with(1, &sysvar::id(), &data)
+}
+
+fn program_account(data: Vec<u8>) -> AccountSharedData {
+    let lamports = (128 + data.len() as u64) * LAMPORTS_PER_BYTE;
+    account_with(lamports, &crate::id(), &data)
+}
+
+fn bridge_error(error: BridgeError) -> InstructionError {
+    InstructionError::from(error)
+}
+
+struct Env {
+    accounts: HashMap<Pubkey, AccountSharedData>,
+    deployment_id: [u8; 32],
+    guardians: Vec<ed25519_dalek::SigningKey>,
+    epoch: u64,
+    payer: Pubkey,
+}
+
+impl Env {
+    fn new() -> Self {
+        let deployment_id = wire::deployment_id(b"processor-test");
+        let guardians: Vec<_> = (1..=3u8)
+            .map(|seed| ed25519_dalek::SigningKey::from_bytes(&[seed; 32]))
+            .collect();
+        let program_id = crate::id();
+        let (set_address, set_bump) = state::guardian_set_address(&program_id, &deployment_id, 1);
+        let set = GuardianSet {
+            scheme: wire::SCHEME_ED25519,
+            threshold: 2,
+            bump: set_bump,
+            epoch: 1,
+            created_slot: 0,
+            deployment_id,
+            keys: guardians
+                .iter()
+                .map(|key| GuardianKey {
+                    ed25519: Some(key.verifying_key().to_bytes()),
+                    mldsa65: None,
+                })
+                .collect(),
+        };
+        let (state_address, state_bump) = state::state_address(&program_id, &deployment_id);
+        let mut bridge_state = BridgeState {
+            deployment_id,
+            guardian_epoch: 1,
+            bump: state_bump,
+            source_decimals: DECIMALS,
+            network: NETWORK_MAINNET,
+            solana_genesis_hash: SOLANA_GENESIS,
+            lattice_genesis_hash: LATTICE_GENESIS,
+            source_program_id: SOURCE_PROGRAM,
+            source_mint: SOURCE_MINT,
+            pauser: Pubkey::new_from_array([0x77; 32]).to_bytes(),
+            max_mint_per_epoch: u64::MAX,
+            ..BridgeState::default()
+        };
+        bridge_state.set_flag(FLAG_LATTICE_GENESIS_BOUND, true);
+        let payer = Pubkey::new_unique();
+        let mut accounts = HashMap::new();
+        accounts.insert(
+            payer,
+            AccountSharedData::new(100_000_000_000, 0, &system_program::id()),
+        );
+        accounts.insert(state_address, program_account(bridge_state.encode()));
+        accounts.insert(set_address, program_account(set.encode().unwrap()));
+        Self {
+            accounts,
+            deployment_id,
+            guardians,
+            epoch: 1,
+            payer,
+        }
+    }
+
+    fn state(&self) -> BridgeState {
+        let address = state::state_address(&crate::id(), &self.deployment_id).0;
+        BridgeState::decode(self.accounts[&address].data()).unwrap()
+    }
+
+    fn lamports(&self, key: &Pubkey) -> u64 {
+        self.accounts.get(key).map(|a| a.lamports()).unwrap_or(0)
+    }
+
+    fn total_lamports(&self) -> u128 {
+        self.accounts
+            .values()
+            .map(|a| u128::from(a.lamports()))
+            .sum()
+    }
+
+    /// Runs one top-level instruction. Accounts are written back only on
+    /// success (a failed instruction fails the transaction). Returns the
+    /// native supply delta the instruction recorded.
+    fn run(&mut self, instruction: Instruction, expected: Result<(), InstructionError>) -> i128 {
+        let mut keys: Vec<Pubkey> = Vec::new();
+        for meta in &instruction.accounts {
+            if !keys.contains(&meta.pubkey) {
+                keys.push(meta.pubkey);
+            }
+        }
+        let mut accounts: Vec<(Pubkey, AccountSharedData)> = keys
+            .iter()
+            .map(|key| {
+                let account = if *key == system_program::id() {
+                    AccountSharedData::new(0, 0, &native_loader::id())
+                } else {
+                    self.accounts.get(key).cloned().unwrap_or_default()
+                };
+                (*key, account)
+            })
+            .collect();
+        accounts.push((sysvar::rent::id(), rent_account()));
+        accounts.push((sysvar::clock::id(), clock_account()));
+        let delta = Cell::new(0i128);
+        let succeeded = expected.is_ok();
+        let results = mock_process_instruction(
+            &crate::id(),
+            &instruction.data,
+            accounts,
+            instruction.accounts.clone(),
+            expected,
+            Entrypoint::register,
+            |invoke_context| {
+                invoke_context.program_cache_for_tx_batch.replenish(
+                    system_program::id(),
+                    Arc::new(ProgramCacheEntry::new_builtin(
+                        0,
+                        solana_system_program::system_processor::Entrypoint::register,
+                    )),
+                );
+            },
+            |invoke_context| delta.set(invoke_context.transaction_context.native_supply_delta()),
+        );
+        if succeeded {
+            for (key, account) in keys.iter().zip(results) {
+                if *key != system_program::id() {
+                    self.accounts.insert(*key, account);
+                }
+            }
+        }
+        delta.get()
+    }
+
+    fn header(&self, kind: u8, nonce: u64) -> Header {
+        Header {
+            kind,
+            protocol_version: wire::PROTOCOL_VERSION,
+            scheme: wire::SCHEME_ED25519,
+            deployment_id: self.deployment_id,
+            solana_genesis_hash: SOLANA_GENESIS,
+            lattice_genesis_hash: LATTICE_GENESIS,
+            source_program_id: SOURCE_PROGRAM,
+            source_mint: SOURCE_MINT,
+            signer_epoch: self.epoch,
+            nonce,
+        }
+    }
+
+    fn deposit_message(&self, sequence: u64, source_amount: u64, recipient: &Pubkey) -> Vec<u8> {
+        wire::encode_transfer(&Transfer {
+            header: self.header(wire::KIND_DEPOSIT, sequence),
+            source_amount,
+            native_amount: source_amount * SCALE,
+            recipient: recipient.to_bytes(),
+            event_id: wire::deposit_event_id(&self.deployment_id, sequence),
+        })
+    }
+
+    /// Creates, fills and verifies an attestation through the builtin.
+    fn attest(
+        &mut self,
+        message: &[u8],
+        signers: &[u8],
+        guardians: &[ed25519_dalek::SigningKey],
+    ) -> Pubkey {
+        let attestation = Pubkey::new_unique();
+        let count = signers.len() as u8;
+        let len = AttestationHeader::total_len(wire::SCHEME_ED25519, message.len() as u32, count)
+            .unwrap();
+        self.accounts
+            .insert(attestation, program_account(vec![0; len]));
+        let payer = self.payer;
+        self.run(
+            builders::init_attestation(
+                &payer,
+                &attestation,
+                wire::SCHEME_ED25519,
+                count,
+                message.len() as u32,
+            ),
+            Ok(()),
+        );
+        let digest = wire::digest(message);
+        let mut body = message.to_vec();
+        for index in signers {
+            body.push(*index);
+            body.extend_from_slice(&guardians[usize::from(*index)].sign(&digest).to_bytes());
+        }
+        self.run(
+            builders::write_attestation(&payer, &attestation, 0, body),
+            Ok(()),
+        );
+        let delta = self.run(
+            builders::verify_attestation(&attestation, &self.deployment_id, self.epoch, 0, count),
+            Ok(()),
+        );
+        assert_eq!(delta, 0);
+        attestation
+    }
+
+    fn mint_ix(&self, attestation: &Pubkey, sequence: u64, recipient: &Pubkey) -> Instruction {
+        builders::mint_from_deposit(
+            &self.payer,
+            attestation,
+            &self.deployment_id,
+            self.epoch,
+            sequence,
+            recipient,
+        )
+    }
+}
+
+#[test]
+fn mint_then_burn_moves_native_supply_exactly() {
+    let mut env = Env::new();
+    let recipient = Pubkey::new_unique();
+    env.accounts.insert(
+        recipient,
+        AccountSharedData::new(1_000_000_000, 0, &system_program::id()),
+    );
+    let message = env.deposit_message(0, 2_500_000, &recipient);
+    let guardians = env.guardians.clone();
+    let attestation = env.attest(&message, &[0, 2], &guardians);
+    let attestation_lamports = env.lamports(&attestation);
+    let payer_before = env.lamports(&env.payer);
+    let total_before = env.total_lamports();
+
+    let delta = env.run(env.mint_ix(&attestation, 0, &recipient), Ok(()));
+    let native = 2_500_000 * SCALE;
+    assert_eq!(delta, i128::from(native));
+    assert_eq!(env.total_lamports(), total_before + u128::from(native));
+    assert_eq!(env.lamports(&recipient), 1_000_000_000 + native);
+    let record_address = state::mint_record_address(&crate::id(), &env.deployment_id, 0).0;
+    let record_account = &env.accounts[&record_address];
+    assert_eq!(record_account.owner(), &crate::id());
+    let record = MintRecord::decode(record_account.data()).unwrap();
+    assert_eq!(record.recipient, recipient.to_bytes());
+    assert_eq!(record.native_amount, native);
+    assert_eq!(record.slot, SLOT);
+    // The attestation is closed and refunded to the payer, who paid the record rent.
+    assert_eq!(env.lamports(&attestation), 0);
+    assert!(env.accounts[&attestation].data().is_empty());
+    assert_eq!(
+        env.lamports(&env.payer),
+        payer_before + attestation_lamports - record_account.lamports()
+    );
+    let bridge = env.state();
+    assert_eq!(bridge.total_minted_native, u128::from(native));
+    assert_eq!(bridge.outstanding_native, u128::from(native));
+    assert_eq!(bridge.minted_in_rate_epoch, native);
+    assert_eq!(bridge.rate_limit_epoch, EPOCH);
+
+    // Burn: the burner pays the receipt rent; `amount` leaves supply.
+    let state_address = state::state_address(&crate::id(), &env.deployment_id).0;
+    let state_lamports = env.lamports(&state_address);
+    let burner_before = env.lamports(&recipient);
+    let total_before = env.total_lamports();
+    let solana_wallet = [0x5A; 32];
+    let amount = 1_000_000 * SCALE;
+    let delta = env.run(
+        builders::burn_for_withdrawal(&recipient, &env.deployment_id, 0, amount, solana_wallet),
+        Ok(()),
+    );
+    assert_eq!(delta, -i128::from(amount));
+    assert_eq!(env.total_lamports(), total_before - u128::from(amount));
+    assert_eq!(env.lamports(&state_address), state_lamports);
+    let receipt_address = state::burn_receipt_address(&crate::id(), &env.deployment_id, 0).0;
+    let receipt_account = &env.accounts[&receipt_address];
+    let receipt = BurnReceipt::decode(receipt_account.data()).unwrap();
+    assert_eq!(receipt.burn_sequence, 0);
+    assert_eq!(receipt.burner, recipient.to_bytes());
+    assert_eq!(receipt.source_amount, 1_000_000);
+    assert_eq!(receipt.solana_recipient, solana_wallet);
+    assert_eq!(receipt.event_id, wire::burn_event_id(&env.deployment_id, 0));
+    assert_eq!(
+        env.lamports(&recipient),
+        burner_before - amount - receipt_account.lamports()
+    );
+    let bridge = env.state();
+    assert_eq!(bridge.next_burn_sequence, 1);
+    assert_eq!(bridge.total_burned_native, u128::from(amount));
+    assert_eq!(bridge.outstanding_native, u128::from(native - amount));
+
+    // Receipt address must be the next sequence; amounts must be whole source units.
+    env.run(
+        builders::burn_for_withdrawal(&recipient, &env.deployment_id, 0, SCALE, solana_wallet),
+        Err(bridge_error(BridgeError::InvalidRecordAccount)),
+    );
+    env.run(
+        builders::burn_for_withdrawal(&recipient, &env.deployment_id, 1, SCALE + 1, solana_wallet),
+        Err(bridge_error(BridgeError::NotMultipleOfScale)),
+    );
+}
