@@ -0,0 +1,633 @@
+//! Fixed little-endian account layouts. Every account starts with an 8-byte
+//! ASCII magic and a 1-byte layout version. Offsets are documented in
+//! docs/NATIVE_ISSUANCE.md; the first 98 bytes of `LATSTAT1`, and the whole
+//! of `LATMINT1` and `LATBURN1`, are exactly BRIDGE_SPEC §9.
+
+use {
+    crate::{
+        error::{BridgeError, BridgeResult},
+        wire::{self, GuardianKey, a32, u8_at, u64_at},
+    },
+    solana_pubkey::Pubkey,
+};
+
+pub const LAYOUT_VERSION: u8 = 1;
+
+pub const STATE_MAGIC: &[u8; 8] = b"LATSTAT1";
+pub const GUARDIAN_SET_MAGIC: &[u8; 8] = b"LATGSET1";
+pub const MINT_RECORD_MAGIC: &[u8; 8] = b"LATMINT1";
+pub const BURN_RECEIPT_MAGIC: &[u8; 8] = b"LATBURN1";
+pub const ATTESTATION_MAGIC: &[u8; 8] = b"LATATST1";
+
+pub const STATE_LEN: usize = 384;
+pub const MINT_RECORD_LEN: usize = 129;
+pub const BURN_RECEIPT_LEN: usize = 169;
+pub const GUARDIAN_SET_HEADER_LEN: usize = 64;
+pub const ATTESTATION_HEADER_LEN: usize = 96;
+
+pub const FLAG_DEPOSITS_PAUSED: u8 = 1;
+pub const FLAG_WITHDRAWALS_PAUSED: u8 = 1 << 1;
+pub const FLAG_LATTICE_GENESIS_BOUND: u8 = 1 << 2;
+
+pub const NETWORK_MAINNET: u8 = 1;
+pub const NETWORK_TESTNET: u8 = 2;
+pub const NETWORK_DEVELOPMENT: u8 = 3;
+
+pub const SEED_STATE: &[u8] = b"state";
+pub const SEED_GUARDIAN_SET: &[u8] = b"guardian-set";
+pub const SEED_MINTED: &[u8] = b"minted";
+pub const SEED_BURN: &[u8] = b"burn";
+
+fn put(out: &mut [u8], offset: usize, bytes: &[u8]) {
+    if let Some(dst) = offset
+        .checked_add(bytes.len())
+        .and_then(|end| out.get_mut(offset..end))
+    {
+        dst.copy_from_slice(bytes);
+    }
+}
+
+fn u128_at(d: &[u8], o: usize) -> BridgeResult<u128> {
+    d.get(o..o.saturating_add(16))
+        .and_then(|s| <[u8; 16]>::try_from(s).ok())
+        .map(u128::from_le_bytes)
+        .ok_or(BridgeError::MalformedMessage)
+}
+
+fn u32_at(d: &[u8], o: usize) -> BridgeResult<u32> {
+    d.get(o..o.saturating_add(4))
+        .and_then(|s| <[u8; 4]>::try_from(s).ok())
+        .map(u32::from_le_bytes)
+        .ok_or(BridgeError::MalformedMessage)
+}
+
+fn check_magic(d: &[u8], magic: &[u8; 8], error: BridgeError) -> BridgeResult<()> {
+    if d.get(0..8) == Some(magic.as_slice()) && d.get(8) == Some(&LAYOUT_VERSION) {
+        Ok(())
+    } else {
+        Err(error)
+    }
+}
+
+/// Bridge state, one per deployment, at `PDA(["state", deployment_id])`.
+#[derive(Clone, Debug, Default, PartialEq, Eq)]
+pub struct BridgeState {
+    // BRIDGE_SPEC §9.3 prefix (offsets 0..98)
+    pub deployment_id: [u8; 32],
+    pub next_burn_sequence: u64,
+    pub minted_count: u64,
+    pub total_minted_native: u128,
+    pub total_burned_native: u128,
+    pub guardian_epoch: u64,
+    pub flags: u8,
+    // Lattice extension (offsets 98..384)
+    pub bump: u8,
+    pub source_decimals: u8,
+    pub network: u8,
+    pub solana_genesis_hash: [u8; 32],
+    pub lattice_genesis_hash: [u8; 32],
+    pub source_program_id: [u8; 32],
+    pub source_mint: [u8; 32],
+    pub pauser: [u8; 32],
+    pub governance_sequence: u64,
+    pub max_mint_per_epoch: u64,
+    pub rate_limit_epoch: u64,
+    pub minted_in_rate_epoch: u64,
+    /// Lamports issued in genesis against deposits finalized on Solana before
+    /// launch (pre-consumed mint records); included in `total_minted_native`.
+    pub genesis_bootstrap_native: u64,
+    /// Genesis lamports NOT covered by any Solana deposit (testnet faucet etc).
+    /// The Lattice mainnet genesis tool refuses to produce a non-zero value.
+    pub genesis_unbacked_native: u64,
+    /// `total_minted_native - total_burned_native`, kept for RPC readers.
+    pub outstanding_native: u128,
+    pub last_mint_slot: u64,
+    pub last_burn_slot: u64,
+}
+
+impl BridgeState {
+    pub fn is_flag(&self, flag: u8) -> bool {
+        self.flags & flag != 0
+    }
+
+    pub fn set_flag(&mut self, flag: u8, value: bool) {
+        if value {
+            self.flags |= flag;
+        } else {
+            self.flags &= !flag;
+        }
+    }
+
+    pub fn encode(&self) -> Vec<u8> {
+        let mut d = vec![0u8; STATE_LEN];
+        put(&mut d, 0, STATE_MAGIC);
+        put(&mut d, 8, &[LAYOUT_VERSION]);
+        put(&mut d, 9, &self.deployment_id);
+        put(&mut d, 41, &self.next_burn_sequence.to_le_bytes());
+        put(&mut d, 49, &self.minted_count.to_le_bytes());
+        put(&mut d, 57, &self.total_minted_native.to_le_bytes());
+        put(&mut d, 73, &self.total_burned_native.to_le_bytes());
+        put(&mut d, 89, &self.guardian_epoch.to_le_bytes());
+        put(&mut d, 97, &[self.flags]);
+        put(&mut d, 98, &[self.bump, self.source_decimals, self.network]);
+        put(&mut d, 104, &self.solana_genesis_hash);
+        put(&mut d, 136, &self.lattice_genesis_hash);
+        put(&mut d, 168, &self.source_program_id);
+        put(&mut d, 200, &self.source_mint);
+        put(&mut d, 232, &self.pauser);
+        put(&mut d, 264, &self.governance_sequence.to_le_bytes());
+        put(&mut d, 272, &self.max_mint_per_epoch.to_le_bytes());
+        put(&mut d, 280, &self.rate_limit_epoch.to_le_bytes());
+        put(&mut d, 288, &self.minted_in_rate_epoch.to_le_bytes());
+        put(&mut d, 296, &self.genesis_bootstrap_native.to_le_bytes());
+        put(&mut d, 304, &self.genesis_unbacked_native.to_le_bytes());
+        put(&mut d, 312, &self.outstanding_native.to_le_bytes());
+        put(&mut d, 328, &self.last_mint_slot.to_le_bytes());
+        put(&mut d, 336, &self.last_burn_slot.to_le_bytes());
+        d
+    }
+
+    pub fn decode(d: &[u8]) -> BridgeResult<Self> {
+        if d.len() != STATE_LEN {
+            return Err(BridgeError::InvalidStateAccount);
+        }
+        check_magic(d, STATE_MAGIC, BridgeError::InvalidStateAccount)?;
+        Ok(Self {
+            deployment_id: a32(d, 9)?,
+            next_burn_sequence: u64_at(d, 41)?,
+            minted_count: u64_at(d, 49)?,
+            total_minted_native: u128_at(d, 57)?,
+            total_burned_native: u128_at(d, 73)?,
+            guardian_epoch: u64_at(d, 89)?,
+            flags: u8_at(d, 97)?,
+            bump: u8_at(d, 98)?,
+            source_decimals: u8_at(d, 99)?,
+            network: u8_at(d, 100)?,
+            solana_genesis_hash: a32(d, 104)?,
+            lattice_genesis_hash: a32(d, 136)?,
+            source_program_id: a32(d, 168)?,
+            source_mint: a32(d, 200)?,
+            pauser: a32(d, 232)?,
+            governance_sequence: u64_at(d, 264)?,
+            max_mint_per_epoch: u64_at(d, 272)?,
+            rate_limit_epoch: u64_at(d, 280)?,
+            minted_in_rate_epoch: u64_at(d, 288)?,
+            genesis_bootstrap_native: u64_at(d, 296)?,
+            genesis_unbacked_native: u64_at(d, 304)?,
+            outstanding_native: u128_at(d, 312)?,
+            last_mint_slot: u64_at(d, 328)?,
+            last_burn_slot: u64_at(d, 336)?,
+        })
+    }
+}
+
+/// Guardian set for one epoch at `PDA(["guardian-set", deployment_id, u64 epoch])`.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct GuardianSet {
+    pub scheme: u8,
+    pub threshold: u8,
+    pub bump: u8,
+    pub epoch: u64,
+    pub created_slot: u64,
+    pub deployment_id: [u8; 32],
+    pub keys: Vec<GuardianKey>,
+}
+
+impl GuardianSet {
+    pub fn encoded_len(scheme: u8, count: usize) -> BridgeResult<usize> {
+        wire::key_entry_len(scheme)?
+            .checked_mul(count)
+            .and_then(|keys| keys.checked_add(GUARDIAN_SET_HEADER_LEN))
+            .ok_or(BridgeError::Overflow)
+    }
+
+    /// BRIDGE_SPEC §4 constraints plus scheme/key-shape consistency.
+    pub fn validate(&self) -> BridgeResult<()> {
+        let count = self.keys.len();
+        let threshold = usize::from(self.threshold);
+        if count == 0
+            || count > wire::MAX_GUARDIANS
+            || threshold < 2
+            || threshold > count
+            || threshold.saturating_mul(2) <= count
+        {
+            return Err(BridgeError::InvalidGuardianSet);
+        }
+        wire::key_entry_len(self.scheme).map_err(|_| BridgeError::InvalidGuardianSet)?;
+        for (i, key) in self.keys.iter().enumerate() {
+            if key.ed25519.is_some() != wire::scheme_has_ed25519(self.scheme)
+                || key.mldsa65.is_some() != wire::scheme_has_mldsa65(self.scheme)
+            {
+                return Err(BridgeError::InvalidGuardianSet);
+            }
+            if let Some(ed) = &key.ed25519 {
+                if ed.iter().all(|b| *b == 0) {
+                    return Err(BridgeError::InvalidGuardianSet);
+                }
+            }
+            if let Some(pq) = &key.mldsa65 {
+                if pq.len() != agave_mldsa_verify::MLDSA65_PUBLIC_KEY_LEN
+                    || pq.iter().all(|b| *b == 0)
+                {
+                    return Err(BridgeError::InvalidGuardianSet);
+                }
+            }
+            for other in self.keys.iter().skip(i.saturating_add(1)) {
+                let same_ed = key.ed25519.is_some() && key.ed25519 == other.ed25519;
+                let same_pq = key.mldsa65.is_some() && key.mldsa65 == other.mldsa65;
+                if same_ed || same_pq {
+                    return Err(BridgeError::InvalidGuardianSet);
+                }
+            }
+        }
+        Ok(())
+    }
+
+    pub fn encode(&self) -> BridgeResult<Vec<u8>> {
+        let mut d = vec![0u8; GUARDIAN_SET_HEADER_LEN];
+        put(&mut d, 0, GUARDIAN_SET_MAGIC);
+        put(
+            &mut d,
+            8,
+            &[
+                LAYOUT_VERSION,
+                self.scheme,
+                self.threshold,
+                u8::try_from(self.keys.len()).map_err(|_| BridgeError::InvalidGuardianSet)?,
+                self.bump,
+            ],
+        );
+        put(&mut d, 16, &self.epoch.to_le_bytes());
+        put(&mut d, 24, &self.created_slot.to_le_bytes());
+        put(&mut d, 32, &self.deployment_id);
+        for key in &self.keys {
+            wire::encode_key_entry(key, &mut d);
+        }
+        if d.len() != Self::encoded_len(self.scheme, self.keys.len())? {
+            return Err(BridgeError::InvalidGuardianSet);
+        }
+        Ok(d)
+    }
+
+    pub fn decode(d: &[u8]) -> BridgeResult<Self> {
+        check_magic(
+            d,
+            GUARDIAN_SET_MAGIC,
+            BridgeError::InvalidGuardianSetAccount,
+        )?;
+        let scheme = u8_at(d, 9)?;
+        let count = usize::from(u8_at(d, 11)?);
+        let entry_len =
+            wire::key_entry_len(scheme).map_err(|_| BridgeError::InvalidGuardianSetAccount)?;
+        if d.len() != Self::encoded_len(scheme, count)? {
+            return Err(BridgeError::InvalidGuardianSetAccount);
+        }
+        let keys = d
+            .get(GUARDIAN_SET_HEADER_LEN..)
+            .ok_or(BridgeError::InvalidGuardianSetAccount)?
+            .chunks_exact(entry_len)
+            .map(|entry| wire::parse_key_entry(scheme, entry))
+            .collect::<BridgeResult<Vec<_>>>()?;
+        Ok(Self {
+            scheme,
+            threshold: u8_at(d, 10)?,
+            bump: u8_at(d, 12)?,
+            epoch: u64_at(d, 16)?,
+            created_slot: u64_at(d, 24)?,
+            deployment_id: a32(d, 32)?,
+            keys,
+        })
+    }
+}
+
+/// Exactly-once marker for a Solana deposit at
+/// `PDA(["minted", deployment_id, u64 deposit_sequence])` (BRIDGE_SPEC §9).
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct MintRecord {
+    pub deployment_id: [u8; 32],
+    pub deposit_sequence: u64,
