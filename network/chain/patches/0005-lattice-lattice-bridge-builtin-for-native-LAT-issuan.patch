+fn govern_rotates_guardians_and_retires_old_set() {
+    let mut env = Env::new();
+    let next: Vec<_> = (60..64u8)
+        .map(|s| ed25519_dalek::SigningKey::from_bytes(&[s; 32]))
+        .collect();
+    let action = GovernanceAction::RotateGuardians {
+        new_epoch: 2,
+        threshold: 3,
+        scheme: wire::SCHEME_ED25519,
+        keys: next
+            .iter()
+            .map(|key| GuardianKey {
+                ed25519: Some(key.verifying_key().to_bytes()),
+                mldsa65: None,
+            })
+            .collect(),
+    };
+    let message =
+        wire::encode_governance(&env.header(wire::KIND_DESTINATION_GOVERNANCE, 0), &action);
+    let guardians = env.guardians.clone();
+    let attestation = env.attest(&message, &[0, 1], &guardians);
+    let payer = env.payer;
+    let ix = builders::govern(&payer, &attestation, &env.deployment_id, 1, Some(2));
+    assert_eq!(env.run(ix, Ok(())), 0);
+    assert_eq!(env.state().guardian_epoch, 2);
+    assert_eq!(env.state().governance_sequence, 1);
+    let new_set_address = state::guardian_set_address(&crate::id(), &env.deployment_id, 2).0;
+    let new_set = GuardianSet::decode(env.accounts[&new_set_address].data()).unwrap();
+    assert_eq!(
+        (new_set.epoch, new_set.threshold, new_set.keys.len()),
+        (2, 3, 4)
+    );
+
+    // Old-epoch attestations and the old set account are no longer usable.
+    let recipient = Pubkey::new_unique();
+    let stale = env.deposit_message(0, 1, &recipient);
+    let attestation = Pubkey::new_unique();
+    let len = AttestationHeader::total_len(wire::SCHEME_ED25519, stale.len() as u32, 2).unwrap();
+    env.accounts
+        .insert(attestation, program_account(vec![0; len]));
+    env.run(
+        builders::init_attestation(
+            &payer,
+            &attestation,
+            wire::SCHEME_ED25519,
+            2,
+            stale.len() as u32,
+        ),
+        Ok(()),
+    );
+    env.run(
+        builders::write_attestation(&payer, &attestation, 0, stale.clone()),
+        Ok(()),
+    );
+    env.run(
+        builders::verify_attestation(&attestation, &env.deployment_id, 1, 0, 2),
+        Err(bridge_error(BridgeError::WrongSignerEpoch)),
+    );
+
+    env.epoch = 2;
+    let fresh = env.deposit_message(0, 1, &recipient);
+    let attestation = env.attest(&fresh, &[0, 2, 3], &next);
+    env.accounts.insert(
+        recipient,
+        AccountSharedData::new(1_000_000_000, 0, &system_program::id()),
+    );
+    assert_eq!(
+        env.run(env.mint_ix(&attestation, 0, &recipient), Ok(())),
+        i128::from(SCALE)
+    );
+}
