+#[cfg(test)]
+mod tests {
+    use {super::*, crate::wire::SCHEME_ED25519};
+
+    #[test]
+    fn state_round_trip_and_spec_prefix() {
+        let state = BridgeState {
+            deployment_id: [1; 32],
+            next_burn_sequence: 3,
+            minted_count: 4,
+            total_minted_native: 5,
+            total_burned_native: 6,
+            guardian_epoch: 7,
+            flags: FLAG_LATTICE_GENESIS_BOUND,
+            source_decimals: 6,
+            network: NETWORK_MAINNET,
+            max_mint_per_epoch: 99,
+            outstanding_native: 11,
+            ..BridgeState::default()
+        };
+        let d = state.encode();
+        assert_eq!(d.len(), STATE_LEN);
+        assert_eq!(&d[0..8], STATE_MAGIC);
+        assert_eq!(&d[9..41], &[1; 32]);
+        assert_eq!(&d[41..49], &3u64.to_le_bytes());
+        assert_eq!(&d[57..73], &5u128.to_le_bytes());
+        assert_eq!(&d[89..97], &7u64.to_le_bytes());
+        assert_eq!(d[97], FLAG_LATTICE_GENESIS_BOUND);
+        assert_eq!(BridgeState::decode(&d), Ok(state));
+        assert_eq!(
+            BridgeState::decode(&d[..STATE_LEN - 1]),
+            Err(BridgeError::InvalidStateAccount)
+        );
+    }
+
+    #[test]
+    fn record_layouts_match_spec_sizes() {
+        let record = MintRecord {
+            deployment_id: [1; 32],
+            deposit_sequence: 2,
+            recipient: [3; 32],
+            native_amount: 4,
+            slot: 5,
+            event_id: [6; 32],
+        };
+        assert_eq!(record.encode().len(), 129);
+        assert_eq!(MintRecord::decode(&record.encode()), Ok(record));
+        let receipt = BurnReceipt {
+            deployment_id: [1; 32],
+            burn_sequence: 2,
+            burner: [3; 32],
+            native_amount: 4_000,
+            source_amount: 4,
+            solana_recipient: [5; 32],
+            slot: 6,
+            event_id: [7; 32],
+        };
+        let d = receipt.encode();
+        assert_eq!(d.len(), 169);
+        assert_eq!(&d[137..169], &[7; 32]);
+        assert_eq!(BurnReceipt::decode(&d), Ok(receipt));
+    }
+
+    #[test]
+    fn guardian_set_constraints() {
+        let key = |b: u8| GuardianKey {
+            ed25519: Some([b; 32]),
+            mldsa65: None,
+        };
+        let mut set = GuardianSet {
+            scheme: SCHEME_ED25519,
+            threshold: 2,
+            bump: 0,
+            epoch: 1,
+            created_slot: 0,
+            deployment_id: [0; 32],
+            keys: vec![key(1), key(2), key(3)],
+        };
+        assert_eq!(set.validate(), Ok(()));
+        assert_eq!(GuardianSet::decode(&set.encode().unwrap()), Ok(set.clone()));
+        set.threshold = 1;
+        assert_eq!(set.validate(), Err(BridgeError::InvalidGuardianSet));
+        set.threshold = 2;
+        set.keys.push(key(4));
+        // 2 * 2 > 4 fails: not a strict majority
+        assert_eq!(set.validate(), Err(BridgeError::InvalidGuardianSet));
+        set.threshold = 3;
+        assert_eq!(set.validate(), Ok(()));
+        set.keys[3] = key(1);
+        assert_eq!(set.validate(), Err(BridgeError::InvalidGuardianSet));
+        set.keys[3] = key(0);
+        assert_eq!(set.validate(), Err(BridgeError::InvalidGuardianSet));
+        set.keys[3] = GuardianKey {
+            ed25519: Some([4; 32]),
+            mldsa65: Some(vec![1; agave_mldsa_verify::MLDSA65_PUBLIC_KEY_LEN]),
+        };
+        assert_eq!(set.validate(), Err(BridgeError::InvalidGuardianSet));
+    }
+
+    #[test]
+    fn attestation_sizes() {
+        assert_eq!(signature_entry_len(1), Ok(65));
+        assert_eq!(signature_entry_len(2), Ok(1 + 3309));
+        assert_eq!(signature_entry_len(3), Ok(1 + 64 + 3309));
+        assert!(signature_entry_len(4).is_err());
+        assert_eq!(
+            AttestationHeader::total_len(1, 276, 13),
+            Ok(96 + 276 + 13 * 65)
+        );
+    }
+}
