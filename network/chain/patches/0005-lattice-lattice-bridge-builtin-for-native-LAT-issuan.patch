+#[test]
+fn wrong_domain_genesis_epoch_and_fields_are_rejected() {
+    let mut h = Harness::new(SCHEME_ED25519, 3, 2);
+    let base = h.deposit(0, 10, ALICE);
+    let cases: Vec<(Box<dyn Fn(&mut Transfer)>, BridgeError)> = vec![
+        (
+            Box::new(|t| t.header.kind = wire::KIND_WITHDRAWAL),
+            BridgeError::WrongKind,
+        ),
+        (
+            Box::new(|t| t.header.protocol_version = 2),
+            BridgeError::WrongProtocolVersion,
+        ),
+        (
+            Box::new(|t| t.header.deployment_id = [0xEE; 32]),
+            BridgeError::WrongDeployment,
+        ),
+        (
+            Box::new(|t| t.header.solana_genesis_hash = [0xEE; 32]),
+            BridgeError::WrongSolanaGenesis,
+        ),
+        (
+            Box::new(|t| t.header.lattice_genesis_hash = [0xEE; 32]),
+            BridgeError::WrongLatticeGenesis,
+        ),
+        (
+            Box::new(|t| t.header.source_program_id = [0xEE; 32]),
+            BridgeError::WrongSourceProgram,
+        ),
+        (
+            Box::new(|t| t.header.source_mint = [0xEE; 32]),
+            BridgeError::WrongSourceMint,
+        ),
+        (
+            Box::new(|t| t.header.signer_epoch = 2),
+            BridgeError::WrongSignerEpoch,
+        ),
+        (
+            Box::new(|t| t.event_id = [0xEE; 32]),
+            BridgeError::WrongEventId,
+        ),
+        (
+            Box::new(|t| t.native_amount += 1),
+            BridgeError::AmountMismatch,
+        ),
+        (
+            Box::new(|t| t.recipient = [0; 32]),
+            BridgeError::ZeroRecipient,
+        ),
+        (
+            Box::new(|t| {
+                t.source_amount = 0;
+                t.native_amount = 0;
+            }),
+            BridgeError::ZeroAmount,
+        ),
+    ];
+    for (mutate, expected) in cases {
+        let mut transfer = base;
+        mutate(&mut transfer);
+        let message = wire::encode_transfer(&transfer);
+        let result = h.mint_message(&message, &[0, 1]);
+        // Deployment and kind are already rejected while sealing; everything
+        // else is rejected by the deposit checks after a valid threshold.
+        assert_eq!(result, Err(expected), "case {expected:?}");
+    }
+    // Wrong domain bytes.
+    let mut message = wire::encode_transfer(&base);
+    message[..16].copy_from_slice(b"lattice-bridge/2");
+    assert_eq!(
+        h.mint_message(&message, &[0, 1]),
+        Err(BridgeError::WrongDomain)
+    );
+    // Wrong scheme byte (the set is Ed25519).
+    let mut transfer = base;
+    transfer.header.scheme = SCHEME_MLDSA65;
+    assert_eq!(
+        h.mint_message(&wire::encode_transfer(&transfer), &[0, 1]),
+        Err(BridgeError::WrongScheme)
+    );
+    assert_eq!(h.mint(&base, &[0, 1]), Ok(10 * SCALE));
+    h.assert_supply_invariant();
+}
