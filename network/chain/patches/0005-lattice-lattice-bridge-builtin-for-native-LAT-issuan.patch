+    let guardians = env.guardians.clone();
+    let attestation = env.attest(&message, &[1], &guardians);
+    env.run(
+        env.mint_ix(&attestation, 0, &recipient),
+        Err(bridge_error(BridgeError::BelowThreshold)),
+    );
+
+    let outsiders: Vec<_> = (50..53u8)
+        .map(|s| ed25519_dalek::SigningKey::from_bytes(&[s; 32]))
+        .collect();
+    let attestation = Pubkey::new_unique();
+    let len = AttestationHeader::total_len(wire::SCHEME_ED25519, message.len() as u32, 2).unwrap();
+    env.accounts
+        .insert(attestation, program_account(vec![0; len]));
+    let payer = env.payer;
+    env.run(
+        builders::init_attestation(
+            &payer,
+            &attestation,
+            wire::SCHEME_ED25519,
+            2,
+            message.len() as u32,
+        ),
+        Ok(()),
+    );
+    let digest = wire::digest(&message);
+    let mut body = message.clone();
+    for index in [0u8, 1] {
+        body.push(index);
+        body.extend_from_slice(&outsiders[usize::from(index)].sign(&digest).to_bytes());
+    }
+    env.run(
+        builders::write_attestation(&payer, &attestation, 0, body),
+        Ok(()),
+    );
+    env.run(
+        builders::verify_attestation(&attestation, &env.deployment_id, 1, 0, 2),
+        Err(bridge_error(BridgeError::InvalidSignature)),
+    );
+}
