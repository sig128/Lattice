+//! Unit tests over the pure bridge logic with real Ed25519 and ML-DSA-65
+//! signatures. `Harness` applies each operation the way the processor does:
+//! on a copy of the state that is committed (together with balances, the
+//! consumed-record set and capitalization) only if every check passes,
+//! mirroring transaction atomicity. Processor-level tests that run the
+//! actual builtin live in `processor/tests.rs` (feature
+//! `dev-context-only-utils`).
+#![allow(clippy::arithmetic_side_effects, clippy::indexing_slicing)]
+
+use {
+    crate::{
+        conversion,
+        error::BridgeError,
+        genesis::{self, BootstrapDeposit, GenesisBridgeConfig},
+        guardian, logic,
+        state::{
+            self, ATTESTATION_HEADER_LEN, ATTESTATION_OPEN, AttestationHeader, BridgeState,
+            BurnReceipt, FLAG_DEPOSITS_PAUSED, FLAG_LATTICE_GENESIS_BOUND, FLAG_WITHDRAWALS_PAUSED,
+            GuardianSet, MintRecord, NETWORK_MAINNET, NETWORK_TESTNET,
+        },
+        wire::{
+            self, GovernanceAction, GuardianKey, Header, KIND_DEPOSIT, KIND_DESTINATION_GOVERNANCE,
+            SCHEME_ED25519, SCHEME_HYBRID, SCHEME_MLDSA65, Transfer,
+        },
+    },
+    ed25519_dalek::Signer as _,
+    fips204::{
+        ml_dsa_65,
+        traits::{KeyGen, SerDes, Signer as _},
+    },
+    std::collections::{HashMap, HashSet},
+};
+
+const DEPLOYMENT_LABEL: &[u8] = b"lattice-test-1";
+const SOLANA_GENESIS: [u8; 32] = [0x11; 32];
+const LATTICE_GENESIS: [u8; 32] = [0x22; 32];
+const SOURCE_PROGRAM: [u8; 32] = [0x33; 32];
+const SOURCE_MINT: [u8; 32] = [0x44; 32];
+const DECIMALS: u8 = 6;
+const SCALE: u64 = 1_000;
+
+struct TestGuardian {
+    ed25519: Option<ed25519_dalek::SigningKey>,
+    mldsa65: Option<(Vec<u8>, ml_dsa_65::PrivateKey)>,
+}
+
+impl TestGuardian {
+    fn new(scheme: u8, seed: u8) -> Self {
+        let ed25519 = wire::scheme_has_ed25519(scheme)
+            .then(|| ed25519_dalek::SigningKey::from_bytes(&[seed; 32]));
+        let mldsa65 = wire::scheme_has_mldsa65(scheme).then(|| {
+            let (pk, sk) = ml_dsa_65::KG::keygen_from_seed(&[seed; 32]);
+            (pk.into_bytes().to_vec(), sk)
+        });
+        Self { ed25519, mldsa65 }
+    }
+
+    fn key(&self) -> GuardianKey {
+        GuardianKey {
+            ed25519: self.ed25519.as_ref().map(|k| k.verifying_key().to_bytes()),
+            mldsa65: self.mldsa65.as_ref().map(|(pk, _)| pk.clone()),
+        }
+    }
+
+    fn sign(&self, index: u8, digest: &[u8; 32]) -> Vec<u8> {
+        let mut entry = vec![index];
+        if let Some(key) = &self.ed25519 {
+            entry.extend_from_slice(&key.sign(digest).to_bytes());
+        }
+        if let Some((_, sk)) = &self.mldsa65 {
+            entry.extend_from_slice(&sk.try_sign_with_seed(&[7; 32], digest, &[]).unwrap());
+        }
+        entry
+    }
+}
+
+fn guardians(scheme: u8, count: u8, seed_base: u8) -> Vec<TestGuardian> {
+    (0..count)
+        .map(|i| TestGuardian::new(scheme, seed_base + i))
+        .collect()
+}
+
+fn guardian_set(scheme: u8, threshold: u8, epoch: u64, members: &[TestGuardian]) -> GuardianSet {
+    GuardianSet {
+        scheme,
+        threshold,
+        bump: 0,
+        epoch,
+        created_slot: 0,
+        deployment_id: wire::deployment_id(DEPLOYMENT_LABEL),
+        keys: members.iter().map(TestGuardian::key).collect(),
+    }
+}
+
+struct Harness {
+    state: BridgeState,
+    sets: HashMap<u64, GuardianSet>,
+    members: HashMap<u64, Vec<TestGuardian>>,
+    minted: HashSet<u64>,
+    balances: HashMap<[u8; 32], u64>,
+    capitalization: u128,
+    receipts: Vec<BurnReceipt>,
+    records: Vec<MintRecord>,
+    epoch: u64,
+    slot: u64,
+    compute_units: u64,
+    compute_budget: u64,
+}
+
+impl Harness {
+    fn new(scheme: u8, count: u8, threshold: u8) -> Self {
+        let members = guardians(scheme, count, 1);
+        let set = guardian_set(scheme, threshold, 1, &members);
+        let state = BridgeState {
+            deployment_id: wire::deployment_id(DEPLOYMENT_LABEL),
+            guardian_epoch: 1,
+            source_decimals: DECIMALS,
+            network: NETWORK_MAINNET,
+            solana_genesis_hash: SOLANA_GENESIS,
+            source_program_id: SOURCE_PROGRAM,
+            source_mint: SOURCE_MINT,
+            max_mint_per_epoch: u64::MAX,
+            ..BridgeState::default()
+        };
+        let mut harness = Self {
+            state,
+            sets: HashMap::from([(1, set)]),
+            members: HashMap::from([(1, members)]),
+            minted: HashSet::new(),
+            balances: HashMap::new(),
+            capitalization: 1_000_000_000_000,
+            receipts: Vec::new(),
+            records: Vec::new(),
+            epoch: 5,
+            slot: 100,
+            compute_units: 0,
+            compute_budget: u64::MAX,
+        };
+        let signers: Vec<u8> = (0..threshold).collect();
+        harness
+            .govern(
+                &harness.governance_header(LATTICE_GENESIS),
+                &GovernanceAction::BindLatticeGenesis,
+                &signers,
+            )
+            .unwrap();
+        harness
+    }
+
+    fn current_set(&self) -> &GuardianSet {
+        &self.sets[&self.state.guardian_epoch]
+    }
+
+    fn header(&self, kind: u8, nonce: u64) -> Header {
+        Header {
+            kind,
+            protocol_version: wire::PROTOCOL_VERSION,
+            scheme: self.current_set().scheme,
+            deployment_id: self.state.deployment_id,
+            solana_genesis_hash: SOLANA_GENESIS,
+            lattice_genesis_hash: self.state.lattice_genesis_hash,
+            source_program_id: SOURCE_PROGRAM,
+            source_mint: SOURCE_MINT,
+            signer_epoch: self.state.guardian_epoch,
+            nonce,
+        }
+    }
+
+    fn governance_header(&self, lattice_genesis_hash: [u8; 32]) -> Header {
+        Header {
+            lattice_genesis_hash,
+            ..self.header(KIND_DESTINATION_GOVERNANCE, self.state.governance_sequence)
+        }
+    }
+
+    fn deposit(&self, sequence: u64, source_amount: u64, recipient: [u8; 32]) -> Transfer {
+        Transfer {
+            header: self.header(KIND_DEPOSIT, sequence),
+            source_amount,
+            native_amount: source_amount * SCALE,
+            recipient,
+            event_id: wire::deposit_event_id(&self.state.deployment_id, sequence),
+        }
+    }
+
+    /// Builds attestation account bytes signed by `signers` of the set at
+    /// `epoch`, then seals and verifies every entry.
+    fn attest_with(
+        &mut self,
+        epoch: u64,
+        message: &[u8],
+        signers: &[u8],
+    ) -> Result<(AttestationHeader, Vec<u8>), BridgeError> {
+        let scheme = self.sets[&epoch].scheme;
+        let digest = wire::digest(message);
+        let mut header = AttestationHeader {
+            scheme,
+            status: ATTESTATION_OPEN,
+            signature_count: signers.len() as u8,
+            verified_bitmap: 0,
+            signer_epoch: 0,
+            digest: [0; 32],
+            writer: [9; 32],
+            message_len: message.len() as u32,
+        };
+        let mut data = vec![0u8; ATTESTATION_HEADER_LEN];
+        data.extend_from_slice(message);
+        for index in signers {
+            data.extend_from_slice(
+                &self.members[&epoch][usize::from(*index)].sign(*index, &digest),
+            );
+        }
+        header.encode_into(&mut data);
+        let set = self.sets[&epoch].clone();
+        let budget = self.compute_budget;
+        let used = &mut self.compute_units;
+        let mut meter = |units: u64| -> Result<(), BridgeError> {
+            *used += units;
+            if *used > budget {
+                Err(BridgeError::Overflow)
+            } else {
+                Ok(())
+            }
+        };
+        logic::seal_and_verify(
+            &mut header,
+            &data,
+            &self.state,
+            &set,
+            0,
+            signers.len() as u8,
+            &mut meter,
+        )?;
+        Ok((header, data))
+    }
+
+    fn mint_message(&mut self, message: &[u8], signers: &[u8]) -> Result<u64, BridgeError> {
+        let (attestation, _) = self.attest_with(self.state.guardian_epoch, message, signers)?;
+        let mut state = self.state.clone();
+        let sequence = wire::parse_header(message)?.nonce;
+        let record = logic::process_mint(
+            &mut state,
+            self.current_set(),
+            &attestation,
+            message,
+            &[9; 32],
+            self.minted.contains(&sequence),
+            self.epoch,
+            self.slot,
+        )?;
+        self.state = state;
+        self.minted.insert(record.deposit_sequence);
+        *self.balances.entry(record.recipient).or_default() += record.native_amount;
+        self.capitalization += u128::from(record.native_amount);
+        self.records.push(record.clone());
+        Ok(record.native_amount)
+    }
+
+    fn mint(&mut self, transfer: &Transfer, signers: &[u8]) -> Result<u64, BridgeError> {
+        self.mint_message(&wire::encode_transfer(transfer), signers)
+    }
+
+    fn burn(
+        &mut self,
+        burner: [u8; 32],
+        native: u64,
+        recipient: [u8; 32],
+    ) -> Result<BurnReceipt, BridgeError> {
+        let balance = self.balances.get(&burner).copied().unwrap_or(0);
+        assert!(balance >= native, "system transfer would fail");
+        let mut state = self.state.clone();
+        let receipt = logic::process_burn(&mut state, &burner, native, &recipient, self.slot)?;
+        self.state = state;
+        *self.balances.get_mut(&burner).unwrap() -= native;
+        self.capitalization -= u128::from(native);
+        self.receipts.push(receipt.clone());
+        Ok(receipt)
+    }
+
+    fn govern(
+        &mut self,
+        header: &Header,
+        action: &GovernanceAction,
+        signers: &[u8],
+    ) -> Result<(), BridgeError> {
+        let message = wire::encode_governance(header, action);
+        let (attestation, _) = self.attest_with(self.state.guardian_epoch, &message, signers)?;
+        let mut state = self.state.clone();
+        let new_set = logic::process_governance(
+            &mut state,
+            self.current_set(),
+            &attestation,
+            &message,
+            &[9; 32],
+            self.slot,
+        )?;
+        self.state = state;
+        if let Some(set) = new_set {
+            self.sets.insert(set.epoch, set);
+        }
+        Ok(())
+    }
+
+    fn rotate(
+        &mut self,
+        scheme: u8,
+        count: u8,
+        threshold: u8,
+        signers: &[u8],
+    ) -> Result<(), BridgeError> {
+        let new_epoch = self.state.guardian_epoch + 1;
+        let members = guardians(scheme, count, (new_epoch as u8) * 40);
+        let keys = members.iter().map(TestGuardian::key).collect();
+        let action = GovernanceAction::RotateGuardians {
+            new_epoch,
+            threshold,
+            scheme,
+            keys,
+        };
+        let header = self.governance_header(self.state.lattice_genesis_hash);
+        self.govern(&header, &action, signers)?;
+        self.members.insert(new_epoch, members);
+        Ok(())
+    }
+
+    fn assert_supply_invariant(&self) {
+        let circulating: u128 = self.balances.values().map(|b| u128::from(*b)).sum();
+        assert_eq!(
+            self.state.outstanding_native,
+            self.state.total_minted_native - self.state.total_burned_native
+        );
+        assert_eq!(circulating, self.state.outstanding_native);
+        assert_eq!(
+            self.capitalization,
+            1_000_000_000_000 + self.state.total_minted_native - self.state.total_burned_native
+        );
+    }
+}
+
+const ALICE: [u8; 32] = [0xA1; 32];
+const BOB: [u8; 32] = [0xB0; 32];
