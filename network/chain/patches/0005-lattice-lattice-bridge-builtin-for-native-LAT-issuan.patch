+#[test]
+fn rotation_requires_current_threshold_and_retires_old_set() {
+    let mut h = Harness::new(SCHEME_ED25519, 3, 2);
+    let pending = h.deposit(0, 10, ALICE);
+    let old_message = wire::encode_transfer(&pending);
+    let (old_attestation, _) = h.attest_with(1, &old_message, &[0, 1]).unwrap();
+
+    assert_eq!(
+        h.rotate(SCHEME_ED25519, 4, 3, &[0]),
+        Err(BridgeError::BelowThreshold)
+    );
+    h.rotate(SCHEME_ED25519, 4, 3, &[1, 2]).unwrap();
+    assert_eq!(h.state.guardian_epoch, 2);
+    assert_eq!(h.sets[&2].threshold, 3);
+
+    // A threshold attestation made under epoch 1 is no longer accepted.
+    let mut state = h.state.clone();
+    assert_eq!(
+        logic::process_mint(
+            &mut state,
+            h.current_set(),
+            &old_attestation,
+            &old_message,
+            &[9; 32],
+            false,
+            h.epoch,
+            h.slot
+        ),
+        Err(BridgeError::WrongSignerEpoch)
+    );
+    // Old guardians cannot sign for the new epoch.
+    let resigned = h.deposit(0, 10, ALICE);
+    let message = wire::encode_transfer(&resigned);
+    let old_set = h.sets[&1].clone();
+    let digest = wire::digest(&message);
+    let entry = h.members[&1][0].sign(0, &digest);
+    let mut meter = |_| Ok::<(), BridgeError>(());
+    assert_eq!(
+        guardian::verify_entries::<BridgeError, _>(
+            h.current_set(),
+            &digest,
+            &entry,
+            0,
+            1,
+            &mut meter
+        ),
+        Err(BridgeError::InvalidSignature)
+    );
+    assert!(
+        guardian::verify_entries::<BridgeError, _>(&old_set, &digest, &entry, 0, 1, &mut meter)
+            .is_ok()
+    );
+    // The new set mints the re-signed deposit.
+    assert_eq!(h.mint(&resigned, &[0, 1, 3]), Ok(10 * SCALE));
+    // Rotation must go to exactly current + 1, and governance nonces are single-use.
+    let header = h.governance_header(LATTICE_GENESIS);
+    let bad = GovernanceAction::RotateGuardians {
+        new_epoch: 9,
+        threshold: 2,
+        scheme: SCHEME_ED25519,
+        keys: h.sets[&2].keys[..3].to_vec(),
+    };
+    assert_eq!(
+        h.govern(&header, &bad, &[0, 1, 2]),
+        Err(BridgeError::WrongNewEpoch)
+    );
+    let stale = Header { nonce: 0, ..header };
+    assert_eq!(
+        h.govern(
+            &stale,
+            &GovernanceAction::SetLimits {
+                max_mint_per_epoch: 1
+            },
+            &[0, 1, 2]
+        ),
+        Err(BridgeError::WrongNonce)
+    );
+    // An invalid new set (threshold not a strict majority) is rejected.
+    assert_eq!(
+        h.rotate(SCHEME_ED25519, 4, 2, &[0, 1, 2]),
+        Err(BridgeError::InvalidGuardianSet)
+    );
+}
