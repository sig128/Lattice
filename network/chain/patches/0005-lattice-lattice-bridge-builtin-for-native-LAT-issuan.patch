+        put(&mut d, 0, MINT_RECORD_MAGIC);
+        put(&mut d, 8, &[LAYOUT_VERSION]);
+        put(&mut d, 9, &self.deployment_id);
+        put(&mut d, 41, &self.deposit_sequence.to_le_bytes());
+        put(&mut d, 49, &self.recipient);
+        put(&mut d, 81, &self.native_amount.to_le_bytes());
+        put(&mut d, 89, &self.slot.to_le_bytes());
+        put(&mut d, 97, &self.event_id);
