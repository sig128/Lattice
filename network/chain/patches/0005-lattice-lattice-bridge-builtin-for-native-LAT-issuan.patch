diff --git a/programs/lattice-bridge/src/conversion.rs b/programs/lattice-bridge/src/conversion.rs
new file mode 100644
index 000000000..f2861d4a9
--- /dev/null
+++ b/programs/lattice-bridge/src/conversion.rs
@@ -0,0 +1,85 @@
+//! Decimal conversion between the Solana source token and native LAT
+//! (BRIDGE_SPEC §1).
+//!
+//! LAT has 9 decimals. The source mint has `source_decimals <= 9`, so
+//! `SCALE = 10^(9 - source_decimals)` and the mapping is exact in both
+//! directions: deposits multiply (no dust) and burns must be a multiple of
+//! `SCALE` (otherwise rejected, never rounded).
+
+use crate::error::{BridgeError, BridgeResult};
+
+pub const NATIVE_DECIMALS: u8 = 9;
+
+pub fn scale(source_decimals: u8) -> BridgeResult<u64> {
+    let exponent = NATIVE_DECIMALS
+        .checked_sub(source_decimals)
+        .ok_or(BridgeError::UnsupportedDecimals)?;
+    10u64
+        .checked_pow(u32::from(exponent))
+        .ok_or(BridgeError::UnsupportedDecimals)
+}
+
+/// Native lamports credited for a deposit of `source_amount` atomic units.
+pub fn source_to_native(source_amount: u64, source_decimals: u8) -> BridgeResult<u64> {
+    if source_amount == 0 {
+        return Err(BridgeError::ZeroAmount);
+    }
+    source_amount
+        .checked_mul(scale(source_decimals)?)
+        .ok_or(BridgeError::Overflow)
+}
+
+/// Source atomic units released for a burn of `native_amount` lamports.
+pub fn native_to_source(native_amount: u64, source_decimals: u8) -> BridgeResult<u64> {
+    if native_amount == 0 {
+        return Err(BridgeError::ZeroAmount);
+    }
+    let scale = scale(source_decimals)?;
+    if native_amount.checked_rem(scale) != Some(0) {
+        return Err(BridgeError::NotMultipleOfScale);
+    }
+    native_amount
+        .checked_div(scale)
+        .ok_or(BridgeError::UnsupportedDecimals)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn scale_matches_spec() {
+        assert_eq!(scale(9), Ok(1));
+        assert_eq!(scale(6), Ok(1_000));
+        assert_eq!(scale(0), Ok(1_000_000_000));
+        assert_eq!(scale(10), Err(BridgeError::UnsupportedDecimals));
+    }
+
+    #[test]
+    fn deposit_multiplies_exactly() {
+        assert_eq!(source_to_native(1_500_000, 6), Ok(1_500_000_000));
+        assert_eq!(source_to_native(7, 9), Ok(7));
+        assert_eq!(source_to_native(0, 6), Err(BridgeError::ZeroAmount));
+        assert_eq!(source_to_native(u64::MAX, 6), Err(BridgeError::Overflow));
+        assert_eq!(source_to_native(u64::MAX, 9), Ok(u64::MAX));
+    }
+
+    #[test]
+    fn burn_requires_multiple_of_scale() {
+        assert_eq!(native_to_source(1_500_000_000, 6), Ok(1_500_000));
+        assert_eq!(
+            native_to_source(1_500_000_001, 6),
+            Err(BridgeError::NotMultipleOfScale)
+        );
+        assert_eq!(native_to_source(0, 6), Err(BridgeError::ZeroAmount));
+        assert_eq!(native_to_source(5, 9), Ok(5));
+    }
+
+    #[test]
+    fn round_trip_is_identity() {
+        for decimals in 0..=9u8 {
+            let native = source_to_native(12_345, decimals).unwrap();
+            assert_eq!(native_to_source(native, decimals), Ok(12_345));
+        }
+    }
+}
