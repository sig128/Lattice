+            burner: a32(d, 49)?,
+            native_amount: u64_at(d, 81)?,
+            source_amount: u64_at(d, 89)?,
+            solana_recipient: a32(d, 97)?,
+            slot: u64_at(d, 129)?,
+            event_id: a32(d, 137)?,
+        })
+    }
+}
+
+pub const ATTESTATION_OPEN: u8 = 1;
+pub const ATTESTATION_SEALED: u8 = 2;
+
+/// Staging account (keypair address, created by the relayer with this
+/// program as owner) holding one message plus guardian signatures:
+/// `header(96) || message(message_len) || signature_count × entry`.
+/// Entry = `guardian_index u8 || [ed25519 sig 64] || [ML-DSA-65 sig 3309]`.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct AttestationHeader {
+    pub scheme: u8,
+    pub status: u8,
+    pub signature_count: u8,
+    pub verified_bitmap: u32,
+    pub signer_epoch: u64,
+    pub digest: [u8; 32],
+    pub writer: [u8; 32],
+    pub message_len: u32,
+}
+
+impl AttestationHeader {
+    pub fn total_len(scheme: u8, message_len: u32, signature_count: u8) -> BridgeResult<usize> {
+        signature_entry_len(scheme)?
+            .checked_mul(usize::from(signature_count))
+            .and_then(|sigs| sigs.checked_add(usize::try_from(message_len).ok()?))
+            .and_then(|body| body.checked_add(ATTESTATION_HEADER_LEN))
+            .ok_or(BridgeError::Overflow)
+    }
+
+    pub fn encode_into(&self, d: &mut [u8]) {
+        put(d, 0, ATTESTATION_MAGIC);
+        put(
+            d,
+            8,
+            &[
+                LAYOUT_VERSION,
+                self.scheme,
+                self.status,
+                self.signature_count,
+            ],
+        );
+        put(d, 12, &self.verified_bitmap.to_le_bytes());
+        put(d, 16, &self.signer_epoch.to_le_bytes());
+        put(d, 24, &self.digest);
+        put(d, 56, &self.writer);
+        put(d, 88, &self.message_len.to_le_bytes());
+    }
+
+    pub fn decode(d: &[u8]) -> BridgeResult<Self> {
+        check_magic(d, ATTESTATION_MAGIC, BridgeError::InvalidAttestationAccount)?;
+        let header = Self {
+            scheme: u8_at(d, 9)?,
+            status: u8_at(d, 10)?,
+            signature_count: u8_at(d, 11)?,
+            verified_bitmap: u32_at(d, 12)?,
+            signer_epoch: u64_at(d, 16)?,
+            digest: a32(d, 24)?,
+            writer: a32(d, 56)?,
+            message_len: u32_at(d, 88)?,
+        };
+        if d.len() != Self::total_len(header.scheme, header.message_len, header.signature_count)? {
+            return Err(BridgeError::InvalidAttestationAccount);
+        }
+        Ok(header)
+    }
+
+    pub fn message<'a>(&self, d: &'a [u8]) -> BridgeResult<&'a [u8]> {
+        let end = ATTESTATION_HEADER_LEN
+            .checked_add(self.message_len as usize)
+            .ok_or(BridgeError::Overflow)?;
+        d.get(ATTESTATION_HEADER_LEN..end)
+            .ok_or(BridgeError::InvalidAttestationAccount)
+    }
+
+    pub fn signatures<'a>(&self, d: &'a [u8]) -> BridgeResult<&'a [u8]> {
+        let start = ATTESTATION_HEADER_LEN
+            .checked_add(self.message_len as usize)
+            .ok_or(BridgeError::Overflow)?;
+        d.get(start..).ok_or(BridgeError::InvalidAttestationAccount)
+    }
+}
+
+pub fn signature_entry_len(scheme: u8) -> BridgeResult<usize> {
+    let mut len = 1usize;
+    if wire::scheme_has_ed25519(scheme) {
+        len = len.saturating_add(64);
+    }
+    if wire::scheme_has_mldsa65(scheme) {
+        len = len.saturating_add(agave_mldsa_verify::MLDSA65_SIGNATURE_LEN);
+    }
+    wire::key_entry_len(scheme)?;
+    Ok(len)
+}
+
+pub fn state_address(program_id: &Pubkey, deployment_id: &[u8; 32]) -> (Pubkey, u8) {
+    Pubkey::find_program_address(&[SEED_STATE, deployment_id], program_id)
+}
+
+pub fn guardian_set_address(
+    program_id: &Pubkey,
+    deployment_id: &[u8; 32],
+    epoch: u64,
+) -> (Pubkey, u8) {
+    Pubkey::find_program_address(
+        &[SEED_GUARDIAN_SET, deployment_id, &epoch.to_le_bytes()],
+        program_id,
