+//! Error codes returned as `InstructionError::Custom(code)`.
+
+/// Stable error codes. Never renumber; append only.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+#[repr(u32)]
+pub enum BridgeError {
+    // Wire / encoding
+    MalformedMessage = 1,
+    WrongDomain = 2,
+    WrongKind = 3,
+    WrongProtocolVersion = 4,
+    WrongScheme = 5,
+    WrongDeployment = 6,
+    WrongSolanaGenesis = 7,
+    WrongLatticeGenesis = 8,
+    WrongSourceProgram = 9,
+    WrongSourceMint = 10,
+    WrongSignerEpoch = 11,
+    WrongEventId = 12,
+    WrongNonce = 13,
+    ZeroRecipient = 14,
+    // Amounts
+    ZeroAmount = 20,
+    AmountMismatch = 21,
+    NotMultipleOfScale = 22,
+    UnsupportedDecimals = 23,
+    Overflow = 24,
+    MintRateLimitExceeded = 25,
+    BurnExceedsOutstanding = 26,
+    // State
+    DepositsPaused = 30,
+    WithdrawalsPaused = 31,
+    LatticeGenesisNotBound = 32,
+    LatticeGenesisAlreadyBound = 33,
+    DepositAlreadyMinted = 34,
+    InvalidStateAccount = 35,
+    InvalidGuardianSetAccount = 36,
+    InvalidAttestationAccount = 37,
+    InvalidRecordAccount = 38,
+    NotPauser = 39,
+    UnpauseNotAllowed = 40,
+    InvalidRecipientAccount = 41,
+    // Guardians / signatures
+    InvalidGuardianSet = 50,
+    InvalidGuardianIndex = 51,
+    InvalidSignature = 52,
+    BelowThreshold = 53,
+    AttestationSealed = 54,
+    AttestationNotSealed = 55,
+    AttestationWriter = 56,
+    AttestationOutOfBounds = 57,
+    UnknownGovernanceAction = 58,
+    WrongNewEpoch = 59,
+}
+
+impl From<BridgeError> for u32 {
+    fn from(error: BridgeError) -> u32 {
+        error as u32
+    }
+}
+
+pub type BridgeResult<T> = Result<T, BridgeError>;
diff --git a/programs/lattice-bridge/src/genesis.rs b/programs/lattice-bridge/src/genesis.rs
new file mode 100644
index 000000000..801c42691
--- /dev/null
+++ b/programs/lattice-bridge/src/genesis.rs
@@ -0,0 +1,204 @@
+//! Genesis accounts for a Lattice bridge deployment and the genesis supply
+//! report used by `solana-genesis --lattice-network`.
+//!
+//! Supply model (docs/NATIVE_ISSUANCE.md §Genesis):
+//! - Lattice mainnet issues no unbacked lamports. Every lamport in genesis
+//!   (validator identity/vote/stake accounts, bridge accounts, programs,
+//!   sysvar-adjacent genesis accounts) plus a reserve for the balances the
+//!   runtime itself creates at slot 0 (sysvars, builtin program accounts)
+//!   must be covered by *bootstrap deposits*: ordinary source-vault deposits
+//!   finalized on Solana before launch.
+//! - Each bootstrap deposit becomes a pre-consumed `LATMINT1` record in
+//!   genesis, so the relayer can never mint it again, and is counted in
+//!   `total_minted_native`. The LAT it backs is the genesis allocation.
+//! - Testnet/development genesis may contain unbacked lamports (faucet). The
+//!   amount is written to `genesis_unbacked_native` and labelled as such.
+
+use {
+    crate::{
+        conversion,
+        error::BridgeError,
+        state::{
+            self, BridgeState, GuardianSet, MINT_RECORD_LEN, MintRecord, NETWORK_DEVELOPMENT,
+            NETWORK_MAINNET, NETWORK_TESTNET, STATE_LEN,
+        },
+        wire,
+    },
+    solana_pubkey::Pubkey,
+};
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct BootstrapDeposit {
+    /// Source-vault `deposit_sequence` of a deposit finalized before launch.
+    pub sequence: u64,
+    /// Credited source atomic units of that deposit receipt.
+    pub source_amount: u64,
+    /// Lattice recipient recorded in the Solana deposit receipt.
+    pub recipient: [u8; 32],
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct GenesisBridgeConfig {
+    pub network: u8,
+    pub deployment_id: [u8; 32],
+    pub solana_genesis_hash: [u8; 32],
+    pub source_program_id: [u8; 32],
+    pub source_mint: [u8; 32],
+    pub source_decimals: u8,
+    /// Initial Lattice guardian registry (epoch 1 per BRIDGE_SPEC §4).
+    pub guardian_set: GuardianSet,
+    pub pauser: [u8; 32],
+    pub max_mint_per_epoch: u64,
+    pub bootstrap_deposits: Vec<BootstrapDeposit>,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct GenesisBridgeAccount {
+    pub address: Pubkey,
+    pub lamports: u64,
+    pub data: Vec<u8>,
+}
+
+#[derive(Clone, Debug, Default, PartialEq, Eq)]
+pub struct GenesisSupplyReport {
+    /// LAT backed by bootstrap deposits (sum of their native amounts).
+    pub backed_native: u64,
+    /// Lamports held by the bridge's own genesis accounts.
+    pub bridge_account_lamports: u64,
+    /// All genesis account lamports, including the bridge accounts.
+    pub genesis_account_lamports: u64,
+    /// Allowance for balances created by the runtime at slot 0.
+    pub runtime_reserve_lamports: u64,
+    /// `genesis_account_lamports + runtime_reserve - backed`, floored at 0.
+    pub unbacked_native: u64,
+}
+
+fn err(e: BridgeError, what: &str) -> String {
+    format!("{what}: {e:?}")
+}
+
+/// Builds the state, initial guardian set and pre-consumed mint records.
+/// `other_genesis_lamports` is the sum over every non-bridge genesis account.
+pub fn build_genesis_accounts(
+    config: &GenesisBridgeConfig,
+    program_id: &Pubkey,
+    other_genesis_lamports: u64,
+    runtime_reserve_lamports: u64,
+    rent_exempt_minimum: impl Fn(usize) -> u64,
+) -> Result<(Vec<GenesisBridgeAccount>, GenesisSupplyReport), String> {
+    if ![NETWORK_MAINNET, NETWORK_TESTNET, NETWORK_DEVELOPMENT].contains(&config.network) {
+        return Err(format!("unknown network {}", config.network));
+    }
+    conversion::scale(config.source_decimals).map_err(|e| err(e, "source_decimals"))?;
+    let mut set = config.guardian_set.clone();
+    set.deployment_id = config.deployment_id;
+    set.validate().map_err(|e| err(e, "guardian set"))?;
+    if set.epoch == 0 {
+        return Err("guardian set epoch must be >= 1".to_string());
+    }
+
+    let mut accounts = Vec::new();
+    let mut backed_native = 0u64;
+    let mut sequences = std::collections::BTreeSet::new();
+    for deposit in &config.bootstrap_deposits {
+        if !sequences.insert(deposit.sequence) {
+            return Err(format!(
+                "duplicate bootstrap deposit sequence {}",
+                deposit.sequence
+            ));
+        }
+        if deposit.recipient == [0; 32] {
+            return Err(format!(
+                "bootstrap deposit {} has a zero recipient",
+                deposit.sequence
+            ));
+        }
+        let native = conversion::source_to_native(deposit.source_amount, config.source_decimals)
+            .map_err(|e| err(e, "bootstrap deposit amount"))?;
+        backed_native = backed_native
+            .checked_add(native)
+            .ok_or("bootstrap total overflows u64")?;
+        let (address, _) =
+            state::mint_record_address(program_id, &config.deployment_id, deposit.sequence);
+        let record = MintRecord {
+            deployment_id: config.deployment_id,
+            deposit_sequence: deposit.sequence,
+            recipient: deposit.recipient,
+            native_amount: native,
+            slot: 0,
+            event_id: wire::deposit_event_id(&config.deployment_id, deposit.sequence),
+        };
+        accounts.push(GenesisBridgeAccount {
+            address,
+            lamports: rent_exempt_minimum(MINT_RECORD_LEN),
+            data: record.encode(),
+        });
+    }
+
+    let (set_address, set_bump) =
+        state::guardian_set_address(program_id, &config.deployment_id, set.epoch);
+    set.bump = set_bump;
+    let set_data = set.encode().map_err(|e| err(e, "guardian set"))?;
+    accounts.push(GenesisBridgeAccount {
+        address: set_address,
+        lamports: rent_exempt_minimum(set_data.len()),
+        data: set_data,
+    });
+
+    let (state_address, state_bump) = state::state_address(program_id, &config.deployment_id);
+    let state_lamports = rent_exempt_minimum(STATE_LEN);
+    let bridge_account_lamports = accounts
+        .iter()
+        .map(|account| account.lamports)
+        .try_fold(state_lamports, u64::checked_add)
+        .ok_or("bridge account lamports overflow")?;
+    let genesis_account_lamports = other_genesis_lamports
+        .checked_add(bridge_account_lamports)
+        .ok_or("genesis lamports overflow")?;
+    let required = genesis_account_lamports
+        .checked_add(runtime_reserve_lamports)
+        .ok_or("genesis lamports overflow")?;
+    let unbacked_native = required.saturating_sub(backed_native);
+    if config.network == NETWORK_MAINNET && unbacked_native != 0 {
+        return Err(format!(
+            "Lattice mainnet genesis would issue {unbacked_native} unbacked lamports: genesis \
+             accounts {genesis_account_lamports} + runtime reserve {runtime_reserve_lamports} \
+             exceed bootstrap deposits {backed_native}"
+        ));
+    }
+
+    let bridge_state = BridgeState {
+        deployment_id: config.deployment_id,
+        minted_count: config.bootstrap_deposits.len() as u64,
+        total_minted_native: u128::from(backed_native),
+        guardian_epoch: set.epoch,
+        bump: state_bump,
+        source_decimals: config.source_decimals,
+        network: config.network,
+        solana_genesis_hash: config.solana_genesis_hash,
+        source_program_id: config.source_program_id,
+        source_mint: config.source_mint,
+        pauser: config.pauser,
+        max_mint_per_epoch: config.max_mint_per_epoch,
+        genesis_bootstrap_native: backed_native,
+        genesis_unbacked_native: unbacked_native,
+        outstanding_native: u128::from(backed_native),
+        ..BridgeState::default()
+    };
+    accounts.push(GenesisBridgeAccount {
+        address: state_address,
+        lamports: state_lamports,
+        data: bridge_state.encode(),
+    });
+
+    Ok((
+        accounts,
+        GenesisSupplyReport {
+            backed_native,
+            bridge_account_lamports,
+            genesis_account_lamports,
+            runtime_reserve_lamports,
+            unbacked_native,
+        },
+    ))
+}
diff --git a/programs/lattice-bridge/src/guardian.rs b/programs/lattice-bridge/src/guardian.rs
new file mode 100644
index 000000000..2e924a6f8
--- /dev/null
+++ b/programs/lattice-bridge/src/guardian.rs
@@ -0,0 +1,120 @@
+//! Guardian signature verification under the scheme declared by the
+//! guardian set (BRIDGE_SPEC §3.3):
+//!
+//! - scheme 1: Ed25519 (`verify_strict`, as the ed25519 precompile) over
+//!   `SHA-256(message)`;
+//! - scheme 2: ML-DSA-65 (FIPS 204 pure, empty context) over the same digest,
+//!   via `agave-mldsa-verify` (the verifier behind `sol_mldsa65_verify`);
+//! - scheme 3 (hybrid): the same guardian index must provide BOTH, and both
+//!   must verify, for that guardian to count once toward the threshold.
+//!
+//! Every provided entry must verify; one bad entry fails the instruction.
+//! Compute units are charged before each individual verification.
+
+use {
+    crate::{
+        error::BridgeError,
+        state::{GuardianSet, signature_entry_len},
+        wire,
+    },
+    agave_mldsa_verify::{MLDSA65_SIGNATURE_LEN, MLDSA65_VERSION_V1},
+};
+
+/// Calibrated by ratio to the fork's ML-DSA-65 calibration (108.7 µs ->
+/// 30,000 CU, see docs/QUANTUM.md): ed25519-dalek `verify_strict` is roughly
+/// 40-45 µs on the same class of host. Re-measure on validator hardware.
+pub const ED25519_VERIFY_COST: u64 = 12_000;
+
+pub fn mldsa65_verify_cost() -> u64 {
+    agave_mldsa_verify::verify_cost(32)
+}
+
+pub fn verify_ed25519(public_key: &[u8; 32], digest: &[u8; 32], signature: &[u8]) -> bool {
+    let Ok(signature) = <[u8; 64]>::try_from(signature) else {
+        return false;
+    };
+    let Ok(key) = ed25519_dalek::VerifyingKey::from_bytes(public_key) else {
+        return false;
+    };
+    key.verify_strict(digest, &ed25519_dalek::Signature::from_bytes(&signature))
+        .is_ok()
+}
+
+pub fn verify_mldsa65(public_key: &[u8], digest: &[u8; 32], signature: &[u8]) -> bool {
+    agave_mldsa_verify::verify(MLDSA65_VERSION_V1, public_key, digest, signature).is_ok()
+}
+
+/// Verifies signature entries `[first, first + count)` of `signatures`
+/// against `set` and returns the bitmap of guardian indices they prove.
+pub fn verify_entries<E, F>(
+    set: &GuardianSet,
+    digest: &[u8; 32],
+    signatures: &[u8],
+    first: usize,
+    count: usize,
+    charge: &mut F,
+) -> Result<u32, E>
+where
+    E: From<BridgeError>,
+    F: FnMut(u64) -> Result<(), E>,
+{
+    let entry_len = signature_entry_len(set.scheme)?;
+    let end = first
+        .checked_add(count)
+        .and_then(|end| end.checked_mul(entry_len))
+        .ok_or(BridgeError::AttestationOutOfBounds)?;
+    let start = first
+        .checked_mul(entry_len)
+        .ok_or(BridgeError::AttestationOutOfBounds)?;
+    let entries = signatures
+        .get(start..end)
+        .ok_or(BridgeError::AttestationOutOfBounds)?;
+    let mut bitmap = 0u32;
+    for entry in entries.chunks_exact(entry_len) {
+        let (index, mut rest) = entry.split_first().ok_or(BridgeError::MalformedMessage)?;
+        let key = set
+            .keys
+            .get(usize::from(*index))
+            .ok_or(BridgeError::InvalidGuardianIndex)?;
+        if wire::scheme_has_ed25519(set.scheme) {
+            let (signature, tail) = rest
+                .split_at_checked(64)
+                .ok_or(BridgeError::MalformedMessage)?;
+            rest = tail;
+            charge(ED25519_VERIFY_COST)?;
+            let public_key = key
+                .ed25519
+                .as_ref()
+                .ok_or(BridgeError::InvalidGuardianSet)?;
+            if !verify_ed25519(public_key, digest, signature) {
+                return Err(BridgeError::InvalidSignature.into());
+            }
+        }
+        if wire::scheme_has_mldsa65(set.scheme) {
+            let signature = rest
+                .get(..MLDSA65_SIGNATURE_LEN)
+                .ok_or(BridgeError::MalformedMessage)?;
+            charge(mldsa65_verify_cost())?;
+            let public_key = key
+                .mldsa65
+                .as_ref()
+                .ok_or(BridgeError::InvalidGuardianSet)?;
+            if !verify_mldsa65(public_key, digest, signature) {
+                return Err(BridgeError::InvalidSignature.into());
+            }
+        }
+        bitmap |= 1u32
+            .checked_shl(u32::from(*index))
+            .ok_or(BridgeError::InvalidGuardianIndex)?;
+    }
+    Ok(bitmap)
+}
+
+/// Number of distinct guardians proven by `bitmap` within a set of `count`.
+pub fn signers(bitmap: u32, count: usize) -> u32 {
+    let mask = 1u32
+        .checked_shl(u32::try_from(count).unwrap_or(32))
+        .map(|bit| bit.wrapping_sub(1))
+        .unwrap_or(u32::MAX);
+    (bitmap & mask).count_ones()
+}
diff --git a/programs/lattice-bridge/src/instruction.rs b/programs/lattice-bridge/src/instruction.rs
new file mode 100644
index 000000000..d8ed4c11f
--- /dev/null
+++ b/programs/lattice-bridge/src/instruction.rs
@@ -0,0 +1,329 @@
+//! Instruction encoding: a 1-byte tag followed by fixed little-endian fields.
+//! Account lists are documented on each variant and in docs/NATIVE_ISSUANCE.md.
+
+use crate::{
+    error::{BridgeError, BridgeResult},
+    wire::{a32, u8_at, u64_at},
+};
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum BridgeInstruction {
+    /// `[writer (signer), attestation (writable, owned by this program, zeroed)]`
+    InitAttestation {
+        scheme: u8,
+        signature_count: u8,
+        message_len: u32,
+    },
+    /// `[writer (signer), attestation (writable)]`; `offset` is relative to
+    /// the start of the message area. Rejected once sealed.
+    WriteAttestation { offset: u32, data: Vec<u8> },
+    /// `[attestation (writable), state, guardian set (current epoch)]`
+    VerifyAttestation { first: u8, count: u8 },
+    /// `[writer (signer, writable), attestation (writable)]`
+    CloseAttestation,
+    /// `[payer = attestation writer (signer, writable), state (writable),
+    ///   guardian set, attestation (writable), mint record PDA (writable),
+    ///   recipient (writable), system program]`
+    MintFromDeposit,
+    /// `[burner (signer, writable), state (writable),
+    ///   burn receipt PDA (writable), system program]`
+    BurnForWithdrawal {
+        native_amount: u64,
+        solana_recipient: [u8; 32],
+    },
+    /// `[payer = attestation writer (signer, writable), state (writable),
+    ///   guardian set, attestation (writable), system program,
+    ///   new guardian set PDA (writable; RotateGuardians only)]`
+    Govern,
+    /// `[pauser (signer), state (writable)]`; 1 = pause, 0 = leave unchanged.
+    Pause { deposits: u8, withdrawals: u8 },
+}
+
+pub const TAG_INIT_ATTESTATION: u8 = 0;
+pub const TAG_WRITE_ATTESTATION: u8 = 1;
+pub const TAG_VERIFY_ATTESTATION: u8 = 2;
+pub const TAG_CLOSE_ATTESTATION: u8 = 3;
+pub const TAG_MINT_FROM_DEPOSIT: u8 = 4;
+pub const TAG_BURN_FOR_WITHDRAWAL: u8 = 5;
+pub const TAG_GOVERN: u8 = 6;
+pub const TAG_PAUSE: u8 = 7;
+
+fn u32_at(d: &[u8], o: usize) -> BridgeResult<u32> {
+    d.get(o..o.saturating_add(4))
+        .and_then(|s| <[u8; 4]>::try_from(s).ok())
+        .map(u32::from_le_bytes)
+        .ok_or(BridgeError::MalformedMessage)
+}
+
+impl BridgeInstruction {
+    pub fn encode(&self) -> Vec<u8> {
+        let mut out = Vec::new();
+        match self {
+            Self::InitAttestation {
+                scheme,
+                signature_count,
+                message_len,
+            } => {
+                out.extend_from_slice(&[TAG_INIT_ATTESTATION, *scheme, *signature_count]);
+                out.extend_from_slice(&message_len.to_le_bytes());
+            }
+            Self::WriteAttestation { offset, data } => {
+                out.push(TAG_WRITE_ATTESTATION);
+                out.extend_from_slice(&offset.to_le_bytes());
+                out.extend_from_slice(data);
+            }
+            Self::VerifyAttestation { first, count } => {
+                out.extend_from_slice(&[TAG_VERIFY_ATTESTATION, *first, *count]);
+            }
+            Self::CloseAttestation => out.push(TAG_CLOSE_ATTESTATION),
+            Self::MintFromDeposit => out.push(TAG_MINT_FROM_DEPOSIT),
+            Self::BurnForWithdrawal {
+                native_amount,
+                solana_recipient,
+            } => {
+                out.push(TAG_BURN_FOR_WITHDRAWAL);
+                out.extend_from_slice(&native_amount.to_le_bytes());
+                out.extend_from_slice(solana_recipient);
+            }
+            Self::Govern => out.push(TAG_GOVERN),
+            Self::Pause {
+                deposits,
+                withdrawals,
+            } => out.extend_from_slice(&[TAG_PAUSE, *deposits, *withdrawals]),
+        }
+        out
+    }
+
+    pub fn decode(d: &[u8]) -> BridgeResult<Self> {
+        let exact = |len: usize, value: Self| {
+            if d.len() == len {
+                Ok(value)
+            } else {
+                Err(BridgeError::MalformedMessage)
+            }
+        };
+        match u8_at(d, 0)? {
+            TAG_INIT_ATTESTATION => exact(
+                7,
+                Self::InitAttestation {
+                    scheme: u8_at(d, 1)?,
+                    signature_count: u8_at(d, 2)?,
+                    message_len: u32_at(d, 3)?,
+                },
+            ),
+            TAG_WRITE_ATTESTATION => Ok(Self::WriteAttestation {
+                offset: u32_at(d, 1)?,
+                data: d.get(5..).ok_or(BridgeError::MalformedMessage)?.to_vec(),
+            }),
+            TAG_VERIFY_ATTESTATION => exact(
+                3,
+                Self::VerifyAttestation {
+                    first: u8_at(d, 1)?,
+                    count: u8_at(d, 2)?,
+                },
+            ),
+            TAG_CLOSE_ATTESTATION => exact(1, Self::CloseAttestation),
+            TAG_MINT_FROM_DEPOSIT => exact(1, Self::MintFromDeposit),
+            TAG_BURN_FOR_WITHDRAWAL => exact(
+                41,
+                Self::BurnForWithdrawal {
+                    native_amount: u64_at(d, 1)?,
+                    solana_recipient: a32(d, 9)?,
+                },
+            ),
+            TAG_GOVERN => exact(1, Self::Govern),
+            TAG_PAUSE => exact(
+                3,
+                Self::Pause {
+                    deposits: u8_at(d, 1)?,
+                    withdrawals: u8_at(d, 2)?,
+                },
+            ),
+            _ => Err(BridgeError::MalformedMessage),
+        }
+    }
+}
+
+#[cfg(feature = "agave-unstable-api")]
+pub mod builders {
+    //! Client-side instruction builders.
+    use {
+        super::BridgeInstruction,
+        crate::state,
+        solana_instruction::{AccountMeta, Instruction},
+        solana_pubkey::Pubkey,
+    };
+
+    fn ix(data: BridgeInstruction, accounts: Vec<AccountMeta>) -> Instruction {
+        Instruction::new_with_bytes(crate::id(), &data.encode(), accounts)
+    }
+
+    pub fn init_attestation(
+        writer: &Pubkey,
+        attestation: &Pubkey,
+        scheme: u8,
+        signature_count: u8,
+        message_len: u32,
+    ) -> Instruction {
+        ix(
+            BridgeInstruction::InitAttestation {
+                scheme,
+                signature_count,
+                message_len,
+            },
+            vec![
+                AccountMeta::new_readonly(*writer, true),
+                AccountMeta::new(*attestation, false),
+            ],
+        )
+    }
+
+    pub fn write_attestation(
+        writer: &Pubkey,
+        attestation: &Pubkey,
+        offset: u32,
+        data: Vec<u8>,
+    ) -> Instruction {
+        ix(
+            BridgeInstruction::WriteAttestation { offset, data },
+            vec![
+                AccountMeta::new_readonly(*writer, true),
+                AccountMeta::new(*attestation, false),
+            ],
+        )
+    }
+
+    pub fn verify_attestation(
+        attestation: &Pubkey,
+        deployment_id: &[u8; 32],
+        epoch: u64,
+        first: u8,
+        count: u8,
+    ) -> Instruction {
+        let program_id = crate::id();
+        ix(
+            BridgeInstruction::VerifyAttestation { first, count },
+            vec![
+                AccountMeta::new(*attestation, false),
+                AccountMeta::new_readonly(
+                    state::state_address(&program_id, deployment_id).0,
+                    false,
+                ),
+                AccountMeta::new_readonly(
+                    state::guardian_set_address(&program_id, deployment_id, epoch).0,
+                    false,
+                ),
+            ],
+        )
+    }
+
+    pub fn close_attestation(writer: &Pubkey, attestation: &Pubkey) -> Instruction {
+        ix(
+            BridgeInstruction::CloseAttestation,
+            vec![
+                AccountMeta::new(*writer, true),
+                AccountMeta::new(*attestation, false),
+            ],
+        )
+    }
+
+    pub fn mint_from_deposit(
+        payer: &Pubkey,
+        attestation: &Pubkey,
+        deployment_id: &[u8; 32],
+        epoch: u64,
+        deposit_sequence: u64,
+        recipient: &Pubkey,
+    ) -> Instruction {
+        let program_id = crate::id();
+        ix(
+            BridgeInstruction::MintFromDeposit,
+            vec![
+                AccountMeta::new(*payer, true),
+                AccountMeta::new(state::state_address(&program_id, deployment_id).0, false),
+                AccountMeta::new_readonly(
+                    state::guardian_set_address(&program_id, deployment_id, epoch).0,
+                    false,
+                ),
+                AccountMeta::new(*attestation, false),
+                AccountMeta::new(
+                    state::mint_record_address(&program_id, deployment_id, deposit_sequence).0,
+                    false,
+                ),
+                AccountMeta::new(*recipient, false),
+                AccountMeta::new_readonly(solana_sdk_ids::system_program::id(), false),
+            ],
+        )
+    }
+
+    pub fn burn_for_withdrawal(
+        burner: &Pubkey,
+        deployment_id: &[u8; 32],
+        burn_sequence: u64,
+        native_amount: u64,
+        solana_recipient: [u8; 32],
+    ) -> Instruction {
+        let program_id = crate::id();
+        ix(
+            BridgeInstruction::BurnForWithdrawal {
+                native_amount,
+                solana_recipient,
+            },
+            vec![
+                AccountMeta::new(*burner, true),
+                AccountMeta::new(state::state_address(&program_id, deployment_id).0, false),
+                AccountMeta::new(
+                    state::burn_receipt_address(&program_id, deployment_id, burn_sequence).0,
+                    false,
+                ),
+                AccountMeta::new_readonly(solana_sdk_ids::system_program::id(), false),
+            ],
+        )
+    }
+
+    /// `new_epoch` is `Some` only for a RotateGuardians message.
+    pub fn govern(
+        payer: &Pubkey,
+        attestation: &Pubkey,
+        deployment_id: &[u8; 32],
+        epoch: u64,
+        new_epoch: Option<u64>,
+    ) -> Instruction {
+        let program_id = crate::id();
+        let mut accounts = vec![
+            AccountMeta::new(*payer, true),
+            AccountMeta::new(state::state_address(&program_id, deployment_id).0, false),
+            AccountMeta::new_readonly(
+                state::guardian_set_address(&program_id, deployment_id, epoch).0,
+                false,
+            ),
+            AccountMeta::new(*attestation, false),
+            AccountMeta::new_readonly(solana_sdk_ids::system_program::id(), false),
+        ];
+        if let Some(new_epoch) = new_epoch {
+            accounts.push(AccountMeta::new(
+                state::guardian_set_address(&program_id, deployment_id, new_epoch).0,
+                false,
+            ));
+        }
+        ix(BridgeInstruction::Govern, accounts)
+    }
+
+    pub fn pause(
+        pauser: &Pubkey,
+        deployment_id: &[u8; 32],
+        deposits: u8,
+        withdrawals: u8,
+    ) -> Instruction {
+        ix(
+            BridgeInstruction::Pause {
+                deposits,
+                withdrawals,
+            },
+            vec![
+                AccountMeta::new_readonly(*pauser, true),
+                AccountMeta::new(state::state_address(&crate::id(), deployment_id).0, false),
+            ],
+        )
+    }
+}
diff --git a/programs/lattice-bridge/src/lib.rs b/programs/lattice-bridge/src/lib.rs
new file mode 100644
index 000000000..a1208aa02
--- /dev/null
+++ b/programs/lattice-bridge/src/lib.rs
@@ -0,0 +1,45 @@
+//! Lattice native bridge builtin (`lattice-bridge`): the destination side of
+//! the Solana SPL ↔ native LAT bridge, and the only path that creates or
+//! destroys native lamports outside genesis, fees and the upstream runtime.
+//!
+//! - `MintFromDeposit` credits exactly the attested amount of a Solana
+//!   deposit after an M-of-N guardian threshold over the canonical wire-v1
+//!   DEPOSIT message (docs/BRIDGE_SPEC.md), exactly once per deposit sequence.
+//! - `BurnForWithdrawal` destroys LAT (reducing capitalization) and writes a
+//!   durable receipt with a monotonic burn sequence for guardians to attest.
+//!
+//! Program id = base58(sha256("lattice:program:lattice-bridge:v1")), loaded
+//! from genesis as a builtin behind `enable_lattice_bridge_program`.
+//! Design and account layouts: docs/NATIVE_ISSUANCE.md. Unaudited.
+
+pub mod conversion;
+pub mod error;
+pub mod genesis;
+pub mod guardian;
+pub mod instruction;
+pub mod logic;
+#[cfg(feature = "agave-unstable-api")]
+pub mod processor;
+pub mod state;
+pub mod wire;
+
+#[cfg(test)]
+mod tests;
+
+use solana_pubkey::Pubkey;
+
+pub const ID: Pubkey = Pubkey::from_str_const("Geuc2RbbzoWXSNYRyVDcjM5fZx6raKgf45y1bQr6aSzN");
+
+pub fn id() -> Pubkey {
+    ID
+}
+
+pub fn check_id(id: &Pubkey) -> bool {
+    *id == ID
+}
+
+#[cfg(all(test, feature = "agave-unstable-api"))]
+#[test]
+fn program_id_matches_runtime_supply_gate() {
+    assert_eq!(ID, solana_transaction_context::LATTICE_BRIDGE_PROGRAM_ID);
+}
diff --git a/programs/lattice-bridge/src/logic.rs b/programs/lattice-bridge/src/logic.rs
new file mode 100644
index 000000000..601ad516d
--- /dev/null
+++ b/programs/lattice-bridge/src/logic.rs
@@ -0,0 +1,409 @@
+//! Pure state transitions. The builtin processor loads accounts, calls these
+//! functions, and then performs the account side effects (PDA creation,
+//! lamport credit/debit, supply recording). Unit tests drive the same
+//! functions, so every rule below is exercised without a validator.
+
+use crate::{
+    conversion,
+    error::{BridgeError, BridgeResult},
+    guardian,
+    state::{
+        ATTESTATION_SEALED, AttestationHeader, BridgeState, BurnReceipt, FLAG_DEPOSITS_PAUSED,
+        FLAG_LATTICE_GENESIS_BOUND, FLAG_WITHDRAWALS_PAUSED, GuardianSet, MintRecord,
+    },
+    wire::{self, GovernanceAction, Header, KIND_DEPOSIT, KIND_DESTINATION_GOVERNANCE},
+};
+
+/// SHA-256 cost charged when an attestation is sealed (mirrors the
+/// `sol_sha256` syscall pricing: 85 base + 1 CU per 2 bytes).
+pub fn digest_cost(message_len: usize) -> u64 {
+    85u64.saturating_add((message_len as u64).div_ceil(2))
+}
+
+fn ensure(condition: bool, error: BridgeError) -> BridgeResult<()> {
+    if condition { Ok(()) } else { Err(error) }
+}
+
+/// Checks the header fields every kind shares with the bound configuration.
+fn check_common_header(
+    header: &Header,
+    state: &BridgeState,
+    set: &GuardianSet,
+) -> BridgeResult<()> {
+    ensure(
+        header.protocol_version == wire::PROTOCOL_VERSION,
+        BridgeError::WrongProtocolVersion,
+    )?;
+    ensure(header.scheme == set.scheme, BridgeError::WrongScheme)?;
+    ensure(
+        header.deployment_id == state.deployment_id,
+        BridgeError::WrongDeployment,
+    )?;
+    ensure(
+        header.solana_genesis_hash == state.solana_genesis_hash,
+        BridgeError::WrongSolanaGenesis,
+    )?;
+    ensure(
+        header.source_program_id == state.source_program_id,
+        BridgeError::WrongSourceProgram,
+    )?;
+    ensure(
+        header.source_mint == state.source_mint,
+        BridgeError::WrongSourceMint,
+    )?;
+    ensure(
+        header.signer_epoch == state.guardian_epoch && header.signer_epoch == set.epoch,
+        BridgeError::WrongSignerEpoch,
+    )
+}
+
+fn check_set_is_current(state: &BridgeState, set: &GuardianSet) -> BridgeResult<()> {
+    ensure(
+        set.deployment_id == state.deployment_id && set.epoch == state.guardian_epoch,
+        BridgeError::InvalidGuardianSetAccount,
+    )
+}
+
+/// Seals the attestation on first use (fixing its digest and signer epoch)
+/// and verifies signature entries `[first, first + count)`.
+pub fn seal_and_verify<E, F>(
+    attestation: &mut AttestationHeader,
+    account_data: &[u8],
+    state: &BridgeState,
+    set: &GuardianSet,
+    first: u8,
+    count: u8,
+    charge: &mut F,
+) -> Result<(), E>
+where
+    E: From<BridgeError>,
+    F: FnMut(u64) -> Result<(), E>,
+{
+    if attestation.status != ATTESTATION_SEALED {
+        let message = attestation.message(account_data)?;
+        let header = wire::parse_header(message)?;
+        ensure(
+            header.kind == KIND_DEPOSIT || header.kind == KIND_DESTINATION_GOVERNANCE,
+            BridgeError::WrongKind,
+        )?;
+        ensure(
+            header.scheme == attestation.scheme,
+            BridgeError::WrongScheme,
+        )?;
+        ensure(
+            header.deployment_id == state.deployment_id,
+            BridgeError::WrongDeployment,
+        )?;
+        charge(digest_cost(message.len()))?;
+        attestation.digest = wire::digest(message);
+        attestation.signer_epoch = header.signer_epoch;
+        attestation.status = ATTESTATION_SEALED;
+    }
+    ensure(
+        attestation.signer_epoch == state.guardian_epoch,
+        BridgeError::WrongSignerEpoch,
+    )?;
+    check_set_is_current(state, set)?;
+    ensure(set.scheme == attestation.scheme, BridgeError::WrongScheme)?;
+    ensure(
+        u16::from(first).saturating_add(u16::from(count)) <= u16::from(attestation.signature_count),
+        BridgeError::AttestationOutOfBounds,
+    )?;
+    let signatures = attestation.signatures(account_data)?;
+    let proven = guardian::verify_entries(
+        set,
+        &attestation.digest,
+        signatures,
+        usize::from(first),
+        usize::from(count),
+        charge,
+    )?;
+    attestation.verified_bitmap |= proven;
+    Ok(())
+}
+
+/// Preconditions for consuming a sealed attestation in Mint/Govern.
+pub fn check_attestation_ready(
+    attestation: &AttestationHeader,
+    state: &BridgeState,
+    set: &GuardianSet,
+    payer: &[u8; 32],
+) -> BridgeResult<()> {
+    ensure(
+        attestation.status == ATTESTATION_SEALED,
+        BridgeError::AttestationNotSealed,
+    )?;
+    ensure(attestation.writer == *payer, BridgeError::AttestationWriter)?;
+    ensure(
+        attestation.signer_epoch == state.guardian_epoch,
+        BridgeError::WrongSignerEpoch,
+    )?;
+    check_set_is_current(state, set)?;
+    ensure(set.scheme == attestation.scheme, BridgeError::WrongScheme)?;
+    ensure(
+        guardian::signers(attestation.verified_bitmap, set.keys.len()) >= u32::from(set.threshold),
+        BridgeError::BelowThreshold,
+    )
+}
+
+/// Validates a DEPOSIT message (BRIDGE_SPEC §9.1 steps 1 and 3).
+pub fn check_deposit(
+    state: &BridgeState,
+    set: &GuardianSet,
+    message: &[u8],
+) -> BridgeResult<wire::Transfer> {
+    let transfer = wire::parse_transfer(message)?;
+    let header = &transfer.header;
+    ensure(header.kind == KIND_DEPOSIT, BridgeError::WrongKind)?;
+    check_common_header(header, state, set)?;
+    ensure(
+        state.is_flag(FLAG_LATTICE_GENESIS_BOUND),
+        BridgeError::LatticeGenesisNotBound,
+    )?;
+    ensure(
+        header.lattice_genesis_hash == state.lattice_genesis_hash,
+        BridgeError::WrongLatticeGenesis,
+    )?;
+    ensure(
+        transfer.event_id == wire::deposit_event_id(&state.deployment_id, header.nonce),
+        BridgeError::WrongEventId,
+    )?;
+    ensure(transfer.recipient != [0; 32], BridgeError::ZeroRecipient)?;
+    ensure(
+        transfer.source_amount != 0 && transfer.native_amount != 0,
+        BridgeError::ZeroAmount,
+    )?;
+    ensure(
+        conversion::source_to_native(transfer.source_amount, state.source_decimals)?
+            == transfer.native_amount,
+        BridgeError::AmountMismatch,
+    )?;
+    ensure(
+        !state.is_flag(FLAG_DEPOSITS_PAUSED),
+        BridgeError::DepositsPaused,
+    )?;
+    Ok(transfer)
+}
+
+/// Applies supply accounting and the per-epoch mint rate limit.
+pub fn apply_mint(
+    state: &mut BridgeState,
+    native_amount: u64,
+    epoch: u64,
+    slot: u64,
+) -> BridgeResult<()> {
+    if state.rate_limit_epoch != epoch {
+        state.rate_limit_epoch = epoch;
+        state.minted_in_rate_epoch = 0;
+    }
+    let minted_in_epoch = state
+        .minted_in_rate_epoch
+        .checked_add(native_amount)
+        .ok_or(BridgeError::Overflow)?;
+    ensure(
+        minted_in_epoch <= state.max_mint_per_epoch,
+        BridgeError::MintRateLimitExceeded,
+    )?;
+    let native = u128::from(native_amount);
+    state.total_minted_native = state
+        .total_minted_native
+        .checked_add(native)
+        .ok_or(BridgeError::Overflow)?;
+    state.outstanding_native = state
+        .outstanding_native
+        .checked_add(native)
+        .ok_or(BridgeError::Overflow)?;
+    state.minted_count = state
+        .minted_count
+        .checked_add(1)
+        .ok_or(BridgeError::Overflow)?;
+    state.minted_in_rate_epoch = minted_in_epoch;
+    state.last_mint_slot = slot;
+    Ok(())
+}
+
+/// Full mint decision: attestation readiness, message validity,
+/// exactly-once, rate limit and accounting. On success the caller must
+/// create the mint record, credit `native_amount` to the recipient and
+/// record the same supply increase, all in the same instruction.
+#[allow(clippy::too_many_arguments)]
+pub fn process_mint(
+    state: &mut BridgeState,
+    set: &GuardianSet,
+    attestation: &AttestationHeader,
+    message: &[u8],
+    payer: &[u8; 32],
+    mint_record_exists: bool,
+    epoch: u64,
+    slot: u64,
+) -> BridgeResult<MintRecord> {
+    check_attestation_ready(attestation, state, set, payer)?;
+    let transfer = check_deposit(state, set, message)?;
+    ensure(!mint_record_exists, BridgeError::DepositAlreadyMinted)?;
+    apply_mint(state, transfer.native_amount, epoch, slot)?;
+    Ok(MintRecord {
+        deployment_id: state.deployment_id,
+        deposit_sequence: transfer.header.nonce,
+        recipient: transfer.recipient,
+        native_amount: transfer.native_amount,
+        slot,
+        event_id: transfer.event_id,
+    })
+}
+
+/// Burn decision. On success the caller must move `native_amount` from the
+/// burner into program custody, debit it, record the supply decrease and
+/// write the returned receipt, all in the same instruction.
+pub fn process_burn(
+    state: &mut BridgeState,
+    burner: &[u8; 32],
+    native_amount: u64,
+    solana_recipient: &[u8; 32],
+    slot: u64,
+) -> BridgeResult<BurnReceipt> {
+    ensure(
+        !state.is_flag(FLAG_WITHDRAWALS_PAUSED),
+        BridgeError::WithdrawalsPaused,
+    )?;
+    ensure(
+        state.is_flag(FLAG_LATTICE_GENESIS_BOUND),
+        BridgeError::LatticeGenesisNotBound,
+    )?;
+    ensure(*solana_recipient != [0; 32], BridgeError::ZeroRecipient)?;
+    let source_amount = conversion::native_to_source(native_amount, state.source_decimals)?;
+    let native = u128::from(native_amount);
+    let outstanding = state
+        .outstanding_native
+        .checked_sub(native)
+        .ok_or(BridgeError::BurnExceedsOutstanding)?;
+    let burn_sequence = state.next_burn_sequence;
+    state.next_burn_sequence = burn_sequence.checked_add(1).ok_or(BridgeError::Overflow)?;
+    state.total_burned_native = state
+        .total_burned_native
+        .checked_add(native)
+        .ok_or(BridgeError::Overflow)?;
+    state.outstanding_native = outstanding;
+    state.last_burn_slot = slot;
+    Ok(BurnReceipt {
+        deployment_id: state.deployment_id,
+        burn_sequence,
+        burner: *burner,
+        native_amount,
+        source_amount,
+        solana_recipient: *solana_recipient,
+        slot,
+        event_id: wire::burn_event_id(&state.deployment_id, burn_sequence),
+    })
+}
+
+/// Validates and applies a DESTINATION_GOVERNANCE (kind 4) message. Returns
+/// the new guardian set when the action is a rotation; the caller must then
+/// create its account at `PDA(["guardian-set", deployment_id, new_epoch])`.
+pub fn process_governance(
+    state: &mut BridgeState,
+    set: &GuardianSet,
+    attestation: &AttestationHeader,
+    message: &[u8],
+    payer: &[u8; 32],
+    slot: u64,
+) -> BridgeResult<Option<GuardianSet>> {
+    check_attestation_ready(attestation, state, set, payer)?;
+    let header = wire::parse_header(message)?;
+    ensure(
+        header.kind == KIND_DESTINATION_GOVERNANCE,
+        BridgeError::WrongKind,
+    )?;
+    check_common_header(&header, state, set)?;
+    ensure(
+        header.nonce == state.governance_sequence,
+        BridgeError::WrongNonce,
+    )?;
+    let body = message
+        .get(wire::HEADER_LEN..)
+        .ok_or(BridgeError::MalformedMessage)?;
+    let action = wire::parse_governance_body(body)?;
+    let bound = state.is_flag(FLAG_LATTICE_GENESIS_BOUND);
+    if action == GovernanceAction::BindLatticeGenesis {
+        ensure(!bound, BridgeError::LatticeGenesisAlreadyBound)?;
+        ensure(
+            header.lattice_genesis_hash != [0; 32],
+            BridgeError::WrongLatticeGenesis,
+        )?;
+    } else {
+        // Before binding, governance messages carry the all-zero hash.
+        ensure(
+            header.lattice_genesis_hash == state.lattice_genesis_hash,
+            BridgeError::WrongLatticeGenesis,
+        )?;
+    }
+    state.governance_sequence = state
+        .governance_sequence
+        .checked_add(1)
+        .ok_or(BridgeError::Overflow)?;
+    let mut new_set = None;
+    match action {
+        GovernanceAction::RotateGuardians {
+            new_epoch,
+            threshold,
+            scheme,
+            keys,
+        } => {
+            ensure(
+                Some(new_epoch) == state.guardian_epoch.checked_add(1),
+                BridgeError::WrongNewEpoch,
+            )?;
+            let candidate = GuardianSet {
+                scheme,
+                threshold,
+                bump: 0,
+                epoch: new_epoch,
+                created_slot: slot,
+                deployment_id: state.deployment_id,
+                keys,
+            };
+            candidate.validate()?;
+            state.guardian_epoch = new_epoch;
+            new_set = Some(candidate);
+        }
+        GovernanceAction::SetPause {
+            deposits_paused,
+            withdrawals_paused,
+        } => {
+            state.set_flag(FLAG_DEPOSITS_PAUSED, deposits_paused);
+            state.set_flag(FLAG_WITHDRAWALS_PAUSED, withdrawals_paused);
+        }
+        GovernanceAction::SetLimits { max_mint_per_epoch } => {
+            state.max_mint_per_epoch = max_mint_per_epoch;
+        }
+        GovernanceAction::SetPauser { pauser } => state.pauser = pauser,
+        GovernanceAction::BindLatticeGenesis => {
+            state.lattice_genesis_hash = header.lattice_genesis_hash;
+            state.set_flag(FLAG_LATTICE_GENESIS_BOUND, true);
+        }
+    }
+    Ok(new_set)
+}
+
+/// The optional pauser key can only set pause flags (1 = pause, 0 = leave).
+pub fn process_pauser_pause(
+    state: &mut BridgeState,
+    signer: &[u8; 32],
+    pause_deposits: u8,
+    pause_withdrawals: u8,
+) -> BridgeResult<()> {
+    ensure(
+        state.pauser != [0; 32] && state.pauser == *signer,
+        BridgeError::NotPauser,
+    )?;
+    for (flag, value) in [
+        (FLAG_DEPOSITS_PAUSED, pause_deposits),
+        (FLAG_WITHDRAWALS_PAUSED, pause_withdrawals),
+    ] {
+        match value {
+            0 => {}
+            1 => state.set_flag(flag, true),
+            _ => return Err(BridgeError::UnpauseNotAllowed),
+        }
+    }
+    Ok(())
+}
diff --git a/programs/lattice-bridge/src/processor.rs b/programs/lattice-bridge/src/processor.rs
new file mode 100644
index 000000000..3432adba2
--- /dev/null
+++ b/programs/lattice-bridge/src/processor.rs
@@ -0,0 +1,603 @@
+//! Builtin entrypoint. Loads accounts, runs the pure decisions in
+//! [`crate::logic`], then applies side effects atomically within the same
+//! top-level instruction:
+//!
+//! - mint: create the `LATMINT1` record PDA, credit the recipient, and call
+//!   `TransactionContext::record_native_supply_change(+amount)`;
+//! - burn: create the `LATBURN1` receipt PDA, move `amount` from the burner
+//!   into the program-owned state account via the system program, debit it
+//!   there, and call `record_native_supply_change(-amount)`.
+//!
+//! The runtime applies the recorded delta to bank capitalization only if the
+//! whole transaction succeeds.
+
+use {
+    crate::{
+        error::BridgeError,
+        instruction::BridgeInstruction,
+        logic,
+        state::{
+            ATTESTATION_HEADER_LEN, ATTESTATION_OPEN, AttestationHeader, BURN_RECEIPT_LEN,
+            BridgeState, GuardianSet, MINT_RECORD_LEN, SEED_BURN, SEED_GUARDIAN_SET, SEED_MINTED,
+            SEED_STATE,
+        },
+        wire,
+    },
+    solana_instruction::error::InstructionError,
+    solana_program_runtime::{declare_process_instruction, invoke_context::InvokeContext},
+    solana_pubkey::Pubkey,
+    solana_svm_log_collector::ic_msg,
+    solana_system_interface::instruction as system_instruction,
+    solana_transaction_context::IndexOfAccount,
+};
+
+pub const DEFAULT_COMPUTE_UNITS: u64 = 1_500;
+/// Same price as one `create_program_address` syscall attempt.
+pub const PDA_DERIVATION_COST: u64 = 1_500;
+/// Charge for copying data into an attestation account.
+pub const WRITE_BYTES_PER_CU: u64 = 16;
+
+impl From<BridgeError> for InstructionError {
+    fn from(error: BridgeError) -> Self {
+        InstructionError::Custom(error.into())
+    }
+}
+
+declare_process_instruction!(Entrypoint, DEFAULT_COMPUTE_UNITS, |invoke_context| {
+    let result = process(invoke_context);
+    if let Err(err) = &result {
+        ic_msg!(invoke_context, "lattice-bridge: {:?}", err);
+    }
+    result
+});
+
+fn process(invoke_context: &mut InvokeContext) -> Result<(), InstructionError> {
+    let data = invoke_context
+        .transaction_context
+        .get_current_instruction_context()?
+        .get_instruction_data()
+        .to_vec();
+    match BridgeInstruction::decode(&data)? {
+        BridgeInstruction::InitAttestation {
+            scheme,
+            signature_count,
+            message_len,
+        } => init_attestation(invoke_context, scheme, signature_count, message_len),
+        BridgeInstruction::WriteAttestation { offset, data } => {
+            write_attestation(invoke_context, offset, &data)
+        }
+        BridgeInstruction::VerifyAttestation { first, count } => {
+            verify_attestation(invoke_context, first, count)
+        }
+        BridgeInstruction::CloseAttestation => close_attestation_instruction(invoke_context),
+        BridgeInstruction::MintFromDeposit => mint_from_deposit(invoke_context),
+        BridgeInstruction::BurnForWithdrawal {
+            native_amount,
+            solana_recipient,
+        } => burn_for_withdrawal(invoke_context, native_amount, &solana_recipient),
+        BridgeInstruction::Govern => govern(invoke_context),
+        BridgeInstruction::Pause {
+            deposits,
+            withdrawals,
+        } => pause(invoke_context, deposits, withdrawals),
+    }
+}
+
+fn charge(invoke_context: &InvokeContext, units: u64) -> Result<(), InstructionError> {
+    invoke_context
+        .compute_meter
+        .consume_checked(units)
+        .map_err(|_| InstructionError::ComputationalBudgetExceeded)
+}
+
+fn key_at(
+    invoke_context: &InvokeContext,
+    index: IndexOfAccount,
+) -> Result<Pubkey, InstructionError> {
+    Ok(*invoke_context
+        .transaction_context
+        .get_current_instruction_context()?
+        .get_key_of_instruction_account(index)?)
+}
+
+fn require_signer(
+    invoke_context: &InvokeContext,
+    index: IndexOfAccount,
+) -> Result<Pubkey, InstructionError> {
+    let instruction_context = invoke_context
+        .transaction_context
+        .get_current_instruction_context()?;
+    if !instruction_context.is_instruction_account_signer(index)? {
+        return Err(InstructionError::MissingRequiredSignature);
+    }
+    Ok(*instruction_context.get_key_of_instruction_account(index)?)
+}
+
+fn require_accounts(
+    invoke_context: &InvokeContext,
+    count: IndexOfAccount,
+) -> Result<(), InstructionError> {
+    invoke_context
+        .transaction_context
+        .get_current_instruction_context()?
+        .check_number_of_instruction_accounts(count)
+}
+
+fn require_system_program(
+    invoke_context: &InvokeContext,
+    index: IndexOfAccount,
+) -> Result<(), InstructionError> {
+    if key_at(invoke_context, index)? != solana_sdk_ids::system_program::id() {
+        return Err(InstructionError::MissingAccount);
+    }
+    Ok(())
+}
+
+/// Returns (owner, lamports, data) of an instruction account.
+fn read_account(
+    invoke_context: &InvokeContext,
+    index: IndexOfAccount,
+) -> Result<(Pubkey, u64, Vec<u8>), InstructionError> {
+    let instruction_context = invoke_context
+        .transaction_context
+        .get_current_instruction_context()?;
+    let account = instruction_context.try_borrow_instruction_account(index)?;
+    Ok((
+        *account.get_owner(),
+        account.get_lamports(),
+        account.get_data().to_vec(),
+    ))
+}
+
+fn write_data(
+    invoke_context: &InvokeContext,
+    index: IndexOfAccount,
+    data: &[u8],
+) -> Result<(), InstructionError> {
+    let instruction_context = invoke_context
+        .transaction_context
+        .get_current_instruction_context()?;
+    let mut account = instruction_context.try_borrow_instruction_account(index)?;
+    let target = account.get_data_mut()?;
+    if target.len() != data.len() {
+        return Err(InstructionError::InvalidAccountData);
+    }
+    target.copy_from_slice(data);
+    Ok(())
+}
+
+fn find_pda(
+    invoke_context: &InvokeContext,
+    seeds: &[&[u8]],
+) -> Result<(Pubkey, u8), InstructionError> {
+    let (address, bump) = Pubkey::find_program_address(seeds, &crate::id());
+    charge(
+        invoke_context,
+        PDA_DERIVATION_COST.saturating_mul(256u64.saturating_sub(u64::from(bump))),
+    )?;
+    Ok((address, bump))
+}
+
+fn load_state(
+    invoke_context: &InvokeContext,
+    index: IndexOfAccount,
+) -> Result<(Pubkey, BridgeState), InstructionError> {
+    let (owner, _, data) = read_account(invoke_context, index)?;
+    if owner != crate::id() {
+        return Err(BridgeError::InvalidStateAccount.into());
+    }
+    let state = BridgeState::decode(&data)?;
+    charge(invoke_context, PDA_DERIVATION_COST)?;
+    let expected = Pubkey::create_program_address(
+        &[SEED_STATE, &state.deployment_id, &[state.bump]],
+        &crate::id(),
+    )
+    .map_err(|_| BridgeError::InvalidStateAccount)?;
+    let key = key_at(invoke_context, index)?;
+    if key != expected {
+        return Err(BridgeError::InvalidStateAccount.into());
+    }
+    Ok((key, state))
+}
+
+fn load_guardian_set(
+    invoke_context: &InvokeContext,
+    index: IndexOfAccount,
+) -> Result<GuardianSet, InstructionError> {
+    let (owner, _, data) = read_account(invoke_context, index)?;
+    if owner != crate::id() {
+        return Err(BridgeError::InvalidGuardianSetAccount.into());
+    }
+    Ok(GuardianSet::decode(&data)?)
+}
+
+fn load_attestation(
+    invoke_context: &InvokeContext,
+    index: IndexOfAccount,
+) -> Result<(AttestationHeader, Vec<u8>), InstructionError> {
+    let (owner, _, data) = read_account(invoke_context, index)?;
+    if owner != crate::id() {
+        return Err(BridgeError::InvalidAttestationAccount.into());
+    }
+    let header = AttestationHeader::decode(&data)?;
+    Ok((header, data))
+}
+
+/// Creates a program-owned PDA funded by `payer`. Handles an address that was
+/// pre-funded by a third party (transfer + allocate + assign instead of
+/// create_account), so lamports sent to a future record address cannot
+/// block it.
+fn create_pda_account(
+    invoke_context: &mut InvokeContext,
+    payer_index: IndexOfAccount,
+    pda_index: IndexOfAccount,
+    seeds: &[&[u8]],
+    space: usize,
+) -> Result<(), InstructionError> {
+    let payer = key_at(invoke_context, payer_index)?;
+    let pda = key_at(invoke_context, pda_index)?;
+    let (owner, lamports, data) = read_account(invoke_context, pda_index)?;
+    let required = invoke_context
+        .environment_config
+        .sysvar_cache()
+        .get_rent()?
+        .minimum_balance(space)
+        .max(1);
+    let program_id = crate::id();
+    let space = space as u64;
+    if lamports == 0 {
+        invoke_context.native_invoke_signed(
+            system_instruction::create_account(&payer, &pda, required, space, &program_id),
+            &[seeds],
+        )?;
+    } else {
+        if owner != solana_sdk_ids::system_program::id() || !data.is_empty() {
+            return Err(InstructionError::AccountAlreadyInitialized);
+        }
+        if lamports < required {
+            invoke_context.native_invoke_signed(
+                system_instruction::transfer(&payer, &pda, required.saturating_sub(lamports)),
+                &[],
+            )?;
+        }
+        invoke_context.native_invoke_signed(system_instruction::allocate(&pda, space), &[seeds])?;
+        invoke_context
+            .native_invoke_signed(system_instruction::assign(&pda, &program_id), &[seeds])?;
+    }
+    Ok(())
+}
+
+/// Returns all attestation lamports to `refund_index` and empties the account.
+fn close_attestation(
+    invoke_context: &InvokeContext,
+    attestation_index: IndexOfAccount,
+    refund_index: IndexOfAccount,
+) -> Result<(), InstructionError> {
+    let instruction_context = invoke_context
+        .transaction_context
+        .get_current_instruction_context()?;
+    let lamports = {
+        let mut attestation =
+            instruction_context.try_borrow_instruction_account(attestation_index)?;
+        let lamports = attestation.get_lamports();
+        attestation.set_data_length(0)?;
+        attestation.set_lamports(0)?;
+        lamports
+    };
+    instruction_context
+        .try_borrow_instruction_account(refund_index)?
+        .checked_add_lamports(lamports)
+}
+
+fn init_attestation(
+    invoke_context: &mut InvokeContext,
+    scheme: u8,
+    signature_count: u8,
+    message_len: u32,
+) -> Result<(), InstructionError> {
+    require_accounts(invoke_context, 2)?;
+    let writer = require_signer(invoke_context, 0)?;
+    if signature_count == 0
+        || usize::from(signature_count) > wire::MAX_GUARDIANS
+        || (message_len as usize) < wire::HEADER_LEN
+        || (message_len as usize) > wire::MAX_MESSAGE_LEN
+    {
+        return Err(BridgeError::AttestationOutOfBounds.into());
+    }
+    let total_len = AttestationHeader::total_len(scheme, message_len, signature_count)?;
+    let instruction_context = invoke_context
+        .transaction_context
+        .get_current_instruction_context()?;
+    let mut attestation = instruction_context.try_borrow_instruction_account(1)?;
+    if *attestation.get_owner() != crate::id() {
+        return Err(BridgeError::InvalidAttestationAccount.into());
+    }
+    if attestation.get_data().len() != total_len {
+        return Err(BridgeError::InvalidAttestationAccount.into());
+    }
+    if attestation
+        .get_data()
+        .iter()
+        .take(ATTESTATION_HEADER_LEN)
+        .any(|b| *b != 0)
+    {
+        return Err(InstructionError::AccountAlreadyInitialized);
+    }
+    let header = AttestationHeader {
+        scheme,
+        status: ATTESTATION_OPEN,
+        signature_count,
+        verified_bitmap: 0,
+        signer_epoch: 0,
+        digest: [0; 32],
+        writer: writer.to_bytes(),
+        message_len,
+    };
+    header.encode_into(attestation.get_data_mut()?);
+    Ok(())
+}
+
+fn write_attestation(
+    invoke_context: &mut InvokeContext,
+    offset: u32,
+    bytes: &[u8],
+) -> Result<(), InstructionError> {
+    require_accounts(invoke_context, 2)?;
+    let writer = require_signer(invoke_context, 0)?;
+    charge(
+        invoke_context,
+        (bytes.len() as u64).div_ceil(WRITE_BYTES_PER_CU),
+    )?;
+    let (header, data) = load_attestation(invoke_context, 1)?;
+    if header.status != ATTESTATION_OPEN {
+        return Err(BridgeError::AttestationSealed.into());
+    }
+    if header.writer != writer.to_bytes() {
+        return Err(BridgeError::AttestationWriter.into());
+    }
+    let start = ATTESTATION_HEADER_LEN
+        .checked_add(offset as usize)
+        .ok_or(BridgeError::AttestationOutOfBounds)?;
+    let end = start
+        .checked_add(bytes.len())
+        .filter(|end| *end <= data.len())
+        .ok_or(BridgeError::AttestationOutOfBounds)?;
+    let instruction_context = invoke_context
+        .transaction_context
+        .get_current_instruction_context()?;
+    let mut attestation = instruction_context.try_borrow_instruction_account(1)?;
+    attestation
+        .get_data_mut()?
+        .get_mut(start..end)
+        .ok_or(BridgeError::AttestationOutOfBounds)?
+        .copy_from_slice(bytes);
+    Ok(())
+}
+
+fn verify_attestation(
+    invoke_context: &mut InvokeContext,
+    first: u8,
+    count: u8,
+) -> Result<(), InstructionError> {
+    require_accounts(invoke_context, 3)?;
+    let (_, state) = load_state(invoke_context, 1)?;
+    let set = load_guardian_set(invoke_context, 2)?;
+    let (mut header, data) = load_attestation(invoke_context, 0)?;
+    let mut meter = |units: u64| charge(invoke_context, units);
+    logic::seal_and_verify(&mut header, &data, &state, &set, first, count, &mut meter)?;
+    let mut updated = data;
+    header.encode_into(&mut updated);
+    write_data(invoke_context, 0, &updated)
+}
+
+fn close_attestation_instruction(
+    invoke_context: &mut InvokeContext,
+) -> Result<(), InstructionError> {
+    require_accounts(invoke_context, 2)?;
+    let writer = require_signer(invoke_context, 0)?;
+    let (header, _) = load_attestation(invoke_context, 1)?;
+    if header.writer != writer.to_bytes() {
+        return Err(BridgeError::AttestationWriter.into());
+    }
+    close_attestation(invoke_context, 1, 0)
+}
+
+fn current_clock(invoke_context: &InvokeContext) -> Result<(u64, u64), InstructionError> {
+    let clock = invoke_context
+        .environment_config
+        .sysvar_cache()
+        .get_clock()?;
+    Ok((clock.slot, clock.epoch))
+}
+
+fn mint_from_deposit(invoke_context: &mut InvokeContext) -> Result<(), InstructionError> {
+    const PAYER: IndexOfAccount = 0;
+    const STATE: IndexOfAccount = 1;
+    const GUARDIANS: IndexOfAccount = 2;
+    const ATTESTATION: IndexOfAccount = 3;
+    const RECORD: IndexOfAccount = 4;
+    const RECIPIENT: IndexOfAccount = 5;
+    const SYSTEM: IndexOfAccount = 6;
+
+    require_accounts(invoke_context, 7)?;
+    let payer = require_signer(invoke_context, PAYER)?;
+    require_system_program(invoke_context, SYSTEM)?;
+    let (_, mut state) = load_state(invoke_context, STATE)?;
+    let set = load_guardian_set(invoke_context, GUARDIANS)?;
+    let (attestation, attestation_data) = load_attestation(invoke_context, ATTESTATION)?;
+    let message = attestation.message(&attestation_data)?.to_vec();
+    let transfer = wire::parse_transfer(&message)?;
+    let nonce = transfer.header.nonce.to_le_bytes();
+
+    let (record_address, bump) =
+        find_pda(invoke_context, &[SEED_MINTED, &state.deployment_id, &nonce])?;
+    if key_at(invoke_context, RECORD)? != record_address {
+        return Err(BridgeError::InvalidRecordAccount.into());
+    }
+    let (record_owner, _, _) = read_account(invoke_context, RECORD)?;
+    let (recipient_owner, _, _) = read_account(invoke_context, RECIPIENT)?;
+    if key_at(invoke_context, RECIPIENT)?.to_bytes() != transfer.recipient
+        || recipient_owner == crate::id()
+    {
+        return Err(BridgeError::InvalidRecipientAccount.into());
+    }
+
+    let (slot, epoch) = current_clock(invoke_context)?;
+    let record = logic::process_mint(
+        &mut state,
+        &set,
+        &attestation,
+        &message,
+        &payer.to_bytes(),
+        record_owner == crate::id(),
+        epoch,
+        slot,
+    )?;
+
+    let deployment_id = state.deployment_id;
+    create_pda_account(
+        invoke_context,
+        PAYER,
+        RECORD,
+        &[SEED_MINTED, &deployment_id, &nonce, &[bump]],
+        MINT_RECORD_LEN,
+    )?;
+    write_data(invoke_context, RECORD, &record.encode())?;
+    {
+        let instruction_context = invoke_context
+            .transaction_context
+            .get_current_instruction_context()?;
+        instruction_context
+            .try_borrow_instruction_account(RECIPIENT)?
+            .checked_add_lamports(record.native_amount)?;
+    }
+    invoke_context
+        .transaction_context
+        .record_native_supply_change(i128::from(record.native_amount))?;
+    write_data(invoke_context, STATE, &state.encode())?;
+    close_attestation(invoke_context, ATTESTATION, PAYER)
+}
+
+fn burn_for_withdrawal(
+    invoke_context: &mut InvokeContext,
+    native_amount: u64,
+    solana_recipient: &[u8; 32],
+) -> Result<(), InstructionError> {
+    const BURNER: IndexOfAccount = 0;
+    const STATE: IndexOfAccount = 1;
+    const RECEIPT: IndexOfAccount = 2;
+    const SYSTEM: IndexOfAccount = 3;
+
+    require_accounts(invoke_context, 4)?;
+    let burner = require_signer(invoke_context, BURNER)?;
+    require_system_program(invoke_context, SYSTEM)?;
+    let (state_address, mut state) = load_state(invoke_context, STATE)?;
+    let (slot, _) = current_clock(invoke_context)?;
+    let receipt = logic::process_burn(
+        &mut state,
+        &burner.to_bytes(),
+        native_amount,
+        solana_recipient,
+        slot,
+    )?;
+
+    let deployment_id = state.deployment_id;
+    let sequence = receipt.burn_sequence.to_le_bytes();
+    let (receipt_address, bump) =
+        find_pda(invoke_context, &[SEED_BURN, &deployment_id, &sequence])?;
+    if key_at(invoke_context, RECEIPT)? != receipt_address {
+        return Err(BridgeError::InvalidRecordAccount.into());
+    }
+    if read_account(invoke_context, RECEIPT)?.0 == crate::id() {
+        return Err(BridgeError::InvalidRecordAccount.into());
+    }
+    create_pda_account(
+        invoke_context,
+        BURNER,
+        RECEIPT,
+        &[SEED_BURN, &deployment_id, &sequence, &[bump]],
+        BURN_RECEIPT_LEN,
+    )?;
+    write_data(invoke_context, RECEIPT, &receipt.encode())?;
+
+    // Take custody of the burned lamports, then destroy them.
+    invoke_context.native_invoke_signed(
+        system_instruction::transfer(&burner, &state_address, native_amount),
+        &[],
+    )?;
+    {
+        let instruction_context = invoke_context
+            .transaction_context
+            .get_current_instruction_context()?;
+        instruction_context
+            .try_borrow_instruction_account(STATE)?
+            .checked_sub_lamports(native_amount)?;
+    }
+    invoke_context
+        .transaction_context
+        .record_native_supply_change(i128::from(native_amount).saturating_neg())?;
+    write_data(invoke_context, STATE, &state.encode())
+}
+
+fn govern(invoke_context: &mut InvokeContext) -> Result<(), InstructionError> {
+    const PAYER: IndexOfAccount = 0;
+    const STATE: IndexOfAccount = 1;
+    const GUARDIANS: IndexOfAccount = 2;
+    const ATTESTATION: IndexOfAccount = 3;
+    const SYSTEM: IndexOfAccount = 4;
+    const NEW_GUARDIANS: IndexOfAccount = 5;
+
+    require_accounts(invoke_context, 5)?;
+    let payer = require_signer(invoke_context, PAYER)?;
+    require_system_program(invoke_context, SYSTEM)?;
+    let (_, mut state) = load_state(invoke_context, STATE)?;
+    let set = load_guardian_set(invoke_context, GUARDIANS)?;
+    let (attestation, attestation_data) = load_attestation(invoke_context, ATTESTATION)?;
+    let message = attestation.message(&attestation_data)?.to_vec();
+    let (slot, _) = current_clock(invoke_context)?;
+    let new_set = logic::process_governance(
+        &mut state,
+        &set,
+        &attestation,
+        &message,
+        &payer.to_bytes(),
+        slot,
+    )?;
+    if let Some(mut new_set) = new_set {
+        require_accounts(invoke_context, 6)?;
+        let deployment_id = state.deployment_id;
+        let epoch = new_set.epoch.to_le_bytes();
+        let (address, bump) =
+            find_pda(invoke_context, &[SEED_GUARDIAN_SET, &deployment_id, &epoch])?;
+        if key_at(invoke_context, NEW_GUARDIANS)? != address {
+            return Err(BridgeError::InvalidGuardianSetAccount.into());
+        }
+        new_set.bump = bump;
+        let data = new_set.encode()?;
+        create_pda_account(
+            invoke_context,
+            PAYER,
+            NEW_GUARDIANS,
+            &[SEED_GUARDIAN_SET, &deployment_id, &epoch, &[bump]],
+            data.len(),
+        )?;
+        write_data(invoke_context, NEW_GUARDIANS, &data)?;
+    }
+    write_data(invoke_context, STATE, &state.encode())?;
+    close_attestation(invoke_context, ATTESTATION, PAYER)
+}
+
+fn pause(
+    invoke_context: &mut InvokeContext,
+    deposits: u8,
+    withdrawals: u8,
+) -> Result<(), InstructionError> {
+    require_accounts(invoke_context, 2)?;
+    let pauser = require_signer(invoke_context, 0)?;
+    let (_, mut state) = load_state(invoke_context, 1)?;
+    logic::process_pauser_pause(&mut state, &pauser.to_bytes(), deposits, withdrawals)?;
+    write_data(invoke_context, 1, &state.encode())
+}
