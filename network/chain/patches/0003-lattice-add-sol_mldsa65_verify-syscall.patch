+    #[test]
+    fn test_sol_mldsa65_verify_registration() {
+        let compute_budget = SVMTransactionExecutionBudget::default();
+        let mut feature_set = SVMFeatureSet::all_enabled();
+        for enabled in [true, false] {
+            feature_set.enable_mldsa65_verify_syscall = enabled;
+            let env = create_program_runtime_environment(
+                &feature_set,
+                &compute_budget,
+                /* reject_deployment_of_broken_elfs */ false,
+                /* debugging_features */ false,
+            )
+            .unwrap();
+            assert_eq!(
+                env.get_function_registry()
+                    .lookup_by_name(b"sol_mldsa65_verify")
+                    .is_some(),
+                enabled
+            );
+        }
+    }
+
+    #[test]
+    fn test_syscall_mldsa65_verify() {
+        use agave_mldsa_verify::{MLDSA65_MAX_MESSAGE_LEN, MlDsaVerifyError, verify_cost};
+        use solana_sbpf::vm::ContextObject;
+
+        let vectors: serde_json::Value = serde_json::from_str(include_str!(
+            "../../mldsa-verify/tests/vectors/noble-mldsa65.json"
+        ))
+        .unwrap();
+        let case = &vectors["cases"][0];
+        let decode = |k: &str| hex::decode(case[k].as_str().unwrap()).unwrap();
+        let public_key = decode("publicKey");
+        let message = decode("message");
+        let signature = decode("signature");
+        let mut bad_signature = signature.clone();
+        bad_signature[7] ^= 0x80;
+
+        let config = Config::default();
+        prepare_mockup!(invoke_context, program_id, bpf_loader::id());
+        let (pk_va, msg_va, sig_va, bad_sig_va) =
+            (0x100000000, 0x200000000, 0x300000000, 0x400000000);
+        let memory_mapping = unsafe {
+            MemoryMapping::new(
+                vec![
+                    MemoryRegion::new(&raw const *public_key.as_slice(), pk_va),
+                    MemoryRegion::new(&raw const *message.as_slice(), msg_va),
+                    MemoryRegion::new(&raw const *signature.as_slice(), sig_va),
+                    MemoryRegion::new(&raw const *bad_signature.as_slice(), bad_sig_va),
+                ],
+                &config,
+                SBPFVersion::V3,
+            )
+            .unwrap()
+        };
+        invoke_context
+            .memory_contexts
+            .mock_set_mapping_abi_v1(memory_mapping);
+        let msg_len = message.len() as u64;
+        let cost = verify_cost(msg_len);
+
+        let call = |invoke_context: &mut InvokeContext, version, msg_va, len, sig_va| {
+            SyscallMlDsa65Verify::rust(invoke_context, version, pk_va, msg_va, len, sig_va)
+        };
+
+        invoke_context.compute_meter.mock_set_remaining(cost);
+        assert_eq!(call(&mut invoke_context, 1, msg_va, msg_len, sig_va).unwrap(), 0);
+        assert_eq!(invoke_context.get_remaining(), 0);
+
+        invoke_context.compute_meter.mock_set_remaining(cost);
+        assert_eq!(
+            call(&mut invoke_context, 1, msg_va, msg_len, bad_sig_va).unwrap(),
+            MlDsaVerifyError::InvalidSignature as u64
+        );
+        invoke_context.compute_meter.mock_set_remaining(cost);
+        assert_eq!(
+            call(&mut invoke_context, 1, msg_va, msg_len - 1, sig_va).unwrap(),
+            MlDsaVerifyError::InvalidSignature as u64
+        );
+        invoke_context.compute_meter.mock_set_remaining(cost);
+        assert_eq!(
+            call(&mut invoke_context, 2, msg_va, msg_len, sig_va).unwrap(),
+            MlDsaVerifyError::UnsupportedVersion as u64
+        );
+        invoke_context
+            .compute_meter
+            .mock_set_remaining(verify_cost(MLDSA65_MAX_MESSAGE_LEN as u64));
+        assert_eq!(
+            call(&mut invoke_context, 1, msg_va, u64::MAX, sig_va).unwrap(),
+            MlDsaVerifyError::MessageTooLong as u64
+        );
+
+        // Signature region shorter than 3309 bytes is an access violation.
+        invoke_context.compute_meter.mock_set_remaining(cost);
+        assert_access_violation!(
+            call(&mut invoke_context, 1, msg_va, msg_len, sig_va + 1),
+            sig_va + 1,
+            agave_mldsa_verify::MLDSA65_SIGNATURE_LEN as u64
+        );
+
+        // Insufficient compute budget is rejected before verification.
+        invoke_context.compute_meter.mock_set_remaining(cost - 1);
+        assert_matches!(
+            call(&mut invoke_context, 1, msg_va, msg_len, sig_va),
+            Result::Err(error) if error.downcast_ref::<InstructionError>().unwrap() == &InstructionError::ComputationalBudgetExceeded
+        );
+    }
 }
