+declare_builtin_function!(
+    /// ML-DSA-65 signature verification.
+    ///
+    /// Arguments: algorithm version, public key address (1952 bytes),
+    /// message address, message length, signature address (3309 bytes).
+    /// Returns `0` for a valid signature or an `MlDsaVerifyError` code.
+    /// The compute cost is charged before any input is read.
+    SyscallMlDsa65Verify,
+    fn rust(
+        invoke_context: &mut InvokeContext<'_, '_>,
+        version: u64,
+        public_key_addr: u64,
+        message_addr: u64,
+        message_len: u64,
+        signature_addr: u64,
+    ) -> Result<u64, Error> {
+        use agave_mldsa_verify::{
+            MLDSA65_MAX_MESSAGE_LEN, MLDSA65_PUBLIC_KEY_LEN, MLDSA65_SIGNATURE_LEN,
+            MLDSA65_VERSION_V1, MlDsaVerifyError, verify, verify_cost,
+        };
+
+        let charged_len = message_len.min(MLDSA65_MAX_MESSAGE_LEN as u64);
+        invoke_context
+            .compute_meter
+            .consume_checked(verify_cost(charged_len))?;
+
+        if version != MLDSA65_VERSION_V1 {
+            return Ok(MlDsaVerifyError::UnsupportedVersion.into());
+        }
+        if message_len > MLDSA65_MAX_MESSAGE_LEN as u64 {
+            return Ok(MlDsaVerifyError::MessageTooLong.into());
+        }
+
+        let check_aligned = invoke_context.get_check_aligned();
+        let memory_mapping = invoke_context.memory_contexts.memory_mapping_mut()?;
+        let public_key = translate_slice::<u8>(
+            memory_mapping,
+            public_key_addr,
+            MLDSA65_PUBLIC_KEY_LEN as u64,
+            check_aligned,
+        )?;
+        let message = translate_slice::<u8>(memory_mapping, message_addr, message_len, check_aligned)?;
+        let signature = translate_slice::<u8>(
+            memory_mapping,
+            signature_addr,
+            MLDSA65_SIGNATURE_LEN as u64,
+            check_aligned,
+        )?;
+
+        Ok(match verify(version, public_key, message, signature) {
+            Ok(()) => SUCCESS,
+            Err(error) => error.into(),
+        })
+    }
+);
+
 declare_builtin_function!(
