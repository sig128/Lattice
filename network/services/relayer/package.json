{
  "name": "@lattice/relayer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0 <23"
  },
  "exports": {
    "./vault": "./src/vault/client.ts"
  },
  "scripts": {
    "migrate": "tsx src/bin/migrate.ts",
    "relayer": "tsx src/bin/relayer.ts",
    "attester": "tsx src/bin/attester.ts",
    "reconcile": "tsx src/bin/reconcile.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:pg": "./scripts/with-test-postgres.sh vitest run",
    "test:validator": "RUN_VALIDATOR_TESTS=1 ./scripts/with-test-postgres.sh vitest run",
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@lattice/protocol": "workspace:*",
    "@noble/post-quantum": "0.7.1",
    "@solana/spl-token": "0.4.15",
    "@solana/web3.js": "1.99.0",
    "pg": "8.23.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15"
  }
}
