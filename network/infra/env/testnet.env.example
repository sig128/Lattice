# Lattice public TESTNET configuration.
#
# bootstrap.sh installs this once as /etc/lattice/lattice.env (root:lattice,
# mode 0640), replacing __PUBLIC_IP__, and preserves it on later deploys (new
# keys from this example are appended). Plain KEY=VALUE lines only: no quotes,
# no spaces. The file is read by bash and by systemd EnvironmentFile=.
#
# Never put private keys or signing material here. Everything NEXT_PUBLIC_* is
# compiled into the browser bundle.

# --- Operator inputs --------------------------------------------------------
# Only "testnet" is accepted by the server scripts; production is not
# selectable through configuration.
LATTICE_ENVIRONMENT=testnet
LATTICE_PUBLIC_IP=__PUBLIC_IP__
# Domain mode switch. Set to e.g. lattice.example and redeploy: the site moves
# to https://<domain>, RPC to https://rpc.<domain>, WebSocket to
# wss://ws.<domain>, all with automatic Let's Encrypt TLS. DNS A records for
# all three names must point at LATTICE_PUBLIC_IP first (bootstrap checks).
LATTICE_DOMAIN=
# IP mode TLS. auto: request a Let's Encrypt IP-address certificate
# ("shortlived" profile, ~6-day lifetime, auto-renewed by Caddy) and fall back
# to plain HTTP if issuance fails. off: plain HTTP only.
LATTICE_IP_TLS=auto
# Optional ACME account email (expiry notices). Empty is allowed.
ACME_EMAIL=
# Optional alert webhook receiving {"text": ..., "content": ...} JSON
# (Slack incoming webhook, Discord webhook, ntfy, ...).
ALERT_WEBHOOK_URL=
# Public read-only source mint display. Empty = unconfigured.
NEXT_PUBLIC_SOURCE_TOKEN_MINT=
# The operator-attested bridge demo routes (/api/bridge/test-mint, settle)
# sign with server-held demo keys. Keep 0 on a public host unless deliberately
# demonstrating; the gateway returns 403 for them while 0.
LATTICE_PUBLIC_BRIDGE_DEMO=0

# --- Validator (single-node solana-test-validator) ---------------------------
# The live validator runs the unmodified pinned Agave release from the Anza
# installer. The Lattice fork builds in the background (lattice-fork-build)
# and is not switched in automatically; see RUNBOOK.md.
LATTICE_AGAVE_RELEASE=v4.3.0
# --limit-blockstore-size (the current name of --limit-ledger-size in Agave
# v4.3.0). 2,000,000 shreds is a few GB of blockstore.
LATTICE_LEDGER_LIMIT_SHREDS=2000000
LATTICE_FAUCET_SOL=1000000
# Internal cap (RPC requestAirdrop is never public; the site faucet gives 1 SOL
# per IP per 10 minutes). The bridge demo setup funds itself with 20 SOL.
LATTICE_FAUCET_PER_REQUEST_SOL_CAP=25
LATTICE_FAUCET_PER_TIME_SOL_CAP=200
LATTICE_FAUCET_TIME_SLICE_SECS=3600
# Programs loaded at genesis only: <program-id>:<file in /var/lib/lattice/genesis-programs>,
# comma-separated. Ignored once the ledger exists. Empty for the unmodified
# release: lattice_pq_vault.so calls the fork-only sol_mldsa65_verify syscall.
# With the fork: FQn1rtLkx2wTqXQK4Ur96HATPdQhHeFyA5v2F1NSChBn:lattice_pq_vault.so
LATTICE_GENESIS_BPF_PROGRAMS=
RUST_LOG=solana=warn,agave=warn,solana_metrics=error

# --- Disk guard (cron, every 5 minutes) -------------------------------------
LATTICE_DISK_WARN_PCT=75
LATTICE_DISK_CRIT_PCT=85
# At this root-filesystem usage the validator is stopped and kept stopped
# until an operator clears the guard (see RUNBOOK.md).
LATTICE_DISK_STOP_PCT=92
LATTICE_LEDGER_WARN_GB=60
LATTICE_LEDGER_STOP_GB=120

# --- Backups (cron, nightly 03:17 UTC) --------------------------------------
LATTICE_BACKUP_PG_KEEP_DAYS=14
LATTICE_BACKUP_LEDGER_KEEP=3
LATTICE_OBSERVATION_RETENTION_DAYS=30
# Optional off-host copy (requires awscli and an instance role), e.g. s3://bucket/lattice
LATTICE_BACKUP_S3_URI=

# --- Server-side services ---------------------------------------------------
DATABASE_URL=socket:/var/run/postgresql?db=lattice
PGUSER=lattice
MONITOR_INTERVAL_MS=15000
MONITOR_TIMEOUT_MS=5000
NEXT_TELEMETRY_DISABLED=1
LATTICE_INTERNAL_HTTP_RPC=http://127.0.0.1:8899

# --- Managed by bootstrap: derived from the inputs above on every deploy ----
# Edits here are overwritten. IP mode without TLS shown; with an IP
# certificate these become https:// and wss://, in domain mode
# https://rpc.<domain> and wss://ws.<domain>.
NEXT_PUBLIC_LATTICE_ENVIRONMENT=testnet
LATTICE_SITE_URL=http://__PUBLIC_IP__
NEXT_PUBLIC_NATIVE_HTTP_RPC=http://__PUBLIC_IP__/rpc
NEXT_PUBLIC_NATIVE_WS_RPC=ws://__PUBLIC_IP__/ws
# Filled from getGenesisHash after the validator creates the testnet genesis.
NEXT_PUBLIC_NATIVE_GENESIS_HASH=
