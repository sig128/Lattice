#!/usr/bin/env bash
# Render the Caddyfile for the Lattice edge to stdout.
#
#   lattice-render-caddy --ip <ipv4> [--domain <domain>] [--ip-tls off|attempt|on] [--email <addr>]
#
# IP mode (no --domain):
#   off      http://<ip> only.
#   attempt  http://<ip> serves the site AND https://<ip> requests a Let's
#            Encrypt IP certificate (shortlived profile); HTTP keeps working
#            if issuance fails.
#   on       https://<ip> serves the site; http://<ip> redirects to it.
# Domain mode: https://<domain>, https://rpc.<domain>, wss://ws.<domain> with
#   automatic TLS; http://<ip> redirects to https://<domain>.
#
# Pure bash so it can also be rendered and `caddy validate`d on a workstation.
set -euo pipefail

ip=""
domain=""
ip_tls="off"
email=""
while (($#)); do
  case "$1" in
    --ip) ip="$2"; shift 2 ;;
    --domain) domain="$2"; shift 2 ;;
    --ip-tls) ip_tls="$2"; shift 2 ;;
    --email) email="$2"; shift 2 ;;
    *) echo "unknown argument: $1" >&2; exit 64 ;;
  esac
done

[[ "${ip}" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]] || { echo "--ip must be an IPv4 address" >&2; exit 64; }
[[ -z "${domain}" || "${domain}" =~ ^([a-z0-9]([a-z0-9-]*[a-z0-9])?\.)+[a-z]{2,}$ ]] || { echo "invalid --domain" >&2; exit 64; }
[[ "${ip_tls}" =~ ^(off|attempt|on)$ ]] || { echo "--ip-tls must be off, attempt or on" >&2; exit 64; }
[[ -z "${email}" || "${email}" =~ ^[^[:space:]@]+@[^[:space:]@]+$ ]] || { echo "invalid --email" >&2; exit 64; }

acme_email_line=""
[[ -n "${email}" ]] && acme_email_line=$'\n\t\t\temail '"${email}"

render() {
cat <<EOF
# Generated by lattice-render-caddy; do not edit (rerun bootstrap instead).
# Mode: $([[ -n "${domain}" ]] && echo "domain ${domain}" || echo "ip ${ip} tls=${ip_tls}")
{
	admin localhost:2019
$([[ -n "${email}" ]] && printf '\temail %s\n' "${email}")
$([[ -z "${domain}" && "${ip_tls}" != "off" ]] && printf '\t# Clients do not send SNI for IP literals; pick the IP certificate.\n\tdefault_sni %s\n' "${ip}")
	servers {
		# HTTP/3 needs UDP 443, which the security group does not open.
		protocols h1 h2
		timeouts {
			read_header 10s
			idle 2m
		}
		max_header_size 32KB
	}
}

(lattice_common) {
	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}
	log {
		output file /var/log/caddy/lattice-access.log {
			roll_size 50MiB
			roll_keep 10
			roll_keep_for 336h
		}
		format json
	}
}

# JSON-RPC: body capped here; methods, batches and rates in lattice-gateway.
(lattice_rpc) {
	request_body {
		max_size 64KB
	}
	@rpc_bad_method not method POST GET HEAD OPTIONS
	respond @rpc_bad_method 405
	reverse_proxy 127.0.0.1:8080 {
		header_up X-Lattice-Client-IP {remote_host}
	}
}

# PubSub WebSocket: per-IP and global connection caps in lattice-gateway.
(lattice_ws) {
	request_body {
		max_size 4KB
	}
	reverse_proxy 127.0.0.1:8080 {
		header_up X-Lattice-Client-IP {remote_host}
		stream_timeout 6h
		stream_close_delay 1m
	}
}

(lattice_site) {
	import lattice_common

	@rpc path /rpc /rpc/*
	handle @rpc {
		import lattice_rpc
	}

	@ws path /ws /ws/*
	handle @ws {
		import lattice_ws
	}

	# Mutating or upstream-calling site routes go through the gateway's
	# strict per-IP limits (faucet: 1 request per IP per 10 minutes).
	@limited_api path /api/faucet /api/faucet/* /api/bridge/* /api/rpc /api/rpc/*
	handle @limited_api {
		request_body {
			max_size 16KB
		}
		reverse_proxy 127.0.0.1:8080 {
			header_up X-Lattice-Client-IP {remote_host}
		}
	}

	handle {
		request_body {
			max_size 1MB
		}
		encode zstd gzip
		reverse_proxy 127.0.0.1:3000
	}
}
EOF

if [[ -n "${domain}" ]]; then
  cat <<EOF

${domain} {
	import lattice_site
}

rpc.${domain} {
	import lattice_common
	rewrite * /rpc{path}
	import lattice_rpc
}

ws.${domain} {
	import lattice_common
	rewrite * /ws{path}
	import lattice_ws
}

http://${ip} {
	redir https://${domain}{uri} 308
}
EOF
  return 0
fi

case "${ip_tls}" in
  off)
    cat <<EOF

http://${ip} {
	import lattice_site
}
EOF
    ;;
  attempt | on)
    if [[ "${ip_tls}" == "attempt" ]]; then
      http_block="http://${ip} {
	import lattice_site
}"
    else
      http_block="http://${ip} {
	redir https://${ip}{uri} 308
}"
    fi
    cat <<EOF

${http_block}

https://${ip} {
	tls {
		issuer acme {
			dir https://acme-v02.api.letsencrypt.org/directory
			# Let's Encrypt only issues IP-address certificates under this profile.
			profile shortlived${acme_email_line}
		}
	}
	import lattice_site
}
EOF
    ;;
esac
}

# Squeeze blank lines left by omitted optional directives.
render | cat -s
