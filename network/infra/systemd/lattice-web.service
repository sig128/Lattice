[Unit]
Description=Lattice website (Next.js, 127.0.0.1:3000)
After=network-online.target lattice-validator.service
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=lattice
Group=lattice
# The symlink is resolved at start, so a running process keeps its release.
WorkingDirectory=/opt/lattice/current/apps/web
EnvironmentFile=/etc/lattice/lattice.env
Environment=NODE_ENV=production
Environment=NODE_OPTIONS=--max-old-space-size=2048
ExecStart=/usr/local/bin/node node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 3000
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
SyslogIdentifier=lattice-web

LimitNOFILE=65536
MemoryHigh=2560M
MemoryMax=3G
TasksMax=512

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
# .next/cache inside releases; bridge demo state shared with the recorder.
ReadWritePaths=/opt/lattice/releases -/var/lib/lattice/bridge -/var/lib/lattice/keys/bridge
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0027

[Install]
WantedBy=multi-user.target
