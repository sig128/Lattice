#!/usr/sbin/nft -f
# Per-source limits for the public web ports (80/443), loaded by
# lattice-edge-limits.service. This table is independent of ufw's tables: it
# only rejects or drops excess traffic and accepts everything else, so ufw
# remains the allowlist. Application-level limits (JSON-RPC methods, request
# rates, WebSocket counts) are enforced by lattice-gateway.

# Create-then-delete makes reloading idempotent.
table inet lattice_edge
delete table inet lattice_edge

table inet lattice_edge {
	set http_conn4 {
		type ipv4_addr
		size 65535
		flags dynamic
	}

	set http_conn6 {
		type ipv6_addr
		size 65535
		flags dynamic
	}

	set http_rate4 {
		type ipv4_addr
		size 65535
		flags dynamic,timeout
		timeout 2m
	}

	set http_rate6 {
		type ipv6_addr
		size 65535
		flags dynamic,timeout
		timeout 2m
	}

	chain input {
		type filter hook input priority filter - 10; policy accept;
		iif "lo" accept
		# Agave 4.3.0 test-validator hardcodes RPC, PubSub and faucet listeners
		# to 0.0.0.0; they must only ever be reached over loopback.
		tcp dport { 8899, 8900, 9900 } counter drop
		# At most 128 concurrent TCP connections per source address.
		tcp dport { 80, 443 } ct state new add @http_conn4 { ip saddr ct count over 128 } counter reject with tcp reset
		tcp dport { 80, 443 } ct state new add @http_conn6 { ip6 saddr ct count over 128 } counter reject with tcp reset
		# At most 40 new connections per second per source (burst 80).
		tcp dport { 80, 443 } ct state new update @http_rate4 { ip saddr limit rate over 40/second burst 80 packets } counter drop
		tcp dport { 80, 443 } ct state new update @http_rate6 { ip6 saddr limit rate over 40/second burst 80 packets } counter drop
	}
}
